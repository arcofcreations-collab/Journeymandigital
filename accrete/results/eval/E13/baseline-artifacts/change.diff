+-- Claims can be withdrawn (submitted -> draft) and revised (rejected -> draft).
+-- revision counts how often a rejected claim was revised (at most 2); the reason of the
+-- rejection that was revised is kept in previous_rejection_reason.
+-- Existing claims get revision = 0 and previous_rejection_reason = NULL via the defaults.
+
+ALTER TABLE claims ADD COLUMN revision INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0);
+ALTER TABLE claims ADD COLUMN previous_rejection_reason TEXT;
