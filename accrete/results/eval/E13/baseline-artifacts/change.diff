@@ -0,0 +1,188 @@
+"""Withdrawing submitted claims and revising rejected ones; the 0002 migration."""
+import os
+import sqlite3
+
+from accept_client import fresh_app, parse_ui
+
+# Claim 3: quinn's, submitted 2026-02-24T14:00:00, manager marco.
+SUBMITTED_AT = "2026-02-24T14:00:00"
+WINDOW_END = "2026-03-03T14:00:00"  # exactly 7 days later
+NEW = {"amount": 50, "category": "travel", "description": "Bus"}
+
+
+def _actions(app, claim_id, user, now="2026-03-01T12:00:00"):
+    return parse_ui(app.get(f"/ui/claims/{claim_id}", user=user, now=now).text).actions
+
+
+# --- withdraw -------------------------------------------------------------------------
+
+def test_withdraw_returns_claim_to_draft(app):
+    r = app.post("/api/claims/3/withdraw", {}, user="quinn")
+    assert r.status == 200
+    assert r.json["status"] == "draft" and r.json["submitted_at"] is None
+    assert (r.json["revision"], r.json["previous_rejection_reason"]) == (0, None)
+    # Now an ordinary draft: editable, re-submittable with a fresh submitted_at.
+    assert app.patch("/api/claims/3", {"amount": 10}, user="quinn").status == 200
+    r = app.post("/api/claims/3/submit", {}, user="quinn", now="2026-03-02T08:00:00")
+    assert r.status == 200 and r.json["submitted_at"] == "2026-03-02T08:00:00"
+    assert app.get("/api/_outbox", user="quinn").json["items"] == []
+
+
+def test_withdrawn_claim_can_be_deleted_and_manager_still_reads_it(app):
+    assert app.post("/api/claims/3/withdraw", {}, user="quinn").status == 200
+    assert app.get("/api/claims/3", user="marco").json["status"] == "draft"
+    assert app.post("/api/claims/3/approve", {}, user="marco").status == 409
+    assert app.delete("/api/claims/3", user="quinn").status == 204
+
+
+def test_withdraw_window_is_seven_days_inclusive(app):
+    assert app.post("/api/claims/3/withdraw", {}, user="quinn", now="2026-03-03T14:00:01").status == 409
+    assert app.post("/api/claims/3/withdraw", {}, user="quinn", now=WINDOW_END).status == 200
+
+
+def test_withdraw_window_restarts_on_resubmit(app):
+    assert app.post("/api/claims/3/withdraw", {}, user="quinn", now=WINDOW_END).status == 200
+    assert app.post("/api/claims/3/submit", {}, user="quinn", now="2026-03-05T09:00:00").status == 200
+    assert app.post("/api/claims/3/withdraw", {}, user="quinn", now="2026-03-12T09:00:01").status == 409
+    assert app.post("/api/claims/3/withdraw", {}, user="quinn", now="2026-03-12T09:00:00").status == 200
+
+
+def test_withdraw_permissions_and_states(app):
+    assert app.post("/api/claims/3/withdraw", {}, user="marco").status == 403  # manager
+    assert app.post("/api/claims/3/withdraw", {}, user="fiona").status == 403  # finance
+    assert app.post("/api/claims/999/withdraw", {}, user="quinn").status == 404
+    assert app.post("/api/claims/1/withdraw", {}, user="wen").status == 409  # draft
+    assert app.post("/api/claims/7/withdraw", {}, user="yusuf").status == 409  # rejected
+    assert app.post("/api/claims/12/withdraw", {}, user="tariq").status == 409  # approved
+    assert app.post("/api/claims/3/withdraw", {"x": 1}, user="quinn").status == 400
+    assert app.post("/api/claims/1/withdraw", {"x": 1}, user="marco").status == 403  # 403 beats 409/400
+    late = "2026-03-10T00:00:00"
+    assert app.post("/api/claims/3/withdraw", {"x": 1}, user="quinn", now=late).status == 409  # 409 beats 400
+    assert app.get("/api/claims/3", user="quinn").json["status"] == "submitted"
+
+
+# --- revise ---------------------------------------------------------------------------
+
+def _reject(app, claim_id, reason, manager="omar"):
+    r = app.post(f"/api/claims/{claim_id}/reject", {"reason": reason}, user=manager, now="2026-03-02T10:00:00")
+    assert r.status == 200
+    return r.json
+
+
+def test_revise_reopens_rejected_claim(app):
+    r = app.post("/api/claims/7/revise", {}, user="yusuf")
+    assert r.status == 200
+    assert {k: r.json[k] for k in ("status", "submitted_at", "decided_at", "decided_by", "rejection_reason",
+                                   "previous_rejection_reason", "revision")} == {
+        "status": "draft", "submitted_at": None, "decided_at": None, "decided_by": None,
+        "rejection_reason": None, "previous_rejection_reason": "Missing receipt", "revision": 1}
+    assert (r.json["amount"], r.json["description"]) == (613.88, "Hotel night #7")
+    assert app.get("/api/claims/7", user="omar").json["revision"] == 1  # manager still reads it
+    assert app.get("/api/_outbox", user="yusuf").json["items"] == []
+
+
+def test_revise_at_most_twice(app):
+    assert app.post("/api/claims/7/revise", {}, user="yusuf").status == 200
+    assert app.post("/api/claims/7/submit", {}, user="yusuf").status == 200
+    claim = _reject(app, 7, "Wrong amount")
+    assert (claim["revision"], claim["previous_rejection_reason"]) == (1, "Missing receipt")
+    r = app.post("/api/claims/7/revise", {}, user="yusuf")
+    assert r.status == 200 and r.json["revision"] == 2 and r.json["previous_rejection_reason"] == "Wrong amount"
+    assert app.post("/api/claims/7/submit", {}, user="yusuf").status == 200
+    claim = _reject(app, 7, "Still wrong")
+    assert (claim["status"], claim["rejection_reason"], claim["revision"]) == ("rejected", "Still wrong", 2)
+    assert app.post("/api/claims/7/revise", {}, user="yusuf").status == 409
+    assert app.get("/api/claims/7", user="yusuf").json["status"] == "rejected"
+
+
+def test_revised_claim_follows_normal_workflow(app):
+    assert app.post("/api/claims/7/revise", {}, user="yusuf").status == 200
+    assert app.patch("/api/claims/7", {"amount": 600}, user="yusuf").status == 200
+    assert app.post("/api/claims/7/submit", {}, user="yusuf", now="2026-03-02T09:00:00").status == 200
+    r = app.post("/api/claims/7/approve", {}, user="omar", now="2026-03-03T09:00:00")
+    assert r.status == 200 and r.json["decided_by"] == 4 and r.json["previous_rejection_reason"] == "Missing receipt"
+    assert app.post("/api/claims/7/pay", {}, user="fiona").status == 200
+    assert app.get("/api/_outbox", user="fiona").json["items"][0]["payload"] == {"claim": 7, "employee": 14,
+                                                                                 "amount": 600}
+
+
+def test_revise_permissions_and_states(app):
+    assert app.post("/api/claims/7/revise", {}, user="omar").status == 403  # manager
+    assert app.post("/api/claims/7/revise", {}, user="fiona").status == 403
+    assert app.post("/api/claims/999/revise", {}, user="yusuf").status == 404
+    assert app.post("/api/claims/5/revise", {}, user="yusuf").status == 409  # submitted
+    assert app.post("/api/claims/1/revise", {}, user="wen").status == 409  # draft
+    assert app.post("/api/claims/7/revise", {"x": 1}, user="yusuf").status == 400
+    assert app.post("/api/claims/5/revise", {"x": 1}, user="yusuf").status == 409  # 409 beats 400
+    assert app.get("/api/claims/7", user="yusuf").json["status"] == "rejected"
+
+
+def test_new_fields_filterable(app):
+    assert app.post("/api/claims/7/revise", {}, user="yusuf").status == 200
+    assert [c["id"] for c in app.get("/api/claims?revision=1", user="fiona").json["items"]] == [7]
+    items = app.get("/api/claims?previous_rejection_reason=Missing%20receipt", user="fiona").json["items"]
+    assert [c["id"] for c in items] == [7]
+
+
+# --- UI -------------------------------------------------------------------------------
+
+def test_ui_withdraw_form_follows_permission_and_window(app):
+    assert _actions(app, 3, "quinn") == ["withdraw"]
+    assert _actions(app, 3, "quinn", now=WINDOW_END) == ["withdraw"]
+    assert _actions(app, 3, "quinn", now="2026-03-03T14:00:01") == []
+    assert _actions(app, 3, "marco") == ["approve", "reject"]
+    assert _actions(app, 2, "victor") == []  # submitted more than 7 days ago
+
+
+def test_ui_revise_form_follows_permission_and_limit(app):
+    assert _actions(app, 7, "yusuf") == ["revise"]
+    assert _actions(app, 7, "omar") == []
+    for reason in ("Again", "And again"):
+        app.post("/api/claims/7/revise", {}, user="yusuf")
+        app.post("/api/claims/7/submit", {}, user="yusuf")
+        _reject(app, 7, reason)
+    page = parse_ui(app.get("/ui/claims/7", user="yusuf").text)
+    assert page.actions == []
+    assert page.fields["revision"] == "2" and page.fields["previous_rejection_reason"] == "Again"
+
+
+def test_ui_forms_post_withdraw_and_revise(app):
+    assert app.request("POST", "/ui/claims/3/withdraw", user="quinn").status == 303
+    assert app.get("/api/claims/3", user="quinn").json["status"] == "draft"
+    assert app.request("POST", "/ui/claims/7/revise", user="yusuf").status == 303
+    assert app.get("/api/claims/7", user="yusuf").json["revision"] == 1
+    assert app.request("POST", "/ui/claims/7/revise", user="omar").status == 403
+
+
+# --- migration ------------------------------------------------------------------------
+
+def test_migration_gives_existing_claims_defaults_and_keeps_data(app):
+    """Rebuild a database as it was before 0002, then let startup migrate it."""
+    path = os.path.join(app.workdir, "data.db")
+    conn = sqlite3.connect(path)
