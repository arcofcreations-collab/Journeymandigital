+def generate_from_schedule(ctx, schedule_id, params):
+    """Raise the schedule's next preventive work order (requested by the caller) and move
+    ``next_due`` on by exactly ``interval_days`` (once per call, however late it is)."""
+    with transaction():
+        schedule = _load_schedule(schedule_id)
+        asset = repository.get_asset(schedule["asset"])
+        _authorize_generate(ctx, schedule, asset)
+        validation.clean_no_params(params)
+        # The priority was checked against the asset's criticality when the schedule got it.
+        order = {"asset": schedule["asset"], "title": schedule["title"], "description": PREVENTIVE_DESCRIPTION,
+                 "priority": schedule["priority"]}
+        work_order_id = repository.insert_work_order(
+            order, requested_by=ctx.user["id"], created_at=ctx.now_text, schedule=schedule_id
+        )
+        next_due = (date.fromisoformat(schedule["next_due"]) + timedelta(days=schedule["interval_days"])).isoformat()
