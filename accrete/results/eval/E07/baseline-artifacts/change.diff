+
+def test_refused_retirement_keeps_schedules_active(app):
+    assert app.patch("/api/assets/25", {"retired": True}, user="yara").status == 409  # one unfinished order
+    assert app.patch("/api/assets/25", {"retired": True}, user="tomas").status == 403
+    assert app.get("/api/schedules/4", user="ruth").json["active"] is True
+    assert app.patch("/api/assets/25", {"name": "AHU East"}, user="yara").status == 200
+    assert app.get("/api/schedules/4", user="ruth").json["active"] is True
+
