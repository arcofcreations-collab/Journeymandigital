+def test_generated_orders_follow_the_normal_workflow(app):
+    app.post("/api/schedules/4/generate", {}, user="yara")  # order 83 on asset 25 (East)
+    assert app.get("/api/work_orders/83", user="tess").status == 200  # technician at the site
+    assert app.get("/api/work_orders/83", user="mei").status == 403  # East requester, not hers
+    assert app.get("/api/work_orders/83", user="tomas").status == 403
+    assert app.patch("/api/work_orders/83", {"priority": "p3"}, user="yara").json["due_date"] == "2026-03-08"
+    assert app.post("/api/work_orders/83/assign", {"technician": 12}, user="yara").status == 200
+    assert app.post("/api/work_orders/83/start", {}, user="tess").status == 200
+    assert app.post("/api/work_orders/83/use_parts", {"items": [{"part": 7, "quantity": 2}]}, user="tess").status == 200
+    assert app.post("/api/work_orders/83/log_time", {"minutes": 45}, user="tess").status == 200
+    r = app.post("/api/work_orders/83/complete", {"resolution": "Replaced"}, user="tess")
+    assert r.status == 200 and r.json["status"] == "completed" and r.json["schedule"] == 4
+    assert [m["channel"] for m in _outbox(app)] == ["preventive_generated", "assignment", "work_completed"]
+    assert _outbox(app)[-1]["payload"] == {"work_order": 83, "asset": 25, "technician": 12, "labor_minutes": 45,
+                                           "parts_cost": 14.8}
+    # the workload cap applies to generated orders too (nils, North, already has 3)
+    app.post("/api/schedules/1/generate", {}, user="sofia")
+    assert app.post("/api/work_orders/84/assign", {"technician": 8}, user="sofia").status == 409
