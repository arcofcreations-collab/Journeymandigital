+-- Preventive maintenance schedules: recurring maintenance generates work orders from a schedule
+-- (the `generate` action) instead of being typed in by hand.
+--
+-- work_orders.schedule_id references the schedule that generated the order; every existing order
+-- has none (NULL). Nothing else changes.
+--
+-- Data: the five starting schedules with fixed ids (new schedules continue after 5). Schedule 3
+-- belongs to the retired asset 30 and is inactive.
+
+CREATE TABLE schedules (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    asset_id      INTEGER NOT NULL REFERENCES assets (id),
+    title         TEXT    NOT NULL,
+    priority      TEXT    NOT NULL CHECK (priority IN ('p1', 'p2', 'p3', 'p4')),
+    interval_days INTEGER NOT NULL CHECK (interval_days BETWEEN 1 AND 365),
+    next_due      TEXT    NOT NULL,  -- YYYY-MM-DD
+    active        INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1))
+);
+
+CREATE INDEX schedules_asset_id ON schedules (asset_id);
+
+-- (A column added with ALTER TABLE may reference another table as long as its default is NULL.)
+ALTER TABLE work_orders ADD COLUMN schedule_id INTEGER REFERENCES schedules (id);
+
+CREATE INDEX work_orders_schedule_id ON work_orders (schedule_id);
+
+INSERT INTO schedules (id, asset_id, title, priority, interval_days, next_due, active) VALUES
+    (1,  3, 'Boiler annual service',    'p2', 365, '2026-03-05', 1),
+    (2, 16, 'Conveyor belt inspection', 'p3',  30, '2026-03-20', 1),
+    (3, 30, 'Generator load test',      'p3',  90, '2026-02-01', 0),
+    (4, 25, 'Filter replacement',       'p4',  60, '2026-02-15', 1),
+    (5, 21, 'Generator monthly run',    'p2',  30, '2026-03-03', 1);
