+def test_schedule_field_is_read_only_on_work_orders(app):
+    order = {"asset": 1, "title": "x", "priority": "p3"}
+    assert app.post("/api/work_orders", {**order, "schedule": None}, user="ruth").status == 400
+    assert app.post("/api/work_orders", {**order, "schedule": 1}, user="ruth").status == 400
+    assert app.patch("/api/work_orders/74", {"schedule": 1}, user="sofia").status == 400
+    assert app.post("/api/work_orders", order, user="ruth").json["schedule"] is None
+
