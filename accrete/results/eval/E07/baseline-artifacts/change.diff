+"""Preventive maintenance schedules and the `generate` action (migration 0008).
+
+Starting schedules (today is 2026-03-01): 1 asset 3 (North, high) next_due 03-05; 2 asset 16 (South)
+next_due 03-20 (not yet generable); 3 asset 30 (East, retired) inactive; 4 asset 25 (East, medium) p4,
+next_due 02-15 (late); 5 asset 21 (South, high) next_due 03-03. sofia is the manager (North), tomas
+supervises South, yara East.
+"""
+import os
+import shutil
+import sqlite3
+import sys
+
+from accept_client import parse_ui
+
+APP_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+STARTING = [
+    {"id": 1, "asset": 3, "title": "Boiler annual service", "priority": "p2", "interval_days": 365,
+     "next_due": "2026-03-05", "active": True},
+    {"id": 2, "asset": 16, "title": "Conveyor belt inspection", "priority": "p3", "interval_days": 30,
+     "next_due": "2026-03-20", "active": True},
+    {"id": 3, "asset": 30, "title": "Generator load test", "priority": "p3", "interval_days": 90,
+     "next_due": "2026-02-01", "active": False},
+    {"id": 4, "asset": 25, "title": "Filter replacement", "priority": "p4", "interval_days": 60,
+     "next_due": "2026-02-15", "active": True},
+    {"id": 5, "asset": 21, "title": "Generator monthly run", "priority": "p2", "interval_days": 30,
+     "next_due": "2026-03-03", "active": True},
+]
+NEW = {"asset": 31, "title": "Valve check", "priority": "p2", "interval_days": 14, "next_due": "2026-03-10"}
+
+
+def _outbox(app):
+    return app.get("/api/_outbox", user="ruth").json["items"]
+
+
+# --- data -----------------------------------------------------------------------------
+
+def test_starting_schedules(app):
+    for user in ("ruth", "nils", "tomas", "sofia"):
+        assert app.get("/api/schedules", user=user).json["items"] == STARTING
+    assert app.get("/api/schedules/4", user="mei").json == STARTING[3]
+    assert app.get("/api/schedules/99", user="mei").status == 404
+    assert [s["id"] for s in app.get("/api/schedules?active=false", user="mei").json["items"]] == [3]
+    assert [s["id"] for s in app.get("/api/schedules?asset=16", user="mei").json["items"]] == [2]
+    assert app.get("/api/schedules?site=North", user="mei").status == 400
+
+
+def test_existing_work_orders_have_no_schedule(app):
+    orders = app.get("/api/work_orders", user="sofia").json["items"]
+    assert len(orders) == 82 and all(o["schedule"] is None for o in orders)
+    assert len(app.get("/api/work_orders?schedule=null", user="sofia").json["items"]) == 82
+
+
+def test_migration_0008_on_a_pre_0008_database(tmp_path):
+    sys.path.insert(0, APP_DIR)
+    try:
+        from maintenance_app import db
+    finally:
+        sys.path.remove(APP_DIR)
+    old_migrations = tmp_path / "migrations"
+    old_migrations.mkdir()
+    for name in os.listdir(db.MIGRATIONS_DIR):
+        if name.endswith(".sql") and int(name[:4]) <= 7:
+            shutil.copy(os.path.join(db.MIGRATIONS_DIR, name), old_migrations / name)
+    path = str(tmp_path / "data.db")
+    db.migrate(path, str(old_migrations))
+    conn = sqlite3.connect(path)
+    conn.executescript("""
+        INSERT INTO staff (id, username, name, role, site) VALUES (1, 'sofia', 'Sofia', 'manager', 'North');
+        INSERT INTO assets (id, tag, name, site, criticality, retired) VALUES
+            (3, 'A3', 'A3', 'North', 'high', 0), (16, 'A16', 'A16', 'South', 'high', 0),
+            (21, 'A21', 'A21', 'South', 'high', 0), (25, 'A25', 'A25', 'East', 'medium', 0),
+            (30, 'A30', 'A30', 'East', 'medium', 1);
+        INSERT INTO work_orders (id, asset_id, title, priority, status, requested_by_id, created_at)
+            VALUES (1, 3, 'Leak', 'p3', 'open', 1, '2026-01-01T08:00:00');
+    """)
+    before = conn.execute("SELECT * FROM work_orders").fetchall()
+    conn.close()
+
+    assert db.migrate(path) == ["0008_maintenance_schedules.sql"]
+
+    conn = sqlite3.connect(path)
+    try:
+        rows = conn.execute("SELECT * FROM schedules ORDER BY id").fetchall()
+        assert rows == [(s["id"], s["asset"], s["title"], s["priority"], s["interval_days"], s["next_due"],
+                         int(s["active"])) for s in STARTING]
+        assert conn.execute("SELECT * FROM work_orders").fetchall() == [before[0] + (None,)]
+        assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+        conn.execute("INSERT INTO schedules (asset_id, title, priority, interval_days, next_due)"
+                     " VALUES (3, 'x', 'p1', 1, '2026-01-01')")
+        assert conn.execute("SELECT MAX(id) FROM schedules").fetchone()[0] == 6
+    finally:
+        conn.close()
+
+
+# --- create, PATCH, DELETE ------------------------------------------------------------
+
+def test_create(app):
+    r = app.post("/api/schedules", NEW, user="yara")
+    assert r.status == 201 and r.json == {"id": 6, **NEW, "active": True}
+    assert app.get("/api/schedules/6", user="ruth").json == r.json
+    r = app.post("/api/schedules", {**NEW, "active": False}, user="sofia")  # the manager anywhere
+    assert r.status == 201 and r.json["id"] == 7 and r.json["active"] is False
+    assert app.post("/api/schedules", {**NEW, "asset": 14}, user="tomas").status == 201
+    assert _outbox(app) == []
+
+
+def test_create_permissions(app):
+    for user in ("ruth", "nils", "tess"):
+        assert app.post("/api/schedules", NEW, user=user).status == 403
+        assert app.post("/api/schedules", {"bogus": 1}, user=user).status == 403
+    assert app.post("/api/schedules", NEW, user="tomas").status == 403  # East asset
+    assert app.post("/api/schedules", {"asset": 31, "title": ""}, user="tomas").status == 403  # 403 beats 400
+    assert app.post("/api/schedules", {"asset": 30}, user="tomas").status == 403  # retired, other site
+    assert app.post("/api/schedules", {**NEW, "asset": 999}, user="tomas").status == 400  # unknown asset
+
+
+def test_create_validation(app):
+    bad = [
+        {k: v for k, v in NEW.items() if k != "asset"}, {**NEW, "asset": None}, {**NEW, "asset": "31"},
+        {**NEW, "asset": 999}, {**NEW, "asset": 30},  # retired
+        {**NEW, "title": ""}, {**NEW, "title": "  "}, {k: v for k, v in NEW.items() if k != "title"},
+        {**NEW, "priority": "P2"}, {**NEW, "priority": "urgent"}, {**NEW, "priority": "p4"},  # high criticality
+        {**NEW, "interval_days": 0}, {**NEW, "interval_days": 366}, {**NEW, "interval_days": 7.0},
+        {**NEW, "interval_days": "7"}, {**NEW, "interval_days": True}, {k: v for k, v in NEW.items() if k != "interval_days"},
+        {**NEW, "next_due": "2026-02-30"}, {**NEW, "next_due": "2026-3-10"}, {**NEW, "next_due": "2026-03-10T00:00:00"},
+        {**NEW, "next_due": 20260310}, {**NEW, "next_due": None}, {**NEW, "next_due": "20260310"},
+        {**NEW, "active": None}, {**NEW, "active": "true"},
+        {**NEW, "id": 50}, {**NEW, "bogus": 1}, [NEW],
+    ]
+    for body in bad:
+        r = app.post("/api/schedules", body, user="sofia")
+        assert r.status == 400 and r.json["error"] == "validation", body
+    assert app.post("/api/schedules", {**NEW, "asset": 25, "priority": "p4"}, user="yara").status == 201
+    assert app.post("/api/schedules", {**NEW, "interval_days": 365, "next_due": "2028-02-29"}, user="sofia").status == 201
+    assert len(app.get("/api/schedules", user="ruth").json["items"]) == 7
+
+
+def test_patch(app):
+    r = app.patch("/api/schedules/4", {"title": "Filters", "priority": "p3", "interval_days": 90,
+                                       "next_due": "2026-04-01", "active": False}, user="yara")
+    assert r.status == 200 and r.json == {"id": 4, "asset": 25, "title": "Filters", "priority": "p3",
+                                          "interval_days": 90, "next_due": "2026-04-01", "active": False}
+    assert app.patch("/api/schedules/2", {"active": False}, user="tomas").json["active"] is False
+    assert app.patch("/api/schedules/1", {"title": "Boiler"}, user="sofia").json["title"] == "Boiler"
+    assert app.patch("/api/schedules/3", {"active": True}, user="sofia").json["active"] is True  # not refused
+
+
+def test_patch_permissions_and_validation(app):
+    for user in ("ruth", "tess", "tomas"):
+        assert app.patch("/api/schedules/4", {"title": "x"}, user=user).status == 403
+        assert app.patch("/api/schedules/4", {"asset": 1}, user=user).status == 403  # 403 beats 400
+    assert app.patch("/api/schedules/99", {"title": "x"}, user="ruth").status == 404
+    for body in ({"asset": 25}, {"asset": 31}, {"id": 4}, {"bogus": 1}, {"title": ""}, {"interval_days": 0},
+                 {"next_due": "2026-13-01"}, {"active": None}, {"priority": "p5"}):
+        assert app.patch("/api/schedules/4", body, user="yara").status == 400, body
+    # p4 is refused on a high-criticality asset, even unchanged; a medium one may keep it
+    assert app.patch("/api/schedules/1", {"priority": "p4"}, user="sofia").status == 400
+    assert app.patch("/api/schedules/4", {"priority": "p4"}, user="yara").status == 200
+    app.patch("/api/assets/25", {"criticality": "high"}, user="yara")
+    assert app.patch("/api/schedules/4", {"priority": "p4"}, user="yara").status == 400
+    assert app.patch("/api/schedules/4", {"title": "Still editable"}, user="yara").status == 200
+    assert app.get("/api/schedules/1", user="ruth").json == STARTING[0]
+
+
+def test_delete(app):
+    for user in ("ruth", "tess", "tomas"):
+        assert app.delete("/api/schedules/4", user=user).status == 403
+    assert app.delete("/api/schedules/99", user="sofia").status == 404
+    assert app.delete("/api/schedules/4", user="yara").status == 204
+    assert app.get("/api/schedules/4", user="yara").status == 404
+    assert app.delete("/api/schedules/2", user="tomas").status == 204
+    app.post("/api/schedules/5/generate", {}, user="tomas")
+    assert app.delete("/api/schedules/5", user="tomas").status == 409  # has generated an order
+    assert app.delete("/api/schedules/5", user="yara").status == 403  # 403 beats 409
+
+
+def test_asset_with_schedules_cannot_be_deleted(app):
+    assert app.post("/api/schedules", NEW, user="yara").status == 201
+    assert app.delete("/api/assets/31", user="yara").status == 409
+    assert app.delete("/api/assets/31", user="tomas").status == 403
+    assert app.delete("/api/schedules/6", user="yara").status == 204
+    assert app.delete("/api/assets/31", user="yara").status == 204
+
+
+# --- retiring an asset ----------------------------------------------------------------
+
+def test_retiring_an_asset_deactivates_its_schedules(app):
+    app.post("/api/schedules", NEW, user="yara")
+    app.post("/api/schedules", {**NEW, "title": "Second"}, user="yara")
+    assert app.patch("/api/assets/31", {"retired": True}, user="yara").status == 200
+    assert [s["active"] for s in app.get("/api/schedules?asset=31", user="ruth").json["items"]] == [False, False]
+    assert app.patch("/api/assets/31", {"retired": False}, user="yara").status == 200
+    assert [s["active"] for s in app.get("/api/schedules?asset=31", user="ruth").json["items"]] == [False, False]
+    assert app.get("/api/schedules/4", user="ruth").json["active"] is True  # other assets untouched
