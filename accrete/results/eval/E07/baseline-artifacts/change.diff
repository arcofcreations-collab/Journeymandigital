+# --- generate -------------------------------------------------------------------------
+
+def test_generate(app):
+    r = app.post("/api/schedules/1/generate", {}, user="sofia", now="2026-03-01T09:30:00")
+    assert r.status == 200 and r.json == {**STARTING[0], "next_due": "2027-03-05"}
+    order = app.get("/api/work_orders/83", user="sofia").json
+    assert order == {
+        "id": 83, "asset": 3, "title": "Boiler annual service", "description": "Preventive maintenance",
+        "priority": "p2", "status": "open", "requested_by": 1, "created_at": "2026-03-01T09:30:00",
+        "assignee": None, "started_at": None, "completed_at": None, "resolution": None, "labor_minutes": None,
+        "cancel_reason": None, "parts_cost": 0, "schedule": 1, "due_date": "2026-03-04", "overdue": False,
+    }
+    assert _outbox(app) == [{"id": 1, "channel": "preventive_generated", "created_at": "2026-03-01T09:30:00",
+                             "payload": {"schedule": 1, "work_order": 83, "next_due": "2027-03-05"}}]
+    assert app.get("/api/work_orders?schedule=1", user="sofia").json["items"] == [order]
+    assert app.get("/api/assets/3", user="ruth").json["open_orders"] == 2
+
+
+def test_generate_advances_once_however_late(app):
+    r = app.post("/api/schedules/4/generate", {}, user="yara", now="2026-06-01T08:00:00")
+    assert r.json["next_due"] == "2026-04-16"  # 2026-02-15 + 60 days, still in the past
+    order = app.get("/api/work_orders/83", user="yara").json
+    assert (order["priority"], order["requested_by"], order["due_date"]) == ("p4", 16, "2026-07-01")
+
+
+def test_generate_permissions(app):
+    for user in ("ruth", "nils", "tess", "mei", "yara"):
+        assert app.post("/api/schedules/5/generate", {}, user=user).status == 403
+    assert app.post("/api/schedules/2/generate", {"x": 1}, user="yara").status == 403  # 403 beats 409/400
+    assert app.post("/api/schedules/99/generate", {}, user="ruth").status == 404
+    assert app.post("/api/schedules/5/fly", {}, user="sofia").status == 404
+    assert app.post("/api/schedules/5/generate", {}, user="tomas").status == 200
+    assert app.post("/api/schedules/4/generate", {}, user="sofia").status == 200
+
+
+def test_generate_conflicts(app):
+    assert app.post("/api/schedules/3/generate", {}, user="sofia").status == 409  # inactive
+    # not before next_due minus 7 days (2026-03-13 for schedule 2)
+    assert app.post("/api/schedules/2/generate", {}, user="tomas", now="2026-03-12T23:59:59").status == 409
+    assert app.post("/api/schedules/2/generate", {"x": 1}, user="tomas", now="2026-03-12T10:00:00").status == 409
+    # an unfinished generated order blocks the next one, a finished one does not
+    assert app.post("/api/schedules/2/generate", {}, user="tomas", now="2026-03-13T00:00:00").status == 200
+    assert app.post("/api/schedules/2/generate", {}, user="tomas", now="2026-05-01T00:00:00").status == 409
+    order_id = app.get("/api/work_orders?schedule=2", user="tomas").json["items"][0]["id"]
+    app.post(f"/api/work_orders/{order_id}/cancel", {"reason": "Done otherwise"}, user="tomas")
+    assert app.post("/api/schedules/2/generate", {}, user="tomas", now="2026-05-01T00:00:00").status == 200
+    # an active schedule of a retired asset (reactivated after the retirement)
+    app.post("/api/schedules", NEW, user="yara")
+    app.patch("/api/assets/31", {"retired": True}, user="yara")
+    app.patch("/api/schedules/6", {"active": True}, user="yara")
+    assert app.post("/api/schedules/6/generate", {}, user="yara").status == 409
+    assert len(_outbox(app)) == 2
+
+
+def test_failed_generate_changes_nothing(app):
+    before = app.get("/api/schedules", user="ruth").json["items"]
+    assert app.post("/api/schedules/1/generate", {"bogus": True}, user="sofia").status == 400
+    assert app.post("/api/schedules/1/generate", [], user="sofia").status == 400
+    assert app.post("/api/schedules/2/generate", {}, user="sofia").status == 409
+    assert app.post("/api/schedules/1/generate", {}, user="tomas").status == 403
+    assert app.get("/api/schedules", user="ruth").json["items"] == before
+    assert len(app.get("/api/work_orders", user="sofia").json["items"]) == 82
+    assert _outbox(app) == []
+
