+    if not successor["active"]:
+        return "must be an active employee"
+    if successor["role"] != "manager":
+        return "must be a manager"
+    if successor["id"] == employee_id:
+        return "cannot be the offboarded employee"
+    if _is_same_or_reports_to(successor["manager"], employee_id):
+        return "must not report to the offboarded employee"
+    return None
+
