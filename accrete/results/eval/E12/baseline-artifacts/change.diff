+def offboard_employee(ctx, employee_id, params):
+    """Deactivate an employee in one step: their reports move to ``successor``, their draft
+    claims are deleted and an ``employee_offboarded`` message is emitted. All or nothing."""
+    with transaction():
+        employee = _load_employee(employee_id)
+        if not permissions.can_offboard_employee(ctx.user):
+            raise Forbidden("Only finance can offboard employees.")
+        _require_offboardable(employee)
+        successor_id = validation.clean_offboard_params(params)
+        _check_successor(successor_id, employee_id)
+        reassigned = repository.report_ids(employee_id)
+        deleted_claims = repository.claim_ids_of_employee(employee_id, ("draft",))
+        repository.reassign_reports(employee_id, successor_id)
+        repository.delete_claims(deleted_claims)
+        repository.mark_employee_inactive(employee_id)
+        repository.add_outbox_message(
+            "employee_offboarded",
+            {"employee": employee_id, "successor": successor_id, "reassigned": reassigned,
+             "deleted_claims": deleted_claims},
+            ctx.now_text,
+        )
+    return repository.get_employee(employee_id)
+
+
+def employee_actions(ctx, employee):
+    """Names of the actions the caller could start on ``employee`` right now (ignoring parameters)."""
+    actions = []
+    if permissions.can_offboard_employee(ctx.user) and _offboard_conflict(employee) is None:
+        actions.append("offboard")
+    return actions
+
+
+def offboard_successor_candidates(employee):
+    """Employees that would be accepted as ``successor`` when offboarding ``employee``."""
+    return [e for e in repository.list_employees() if _successor_error(e, employee["id"]) is None]
+
+
+def _offboard_conflict(employee):
+    """Why ``employee`` cannot be offboarded in their current state, or None."""
+    if not employee["active"]:
+        return "The employee is already inactive."
+    if repository.claim_ids_of_employee(employee["id"], OFFBOARD_BLOCKING_STATUSES):
+        return "The employee has submitted or approved claims; settle them first."
+    return None
+
+
+def _require_offboardable(employee):
+    message = _offboard_conflict(employee)
+    if message:
+        raise Conflict(message)
+
