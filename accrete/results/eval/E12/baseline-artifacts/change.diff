+"""Employee offboarding: the `active` flag, the offboard action and what inactive employees may do."""
+from accept_client import parse_ui
+
+NOW = "2026-03-02T09:30:00"
+CLAIM = {"amount": 42.5, "category": "meals", "description": "Team lunch"}
+
+
+def _employee(app, username, role="employee", manager=3):
+    body = {"username": username, "name": username.title(), "role": role, "manager": manager, "department": "Ops"}
+    r = app.post("/api/employees", body, user="fiona")
+    assert r.status == 201, r
+    return r.json["id"]
+
+
+def _claim(app, user):
+    r = app.post("/api/claims", CLAIM, user=user)
+    assert r.status == 201, r
+    return r.json["id"]
+
+
+def _offboarded(app, username, successor=2):
+    """Create an employee, offboard them and return their id."""
+    employee_id = _employee(app, username)
+    assert app.post(f"/api/employees/{employee_id}/offboard", {"successor": successor}, user="fiona").status == 200
+    return employee_id
+
+
+def test_active_field(app):
+    assert all(e["active"] is True for e in app.get("/api/employees", user="zoe").json["items"])
+    assert _employee(app, "ann") == 16
+    assert app.get("/api/employees/16", user="zoe").json["active"] is True
+    new = {"username": "bo", "name": "Bo", "role": "employee", "department": "Ops"}
+    r = app.post("/api/employees", dict(new, active=True), user="fiona")
+    assert r.status == 400 and "active" in r.json["fields"]
+    assert app.patch("/api/employees/5", {"active": False}, user="fiona").status == 400
+    assert app.patch("/api/employees/5", {"active": False}, user="marco").status == 403  # 403 beats 400
+    assert app.get("/api/employees?active=false", user="zoe").json["items"] == []
+    assert len(app.get("/api/employees?active=true", user="zoe").json["items"]) == 16
+
+
+def test_offboard_moves_reports_and_deletes_drafts(app):
+    mia = _employee(app, "mia", role="manager")
+    ned = _employee(app, "ned", manager=mia)
+    lou = _employee(app, "lou", manager=mia)
+    drafts = [_claim(app, "mia"), _claim(app, "mia")]
+    rejected = _claim(app, "mia")
+    app.post(f"/api/claims/{rejected}/submit", {}, user="mia")
+    assert app.post(f"/api/claims/{rejected}/reject", {"reason": "No"}, user="nadia").status == 200
+    ned_draft = _claim(app, "ned")
+
+    r = app.post(f"/api/employees/{mia}/offboard", {"successor": 2}, user="fiona", now=NOW)
+    assert r.status == 200
+    assert r.json == {"id": mia, "username": "mia", "name": "Mia", "role": "manager", "manager": 3,
+                      "department": "Ops", "active": False}
+    assert [app.get(f"/api/employees/{e}", user="zoe").json["manager"] for e in (ned, lou)] == [2, 2]
+    assert all(app.get(f"/api/claims/{c}", user="fiona").status == 404 for c in drafts)
+    assert app.get(f"/api/claims/{rejected}", user="fiona").json["status"] == "rejected"
+    assert app.get(f"/api/claims/{ned_draft}", user="fiona").status == 200  # only mia's drafts go
+    assert app.get("/api/_outbox", user="zoe").json["items"] == [
+        {"id": 1, "channel": "employee_offboarded", "created_at": NOW,
+         "payload": {"employee": mia, "successor": 2, "reassigned": [ned, lou], "deleted_claims": drafts}}
+    ]
+    assert app.get("/api/employees?active=false", user="zoe").json["items"] == [r.json]
+
+
+def test_offboarded_manager_hands_over_approvals(app):
+    r = app.post("/api/employees/3/offboard", {"successor": 2}, user="fiona")
+    assert r.status == 200 and r.json["active"] is False
+    payload = app.get("/api/_outbox", user="zoe").json["items"][0]["payload"]
