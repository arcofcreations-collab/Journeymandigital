+    assert app.post("/api/claims/58/approve", {}, user="nadia").status == 403
+    assert app.get("/api/claims/58", user="nadia").status == 403  # no longer rosa's manager
+    assert app.get("/api/claims/58", user="marco").status == 200
+    assert app.post("/api/claims/58/approve", {}, user="marco").json["decided_by"] == 2
+    app.post("/api/claims/4/pay", {}, user="fiona", now=NOW)
+    assert app.get("/api/_outbox?channel=payment", user="zoe").json["items"][0]["payload"] == {
+        "claim": 4, "employee": 10, "amount": 558.67}
