@@ -0,0 +1,188 @@
+"""The p1-p4 priority scale (E03): values, due dates, the high-criticality rule, the claim
+restriction and the migration of existing orders.
+
+High-criticality assets in the seed: 1, 3, 4, 5, 13 (North), 14, 15, 16, 21 (South), 26, 31 (East).
+Migrated priorities used below: 74 p2 (open, high), 52 p3 (open, medium), 38 p4 (open, low),
+82 p1 (open, high), 64 p4 (assigned, high: kept from `low`), 79 p1 (in_progress), 4 p2 (completed, high).
+"""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+
+def _create(app, priority, asset=2, user="sofia", now="2026-03-01T12:00:00"):
+    return app.post("/api/work_orders", {"asset": asset, "title": "Check", "priority": priority}, user=user, now=now)
+
+
+# --- values and due dates -------------------------------------------------------------
+
+def test_create_with_each_priority_and_due_date(app):
+    for priority, due in (("p1", "2026-03-02"), ("p2", "2026-03-04"), ("p3", "2026-03-08"), ("p4", "2026-03-31")):
+        r = _create(app, priority, now="2026-03-01T23:59:59")
+        assert r.status == 201 and (r.json["priority"], r.json["due_date"]) == (priority, due), priority
+
+
+def test_old_and_other_spellings_are_rejected(app):
+    for priority in ("urgent", "normal", "low", "P1", "p0", "p5", " p1", "1", 1, None, True):
+        assert _create(app, priority).status == 400, priority
+        r = app.patch("/api/work_orders/52", {"priority": priority}, user="sofia")
+        assert r.status == 400 and "priority" in r.json["fields"], priority
+    assert app.get("/api/work_orders/52", user="sofia").json["priority"] == "p3"
+
+
+def test_filter_with_old_value_matches_nothing(app, migrated_priorities):
+    for old in ("urgent", "normal", "low"):
+        r = app.get(f"/api/work_orders?priority={old}", user="sofia")
+        assert r.status == 200 and r.json["items"] == []
+    expected = [order_id for order_id, priority in migrated_priorities.items() if priority == "p4"]
+    assert [o["id"] for o in app.get("/api/work_orders?priority=p4", user="sofia").json["items"]] == expected
+
+
+def test_overdue_follows_the_new_due_dates(app):
+    order = app.get("/api/work_orders/74", user="sofia").json  # p2, created 2026-02-26
+    assert (order["due_date"], order["overdue"]) == ("2026-03-01", False)
+    assert app.get("/api/work_orders/74", user="sofia", now="2026-03-02T00:00:00").json["overdue"] is True
+    order = app.get("/api/work_orders/4", user="sofia").json  # p2, completed: never overdue
+    assert (order["due_date"], order["overdue"]) == ("2025-10-12", False)
+
+
+# --- p4 is not allowed for high-criticality assets ------------------------------------
+
+def test_p4_refused_for_high_criticality_asset_on_create(app):
+    r = _create(app, "p4", asset=1)
+    assert r.status == 400 and "priority" in r.json["fields"]
+    assert _create(app, "p4", asset=1, user="ruth").status == 400
+    assert _create(app, "p3", asset=1).status == 201
+    assert _create(app, "p4", asset=2).status == 201  # medium
+    assert _create(app, "p4", asset=9).status == 201  # low
+    assert len(app.get("/api/work_orders?asset=1", user="sofia").json["items"]) == 2
+
+
+def test_p4_refused_for_high_criticality_asset_on_patch(app):
+    before = app.get("/api/work_orders/74", user="sofia").json
+    r = app.patch("/api/work_orders/74", {"priority": "p4"}, user="sofia")
+    assert r.status == 400 and "priority" in r.json["fields"]
+    assert app.patch("/api/work_orders/74", {"title": "x", "priority": "p4"}, user="sofia").status == 400
+    assert app.get("/api/work_orders/74", user="sofia").json == before  # nothing changed
+    assert app.patch("/api/work_orders/52", {"priority": "p4"}, user="sofia").json["priority"] == "p4"  # medium
+
+
+def test_rule_follows_the_assets_current_criticality(app):
+    assert app.patch("/api/assets/8", {"criticality": "high"}, user="sofia").status == 200  # asset of 52
+    assert app.patch("/api/work_orders/52", {"priority": "p4"}, user="sofia").status == 400
+    assert app.patch("/api/assets/1", {"criticality": "medium"}, user="sofia").status == 200  # asset of 74
+    assert app.patch("/api/work_orders/74", {"priority": "p4"}, user="sofia").json["priority"] == "p4"
+
+
+def test_existing_p4_on_high_criticality_asset_is_kept(app):
+    order = app.get("/api/work_orders/64", user="sofia").json  # was low, asset 21 is high
+    assert order["priority"] == "p4" and order["status"] == "assigned"
+    r = app.patch("/api/work_orders/64", {"priority": "p4"}, user="sofia")  # setting it again is refused
+    assert r.status == 400 and "priority" in r.json["fields"]
+    r = app.patch("/api/work_orders/64", {"title": "Generator check", "description": "Monthly"}, user="tomas")
+    assert r.status == 200 and (r.json["title"], r.json["priority"]) == ("Generator check", "p4")
+    assert app.patch("/api/work_orders/64", {"priority": "p3"}, user="tomas").json["priority"] == "p3"
+    assert app.patch("/api/work_orders/64", {"priority": "p4"}, user="tomas").status == 400  # no way back
+
+
+def test_precedence_of_the_p4_rule(app):
+    assert _create(app, "p4", asset=14, user="ruth").status == 403  # other site: 403 beats 400
+    assert _create(app, "p4", asset=14, user="nils").status == 403
+    assert app.patch("/api/work_orders/74", {"priority": "p4"}, user="ruth").status == 403  # requester
+    assert app.patch("/api/work_orders/74", {"priority": "p4"}, user="kofi").status == 403  # unrelated
+    assert app.patch("/api/work_orders/4", {"priority": "p4"}, user="sofia").status == 409  # completed, high
+    assert app.patch("/api/work_orders/6", {"priority": "p4"}, user="sofia").status == 409  # cancelled, high
+    assert app.get("/api/_outbox", user="sofia").json["items"] == []
+
+
+# --- claim only p3/p4 -----------------------------------------------------------------
+
+def test_technicians_claim_only_p3_and_p4(app):
+    for order_id in (74, 65, 82):  # p2, p2, p1 at North
+        r = app.post(f"/api/work_orders/{order_id}/claim", {}, user="olga")
+        assert r.status == 403 and r.json["error"] == "forbidden", order_id
+    assert app.post("/api/work_orders/52/claim", {}, user="olga").json["priority"] == "p3"
+    assert app.post("/api/work_orders/78/claim", {}, user="wade").json["priority"] == "p3"
+    assert app.post("/api/work_orders/60/claim", {}, user="sara").status == 409  # p4, sara at the cap
+    assert [m["payload"]["work_order"] for m in app.get("/api/_outbox", user="sofia").json["items"]] == [52, 78]
+
+
+def test_claim_priority_403_beats_409(app):
+    assert app.post("/api/work_orders/74/claim", {}, user="nils").status == 403  # p2, nils at the cap
+    assert app.post("/api/work_orders/54/claim", {}, user="ravi").status == 403  # p2, ravi above the cap
+    assert app.post("/api/work_orders/79/claim", {}, user="olga").status == 403  # p1, in_progress
+    assert app.post("/api/work_orders/4/claim", {}, user="olga").status == 403  # p2, completed
+    assert app.post("/api/work_orders/74/claim", {"x": 1}, user="olga").status == 403  # 403 beats 400
+    assert app.post("/api/work_orders/75/claim", {}, user="olga").status == 409  # p3, assigned
+
+
+def test_claim_follows_the_current_priority(app):
+    assert app.patch("/api/work_orders/74", {"priority": "p3"}, user="sofia").status == 200
+    assert app.post("/api/work_orders/74/claim", {}, user="olga").status == 200
+    assert app.patch("/api/work_orders/38", {"priority": "p2"}, user="sofia").status == 200
+    assert app.post("/api/work_orders/38/claim", {}, user="olga").status == 403
+
+
+def test_supervisors_assign_any_priority(app):
+    r = app.post("/api/work_orders/82/assign", {"technician": 9}, user="sofia")  # p1
+    assert r.status == 200 and (r.json["assignee"], r.json["dispatch"]) == (9, "supervisor")
+    assert app.post("/api/work_orders/76/assign", {"technician": 15}, user="tomas").status == 200  # p1
+    assert app.post("/api/work_orders/74/assign", {"technician": 9}, user="sofia").status == 409  # olga now at cap
+
+
+def test_claim_form_follows_priority(app):
+    def actions(order_id, user):
+        return parse_ui(app.get(f"/ui/work_orders/{order_id}", user=user).text).actions
+
+    assert actions(74, "olga") == [] and actions(82, "olga") == []
+    assert actions(52, "olga") == ["claim"] and actions(38, "olga") == ["claim"]
+    assert actions(54, "wade") == [] and actions(78, "wade") == ["claim"]
+    app.patch("/api/work_orders/74", {"priority": "p4"}, user="sofia")  # refused (high criticality)
+    assert actions(74, "olga") == []
+    app.patch("/api/work_orders/74", {"priority": "p3"}, user="sofia")
+    assert actions(74, "olga") == ["claim"]
+
+
+def test_new_work_order_form_offers_the_new_scale(app):
+    page = app.get("/ui/work_orders/new", user="ruth").text
+    for priority in ("p1", "p2", "p3", "p4"):
+        assert f'value="{priority}"' in page
+    for old in ("urgent", "normal", "low"):
+        assert f'value="{old}"' not in page
+
+
+# --- migration ------------------------------------------------------------------------
+
+def test_existing_orders_are_migrated(app, seed, migrated_priorities):
+    orders = {o["id"]: o for o in app.get("/api/work_orders", user="sofia").json["items"]}
+    assert {i: o["priority"] for i, o in orders.items()} == migrated_priorities
+    # urgent -> p1; normal -> p2 (high) / p3 (medium, low); low -> p4 (also on high assets)
+    assert [orders[i]["priority"] for i in (77, 27, 74, 52, 75, 38, 64, 6)] == \
+        ["p1", "p1", "p2", "p3", "p3", "p4", "p4", "p4"]
+    assert orders[6]["status"] == "cancelled" and orders[26]["status"] == "completed"  # all statuses
+    seed_orders = {o["id"]: o for o in seed["work_orders"]}
+    for order_id, order in orders.items():  # nothing else changed
+        expected = {k: v for k, v in seed_orders[order_id].items() if k != "priority"}
+        assert {k: order[k] for k in expected} == expected
+
+
+def test_migrated_database(app):
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    try:
+        priorities = {row[0] for row in conn.execute("SELECT DISTINCT priority FROM work_orders")}
+        assert priorities == {"p1", "p2", "p3", "p4"}
+        assert conn.execute("SELECT seq FROM sqlite_sequence WHERE name = 'work_orders'").fetchone()[0] == 82
+        assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+        indexes = {row[0] for row in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type = 'index' AND tbl_name = 'work_orders' AND sql IS NOT NULL")}
+        assert indexes == {"work_orders_asset_id", "work_orders_requested_by_id", "work_orders_assignee_id"}
+        try:
+            conn.execute("UPDATE work_orders SET priority = 'urgent' WHERE id = 1")
+        except sqlite3.IntegrityError:
+            pass
+        else:
+            raise AssertionError("the schema should only accept p1-p4")
+    finally:
+        conn.close()
+    assert app.post("/api/work_orders", {"asset": 2, "title": "x", "priority": "p3"}, user="sofia").json["id"] == 83
