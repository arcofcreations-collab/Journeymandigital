--- a/maintenance_app/migrations/0004_work_order_priority_scale.sql
+++ b/maintenance_app/migrations/0004_work_order_priority_scale.sql
@@ -0,0 +1,53 @@
+-- Priorities become the four-level scale p1 (most urgent) .. p4, which also reflects the
+-- asset's criticality. Existing orders (all statuses) are mapped:
+--   urgent -> p1;  normal -> p2 on a high-criticality asset, otherwise p3;  low -> p4
+-- (low orders on high-criticality assets also become p4 and keep it; the API only refuses
+-- *setting* p4 on such orders). No other column changes.
+--
+-- The CHECK constraint on priority can't be altered in place, so the table is rebuilt
+-- (create-copy-drop-rename; the runner applies migrations with foreign keys off and checks
+-- them before committing).
+
+CREATE TABLE work_orders_new (
+    id              INTEGER PRIMARY KEY AUTOINCREMENT,
+    asset_id        INTEGER NOT NULL REFERENCES assets (id),
+    title           TEXT    NOT NULL,
+    description     TEXT,
+    priority        TEXT    NOT NULL CHECK (priority IN ('p1', 'p2', 'p3', 'p4')),
+    status          TEXT    NOT NULL DEFAULT 'open'
+                            CHECK (status IN ('open', 'assigned', 'in_progress', 'completed', 'cancelled')),
+    requested_by_id INTEGER NOT NULL REFERENCES staff (id),
+    created_at      TEXT    NOT NULL,  -- YYYY-MM-DDTHH:MM:SS (UTC)
+    assignee_id     INTEGER REFERENCES staff (id),
+    started_at      TEXT,              -- YYYY-MM-DDTHH:MM:SS (UTC)
+    completed_at    TEXT,              -- YYYY-MM-DDTHH:MM:SS (UTC)
+    resolution      TEXT,
+    labor_minutes   INTEGER CHECK (labor_minutes IS NULL OR labor_minutes >= 1),
+    cancel_reason   TEXT,
+    dispatch        TEXT    CHECK (dispatch IS NULL OR dispatch IN ('supervisor', 'self'))
+);
+
+INSERT INTO work_orders_new (id, asset_id, title, description, priority, status, requested_by_id, created_at,
+                             assignee_id, started_at, completed_at, resolution, labor_minutes, cancel_reason,
+                             dispatch)
+SELECT w.id, w.asset_id, w.title, w.description,
+       CASE w.priority
+           WHEN 'urgent' THEN 'p1'
+           WHEN 'normal' THEN CASE WHEN a.criticality = 'high' THEN 'p2' ELSE 'p3' END
+           WHEN 'low'    THEN 'p4'
+       END,
+       w.status, w.requested_by_id, w.created_at, w.assignee_id, w.started_at, w.completed_at, w.resolution,
+       w.labor_minutes, w.cancel_reason, w.dispatch
+  FROM work_orders AS w
+  JOIN assets AS a ON a.id = w.asset_id;
+
+-- Keep the id counter where it was, so new orders continue exactly as before.
+DELETE FROM sqlite_sequence WHERE name = 'work_orders_new';
+INSERT INTO sqlite_sequence (name, seq) SELECT 'work_orders_new', seq FROM sqlite_sequence WHERE name = 'work_orders';
+
+DROP TABLE work_orders;
+ALTER TABLE work_orders_new RENAME TO work_orders;
+
+CREATE INDEX work_orders_asset_id ON work_orders (asset_id);
+CREATE INDEX work_orders_requested_by_id ON work_orders (requested_by_id);
+CREATE INDEX work_orders_assignee_id ON work_orders (assignee_id);
