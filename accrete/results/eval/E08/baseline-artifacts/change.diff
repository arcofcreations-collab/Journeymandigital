@@ -0,0 +1,49 @@
+-- Physical copies of books. A loan now lends one copy; the loan's book is the copy's book.
+
+CREATE TABLE copies (
+    id      INTEGER PRIMARY KEY AUTOINCREMENT,
+    book_id INTEGER NOT NULL REFERENCES books (id),  -- fixed at creation
+    barcode TEXT    NOT NULL UNIQUE
+);
+
+CREATE INDEX copies_book_id ON copies (book_id);
+
+-- Every existing book gets one copy with the same id (book 7 -> copy 7, barcode "C0007").
+INSERT INTO copies (id, book_id, barcode)
+SELECT id, id, 'C' || printf('%04d', id) FROM books ORDER BY id;
+
+-- Second copies bought for books 1 and 22 (only where those books exist).
+INSERT INTO copies (id, book_id, barcode) SELECT 41, id, 'C0001-2' FROM books WHERE id = 1;
+INSERT INTO copies (id, book_id, barcode) SELECT 42, id, 'C0022-2' FROM books WHERE id = 22;
+
+-- New copies get ids above 42.
+INSERT INTO sqlite_sequence (name, seq)
+SELECT 'copies', 42 WHERE NOT EXISTS (SELECT 1 FROM sqlite_sequence WHERE name = 'copies');
+UPDATE sqlite_sequence SET seq = 42 WHERE name = 'copies' AND seq < 42;
+
+-- Loans reference the copy that was lent instead of the book (create-copy-drop-rename).
+-- Existing loans were of each book's original copy, whose id equals the book id.
+CREATE TABLE loans_new (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    copy_id     INTEGER NOT NULL REFERENCES copies (id),
+    member_id   INTEGER NOT NULL REFERENCES members (id),
+    borrowed_at TEXT    NOT NULL,  -- YYYY-MM-DDTHH:MM:SS (UTC)
+    due_at      TEXT    NOT NULL,  -- YYYY-MM-DD
+    returned_at TEXT               -- YYYY-MM-DDTHH:MM:SS (UTC) or NULL while on loan
+);
+
+INSERT INTO loans_new (id, copy_id, member_id, borrowed_at, due_at, returned_at)
+SELECT id, book_id, member_id, borrowed_at, due_at, returned_at FROM loans ORDER BY id;
+
+-- Keep the loan id counter: hand the old table's sqlite_sequence row to the new table
+-- (the rename below carries it over to "loans").
+DELETE FROM sqlite_sequence WHERE name = 'loans_new';
+UPDATE sqlite_sequence SET name = 'loans_new' WHERE name = 'loans';
+
+DROP TABLE loans;
+ALTER TABLE loans_new RENAME TO loans;
+
+CREATE INDEX loans_copy_id ON loans (copy_id);
+CREATE INDEX loans_member_id ON loans (member_id);
+-- A copy can be on loan to at most one member at a time.
+CREATE UNIQUE INDEX loans_one_open_loan_per_copy ON loans (copy_id) WHERE returned_at IS NULL;
