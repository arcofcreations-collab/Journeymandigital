--- a/tests/test_library_copies.py
+++ b/tests/test_library_copies.py
@@ -0,0 +1,182 @@
+"""Copies: physical copies of books, their derived status, and how borrowing uses them."""
+import os
+import sqlite3
+
+from accept_client import fresh_app, parse_ui
+
+NEW_BOOK = {"title": "Dune", "author": "F. Herbert", "isbn": "978-0441013593", "year": 1965}
+
+
+# --- migrated data --------------------------------------------------------------------
+
+def test_every_book_has_its_original_copy_plus_two_second_copies(app):
+    copies = app.get("/api/copies", user="chen").json["items"]
+    assert [c["id"] for c in copies] == list(range(1, 43))
+    assert all(c["book"] == c["id"] and c["barcode"] == f"C{c['id']:04d}" for c in copies[:40])
+    assert copies[40] == {"id": 41, "book": 1, "barcode": "C0001-2", "status": "available"}
+    assert copies[41] == {"id": 42, "book": 22, "barcode": "C0022-2", "status": "available"}
+
+
+def test_existing_loans_lent_the_original_copy(app):
+    loans = app.get("/api/loans", user="ada").json["items"]
+    assert len(loans) == 60 and all(l["copy"] == l["book"] for l in loans)
+    open_copies = {l["copy"] for l in loans if l["returned_at"] is None}
+    on_loan = app.get("/api/copies?status=on_loan", user="ada").json["items"]
+    assert {c["id"] for c in on_loan} == open_copies
+
+
+def test_book_status_and_available_copies_come_from_copies(app):
+    books = {b["id"]: b for b in app.get("/api/books", user="lena").json["items"]}
+    assert books[1]["status"] == "available" and books[1]["available_copies"] == 1  # second copy
+    assert books[22]["status"] == "available" and books[22]["available_copies"] == 1
+    assert books[4]["status"] == "on_loan" and books[4]["available_copies"] == 0
+    assert books[2]["status"] == "available" and books[2]["available_copies"] == 1
+    assert [b["id"] for b in app.get("/api/books?available_copies=0", user="chen").json["items"]] == \
+           [b["id"] for b in books.values() if b["status"] == "on_loan"]
+
+
+def test_migration_upgrades_a_database_without_copies(app, seed):
+    """Rebuild the pre-copies database (0001 + original records) and let startup migrate it."""
+    path = os.path.join(app.workdir, "data.db")
+    os.remove(path)
+    conn = sqlite3.connect(path)
+    with open(os.path.join(app.workdir, "library_app", "migrations", "0001_initial.sql")) as fh:
+        conn.executescript(fh.read())
+    conn.execute("CREATE TABLE schema_version (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL)")
+    conn.execute("INSERT INTO schema_version VALUES (1, 'initial', '2026-01-01T00:00:00')")
+    conn.executemany("INSERT INTO members VALUES (:id, :username, :name, :role, :active)", seed["members"])
+    conn.executemany("INSERT INTO books VALUES (:id, :title, :author, :isbn, :year)", seed["books"])
+    conn.executemany("INSERT INTO loans VALUES (:id, :book, :member, :borrowed_at, :due_at, :returned_at)",
+                     seed["loans"])
+    conn.commit()
+    conn.close()
+
+    upgraded = fresh_app(app.workdir)
+    copies = upgraded.get("/api/copies", user="ada").json["items"]
+    assert [{k: v for k, v in c.items() if k != "status"} for c in copies] == seed["copies"]
+    loans = upgraded.get("/api/loans", user="ada").json["items"]
+    assert [{k: v for k, v in l.items() if k != "overdue"} for l in loans] == seed["loans"]
+    assert upgraded.post("/api/copies", {"book": 3, "barcode": "NEW"}, user="ada").json["id"] == 43
+    assert upgraded.post("/api/books/3/borrow", {}, user="chen").status == 200
+    assert upgraded.get("/api/loans/61", user="chen").json["copy"] == 3
+
+
+# --- CRUD, permissions, validation ----------------------------------------------------
+
+def test_any_user_reads_copies(app):
+    assert len(app.get("/api/copies", user="lena").json["items"]) == 42
+    assert app.get("/api/copies/1", user="chen").json == {"id": 1, "book": 1, "barcode": "C0001", "status": "on_loan"}
+    assert [c["id"] for c in app.get("/api/copies?book=1", user="chen").json["items"]] == [1, 41]
+    assert app.get("/api/copies/999", user="chen").status == 404
+
+
+def test_librarian_adds_copy_to_a_new_book(app):
+    book = app.post("/api/books", NEW_BOOK, user="ada").json
+    assert book["status"] == "unavailable" and book["available_copies"] == 0
+    r = app.post("/api/copies", {"book": book["id"], "barcode": "D-1"}, user="ada")
+    assert r.status == 201 and r.json == {"id": 43, "book": book["id"], "barcode": "D-1", "status": "available"}
+    book = app.get(f"/api/books/{book['id']}", user="chen").json
+    assert book["status"] == "available" and book["available_copies"] == 1
+
+
+def test_member_cannot_manage_copies(app):
+    assert app.post("/api/copies", {"book": 3, "barcode": "X"}, user="chen").status == 403
+    assert app.post("/api/copies", {"status": "on_loan"}, user="chen").status == 403  # 403 beats 400
+    assert app.patch("/api/copies/3", {"barcode": "X"}, user="chen").status == 403
+    assert app.patch("/api/copies/3", {"book": 4}, user="chen").status == 403
+    assert app.delete("/api/copies/41", user="chen").status == 403
+    assert app.patch("/api/copies/999", {"barcode": "X"}, user="chen").status == 404
+    assert app.delete("/api/copies/999", user="chen").status == 404
+
+
+def test_copy_create_validation(app):
+    r = app.post("/api/copies", {}, user="ada")
+    assert r.status == 400 and set(r.json["fields"]) == {"book", "barcode"}
+    assert app.post("/api/copies", {"book": 3, "barcode": ""}, user="ada").status == 400
+    dup = app.post("/api/copies", {"book": 3, "barcode": "C0001"}, user="ada")
+    assert dup.status == 400 and dup.json["fields"] == {"barcode": "already in use"}
+    assert app.post("/api/copies", {"book": 999, "barcode": "X"}, user="ada").json["fields"] == {"book": "no such book"}
+    assert app.post("/api/copies", {"book": "3", "barcode": "X"}, user="ada").status == 400
+    for extra in ({"status": "available"}, {"id": 50}, {"colour": "red"}):
+        assert app.post("/api/copies", {"book": 3, "barcode": "X", **extra}, user="ada").status == 400
+    assert len(app.get("/api/copies", user="ada").json["items"]) == 42
+
+
+def test_copy_patch(app):
+    r = app.patch("/api/copies/3", {"barcode": "C0003-A"}, user="ada")
+    assert r.status == 200 and r.json == {"id": 3, "book": 3, "barcode": "C0003-A", "status": "available"}
+    assert app.patch("/api/copies/3", {"barcode": "C0003-A"}, user="ada").status == 200  # unchanged is fine
+    assert app.patch("/api/copies/3", {"barcode": "C0004"}, user="ada").status == 400  # duplicate
+    assert app.patch("/api/copies/3", {"barcode": ""}, user="ada").status == 400
+    assert app.patch("/api/copies/3", {"book": 3}, user="ada").status == 400  # book is fixed
+    assert app.patch("/api/copies/3", {"status": "on_loan"}, user="ada").status == 400
+    assert app.patch("/api/copies/3", {"shelf": "A"}, user="ada").status == 400
+
+
+def test_delete_copy(app):
+    assert app.delete("/api/copies/1", user="ada").status == 409  # open loan
+    assert app.get("/api/copies/30", user="ada").json["status"] == "available"
+    assert app.delete("/api/copies/30", user="ada").status == 409  # returned loans only
+    assert app.delete("/api/copies/41", user="ada").status == 204
+    assert app.get("/api/copies/41", user="ada").status == 404
+    assert app.get("/api/books/1", user="ada").json["status"] == "on_loan"
+
+
+# --- borrowing copies -----------------------------------------------------------------
+
+def test_borrow_lends_lowest_available_copy(app):
+    r = app.post("/api/books/1/borrow", {}, user="chen")
+    assert r.status == 200 and r.json["status"] == "on_loan" and r.json["available_copies"] == 0
+    assert app.get("/api/loans/61", user="chen").json["copy"] == 41
+    assert app.get("/api/_outbox", user="chen").json["items"][0]["payload"] == \
+           {"loan": 61, "book": 1, "member": 3, "copy": 41}
+    assert app.post("/api/books/1/borrow", {}, user="dara").status == 409  # every copy on loan
+
+    assert app.post("/api/loans/52/return", {}, user="chen").status == 200  # frees copy 22
+    assert app.get("/api/books/22", user="dara").json["available_copies"] == 2
+    assert app.post("/api/books/22/borrow", {}, user="dara").status == 200
+    assert app.get("/api/loans/62", user="dara").json["copy"] == 22
+    assert app.post("/api/books/22/borrow", {"member": 5}, user="ada").status == 200
+    assert app.get("/api/loans/63", user="ada").json["copy"] == 42
+
+
+def test_book_without_copies_cannot_be_borrowed(app):
+    book = app.post("/api/books", NEW_BOOK, user="ada").json
+    assert app.post(f"/api/books/{book['id']}/borrow", {}, user="chen").status == 409
+    assert app.post(f"/api/books/{book['id']}/borrow", {"member": 999}, user="ada").status == 409  # 409 beats 400
+    assert app.post(f"/api/books/{book['id']}/borrow", {"member": 4}, user="chen").status == 403  # 403 beats 409
+    assert app.get("/api/_outbox", user="chen").json["items"] == []
+
+
+def test_loan_copy_is_read_only(app):
+    assert app.patch("/api/loans/55", {"copy": 41}, user="ada").status == 403
+    assert app.post("/api/loans", {"copy": 41, "member": 3}, user="ada").status == 403
+
+
+def test_deleting_book_deletes_its_copies(app):
+    book = app.post("/api/books", NEW_BOOK, user="ada").json
+    first = app.post("/api/copies", {"book": book["id"], "barcode": "D-1"}, user="ada").json
+    second = app.post("/api/copies", {"book": book["id"], "barcode": "D-2"}, user="ada").json
+    assert app.delete(f"/api/books/{book['id']}", user="ada").status == 204
+    assert app.get(f"/api/copies/{first['id']}", user="ada").status == 404
+    assert app.get(f"/api/copies/{second['id']}", user="ada").status == 404
+    assert app.post("/api/copies", {"book": 22, "barcode": "D-1"}, user="ada").status == 201  # barcode freed
+
+
+# --- UI -------------------------------------------------------------------------------
+
+def test_copy_pages(app):
+    page = parse_ui(app.get("/ui/copies/41", user="lena").text)
+    assert page.fields == {"book": "1", "barcode": "C0001-2", "status": "available"} and page.actions == []
+    assert parse_ui(app.get("/ui/copies", user="lena").text).rows == list(range(1, 43))
+    assert app.get("/ui/copies/999", user="lena").status == 404
+    assert parse_ui(app.get("/ui/loans/55", user="ada").text).fields["copy"] == "1"
+
+
+def test_borrow_form_follows_available_copies(app):
+    assert parse_ui(app.get("/ui/books/1", user="chen").text).actions == ["borrow"]  # second copy free
+    page = parse_ui(app.get("/ui/books/4", user="chen").text)
+    assert page.actions == [] and page.fields["available_copies"] == "0"
+    book = app.post("/api/books", NEW_BOOK, user="ada").json
+    page = parse_ui(app.get(f"/ui/books/{book['id']}", user="ada").text)
+    assert page.actions == [] and page.fields["status"] == "unavailable"
