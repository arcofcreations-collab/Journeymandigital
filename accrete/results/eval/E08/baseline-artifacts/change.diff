+def clean_copy(data, *, partial):
+    """``partial`` is a PATCH: only ``barcode`` may be given."""
+    data = require_object(data)
+    errors = unknown_field_errors(data, COPY_UPDATABLE if partial else COPY_CREATABLE)
+    values = {}
+    if not partial:
+        with collect(errors, "book"):
+            values["book"] = record_id(data.get("book"))
+    if "barcode" in data or not partial:
+        with collect(errors, "barcode"):
+            values["barcode"] = required_text(data.get("barcode"))
+    raise_if_errors(errors)
+    return values
+
