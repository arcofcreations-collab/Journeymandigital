+  - {as: chen, do: "GET /api/books/4", status: 200, json: {status: on_loan, available_copies: 0}}
+  - {as: chen, do: "GET /api/books/3", status: 200, json: {status: available, available_copies: 1}}
+  - {as: chen, do: "GET /api/copies", status: 200, count: 42}
+  - {as: chen, do: "GET /api/copies/7", status: 200, json: {id: 7, book: 7, barcode: C0007, status: on_loan}}
+  - {as: chen, do: "GET /api/copies/2", status: 200, json: {id: 2, book: 2, barcode: C0002, status: available}}
+  - {as: chen, do: "GET /api/copies/41", status: 200, json: {book: 1, barcode: C0001-2, status: available}}
+  - {as: chen, do: "GET /api/copies/1", status: 200, json: {status: on_loan}}
+  - {as: ada, do: "GET /api/loans/55", status: 200, json: {book: 1, copy: 1}}
+  - {as: ada, do: "GET /api/loans/1", status: 200, json: {book: 30, copy: 30}}
+  - {as: chen, do: "POST /api/copies", body: {book: 999}, status: 403}
+  - {as: chen, do: "PATCH /api/copies/2", body: {status: x}, status: 403}
+  - {as: chen, do: "DELETE /api/copies/41", status: 403}
+  - {as: ada, do: "POST /api/copies", body: {book: 999, barcode: X1}, status: 400}
+  - {as: ada, do: "POST /api/copies", body: {book: 2}, status: 400}
+  - {as: ada, do: "POST /api/copies", body: {book: 2, barcode: ""}, status: 400}
+  - {as: ada, do: "POST /api/copies", body: {book: 2, barcode: C0003}, status: 400}
+  - {as: ada, do: "POST /api/copies", body: {book: 2, barcode: X1, status: available}, status: 400}
+  - {as: ada, do: "POST /api/copies", body: {book: 2, barcode: X1, foo: 1}, status: 400}
+  - {as: ada, do: "POST /api/copies", body: {barcode: X1}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {book: 3}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {book: 2}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {status: on_loan}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {foo: 1}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {barcode: C0003}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {barcode: ""}, status: 400}
+  - {as: ada, do: "PATCH /api/copies/2", body: {barcode: NEW2}, status: 200, json: {id: 2, book: 2, barcode: NEW2}}
+  - {as: ada, do: "DELETE /api/copies/1", status: 409}
+  - {as: ada, do: "DELETE /api/copies/30", status: 409}
+  - {as: ada, do: "DELETE /api/copies/41", status: 204}
+  - {as: ada, do: "DELETE /api/books/1", status: 409}
+  - {as: ada, do: "POST /api/books/4/borrow", body: {member: 4}, status: 409}
+  - name: "new copy gets id 43 and makes a new book available"
+    steps:
+      - {as: ada, do: "POST /api/books", body: {title: T, author: A, isbn: "999-1"}, status: 201, json: {id: 41, status: unavailable, available_copies: 0}}
+      - {as: ada, do: "POST /api/books/41/borrow", body: {member: 4}, status: 409}
+      - {as: ada, do: "POST /api/copies", body: {book: 41, barcode: NEW}, status: 201, json: {id: 43, book: 41, barcode: NEW, status: available}}
+      - {as: ada, do: "GET /api/books/41", json: {status: available, available_copies: 1}}
+  - name: "borrow lends lowest available copy and emits it"
+    steps:
+      - {as: ada, do: "POST /api/books/1/borrow", body: {member: 4}, status: 200, json: {status: on_loan, available_copies: 0}}
+      - {as: ada, do: "GET /api/loans?copy=41", count: 1}
+      - {as: ada, do: "GET /api/copies/41", json: {status: on_loan}}
+      - {as: ada, do: "GET /api/_outbox?channel=loan_created", count: 1, json: {items: [{payload: {loan: 61, book: 1, member: 4, copy: 41}}]}}
+      - {as: ada, do: "POST /api/books/1/borrow", body: {member: 5}, status: 409}
+      - {as: ada, do: "POST /api/loans/61/return", status: 200, json: {copy: 41}}
+      - {as: ada, do: "GET /api/copies/41", json: {status: available}}
+      - {as: ada, do: "GET /api/books/1", json: {status: available, available_copies: 1}}
+  - name: "two copies: lowest id first"
+    steps:
+      - {as: ada, do: "POST /api/copies", body: {book: 3, barcode: C0003-2}, status: 201}
+      - {as: ada, do: "POST /api/books/3/borrow", body: {member: 4}, status: 200, json: {status: available, available_copies: 1}}
+      - {as: ada, do: "GET /api/loans/61", json: {copy: 3}}
+      - {as: ada, do: "POST /api/books/3/borrow", body: {member: 5}, status: 200, json: {status: on_loan, available_copies: 0}}
+      - {as: ada, do: "GET /api/loans/62", json: {copy: 43}}
+  - name: "deleting a loan-free book deletes its copies"
+    steps:
+      - {as: ada, do: "DELETE /api/books/3", status: 204}
+      - {as: ada, do: "GET /api/copies/3", status: 404}
+      - {as: ada, do: "GET /api/copies", count: 41}
+  - {as: ada, do: "POST /api/loans", body: {book: 2, member: 3, copy: 2, borrowed_at: "2026-01-01T00:00:00", due_at: "2026-01-02"}, status: 403}
+  - {as: ada, do: "PATCH /api/loans/1", body: {copy: 2}, status: 403}
