+def test_dispatch_filter(app, seed):
+    def ids(query):
+        return [o["id"] for o in app.get(f"/api/work_orders?{query}", user="sofia").json["items"]]
+
+    unassigned = [o["id"] for o in seed["work_orders"] if o["assignee"] is None]
+    own = [o["id"] for o in seed["work_orders"] if o["assignee"] is not None and o["assignee"] == o["requested_by"]]
+    assert ids("dispatch=null") == unassigned
+    assert ids("dispatch=self") == own
+    assert len(ids("dispatch=supervisor")) == len(seed["work_orders"]) - len(unassigned) - len(own)
+    app.post("/api/work_orders/74/claim", {}, user="olga")
+    assert 74 in ids("dispatch=self&status=assigned")
+
+
+def test_existing_orders_are_migrated(app, seed):
+    orders = {o["id"]: o for o in app.get("/api/work_orders", user="sofia").json["items"]}
+    for expected in seed["work_orders"]:
+        if expected["assignee"] is None:
+            dispatch = None
+        elif expected["assignee"] == expected["requested_by"]:
+            dispatch = "self"
+        else:
+            dispatch = "supervisor"
+        assert orders[expected["id"]]["dispatch"] == dispatch, expected["id"]
+    assert orders[22]["dispatch"] == "self" and orders[22]["status"] == "cancelled"  # all statuses
+    assert orders[13]["dispatch"] == "supervisor" and orders[1]["dispatch"] is None
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    assert conn.execute("SELECT COUNT(*) FROM outbox").fetchone()[0] == 0
+    conn.close()
