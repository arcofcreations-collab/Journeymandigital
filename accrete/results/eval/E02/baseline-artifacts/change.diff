+def test_reassign_to_current_assignee_is_always_allowed(app):
+    r = app.post("/api/work_orders/77/assign", {"technician": 8}, user="sofia")  # nils at 3
+    assert r.status == 200 and r.json["dispatch"] == "supervisor"
+    r = app.post("/api/work_orders/68/assign", {"technician": 10}, user="tomas")  # ravi above the cap
+    assert r.status == 200 and r.json["assignee"] == 10
+    assert app.post("/api/work_orders/77/assign", {"technician": 9}, user="sofia").status == 200  # olga: 2 -> 3
+    assert app.post("/api/work_orders/77/assign", {"technician": 8}, user="sofia").status == 200  # back to nils (2)
