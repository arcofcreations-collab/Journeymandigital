@@ -0,0 +1,12 @@
+-- How a work order got its assignee: 'supervisor' (assign), 'self' (claim) or NULL (never assigned).
+
+ALTER TABLE work_orders ADD COLUMN dispatch TEXT CHECK (dispatch IS NULL OR dispatch IN ('supervisor', 'self'));
+
+-- Existing orders (all statuses): an assignee who also requested the order took it themselves.
+UPDATE work_orders
+   SET dispatch = CASE
+                      WHEN assignee_id IS NULL THEN NULL
+                      WHEN assignee_id = requested_by_id THEN 'self'
+                      ELSE 'supervisor'
+                  END;
+
