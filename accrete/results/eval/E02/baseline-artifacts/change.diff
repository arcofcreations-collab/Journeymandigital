+def test_dispatch_is_read_only(app):
+    body = {"asset": 1, "title": "Noise", "priority": "low"}
+    assert app.post("/api/work_orders", {**body, "dispatch": None}, user="ruth").status == 400
+    assert app.post("/api/work_orders", {**body, "dispatch": "self"}, user="ruth").status == 400
+    r = app.post("/api/work_orders", body, user="ruth")
+    assert r.status == 201 and r.json["dispatch"] is None
+    assert app.patch("/api/work_orders/74", {"dispatch": "self"}, user="sofia").status == 400
+    assert app.patch("/api/work_orders/74", {"dispatch": None}, user="ruth").status == 400
+    assert app.patch("/api/work_orders/74", {"dispatch": "self"}, user="kofi").status == 403  # 403 beats 400
