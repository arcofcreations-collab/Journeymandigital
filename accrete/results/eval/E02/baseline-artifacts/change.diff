+    assert app.post("/api/work_orders/54/assign", {"technician": 10}, user="tomas").status == 409  # ravi: 4
+    assert app.post("/api/work_orders/54/assign", {"technician": 11}, user="tomas").status == 409  # sara: 3
+    assert _order(app, 74)["status"] == "open" and _order(app, 54)["status"] == "open"
+    assert _outbox(app) == []
+    assert app.post("/api/work_orders/74/assign", {"technician": 9}, user="sofia").status == 200  # olga: 2 -> 3
+    assert app.post("/api/work_orders/82/assign", {"technician": 9}, user="sofia").status == 409
