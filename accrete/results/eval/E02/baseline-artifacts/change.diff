+def test_overload_is_kept_until_it_drops_below_the_cap(app):
+    workload = app.get("/api/work_orders?assignee=10&status=assigned", user="sofia").json["items"]
+    workload += app.get("/api/work_orders?assignee=10&status=in_progress", user="sofia").json["items"]
+    assert sorted(o["id"] for o in workload) == [53, 56, 68, 73]
+    app.post("/api/work_orders/73/cancel", {"reason": "x"}, user="tomas")  # 4 -> 3: still at the cap
+    assert app.post("/api/work_orders/54/claim", {}, user="ravi").status == 409
+    app.post("/api/work_orders/68/assign", {"technician": 15}, user="tomas")  # 3 -> 2
+    assert app.post("/api/work_orders/54/claim", {}, user="ravi").status == 200
