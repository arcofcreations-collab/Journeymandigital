+    assert app.post("/api/work_orders/54/claim", {}, user="ravi").status == 409  # already 4
+    assert app.post("/api/work_orders/74/claim", {}, user="olga").status == 200  # 2 -> 3
+    assert app.post("/api/work_orders/82/claim", {}, user="olga").status == 409
