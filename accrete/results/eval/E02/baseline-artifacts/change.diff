--- a/tests/test_maintenance_dispatch.py
+++ b/tests/test_maintenance_dispatch.py
@@ -0,0 +1,217 @@
+"""Technician self-dispatch (claim), the workload cap and the dispatch field.
+
+Workloads in the seed (assigned + in_progress orders per assignee): nils 3 (49, 62, 77),
+olga 2 (75, 79), ravi 4 (53, 56, 68, 73: kept above the cap), sara 3, tess 2, umar 1 (inactive), wade 1.
+Open North orders: 38, 52, 63, 65, 74, 82; open South orders: 54, 60, 71, 76, 78.
+"""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+NOW = "2026-03-02T09:30:00"
+
+
+def _outbox(app):
+    return app.get("/api/_outbox", user="ruth").json["items"]
+
+
+def _order(app, order_id):
+    return app.get(f"/api/work_orders/{order_id}", user="sofia").json
+
+
+def _actions(app, order_id, user):
+    return parse_ui(app.get(f"/ui/work_orders/{order_id}", user=user).text).actions
+
+
+# --- claim ----------------------------------------------------------------------------
+
+def test_claim(app):
+    r = app.post("/api/work_orders/74/claim", {}, user="olga", now=NOW)
+    assert r.status == 200
+    assert (r.json["status"], r.json["assignee"], r.json["dispatch"]) == ("assigned", 9, "self")
+    assert _outbox(app) == [
+        {"id": 1, "channel": "assignment", "payload": {"work_order": 74, "asset": 1, "technician": 9},
+         "created_at": NOW}
+    ]
+
+
+def test_claim_permission(app):
+    for user in ("ruth", "sofia", "tomas", "umar", "ravi", "tess"):  # requester, supervisors, inactive, other sites
+        assert app.post("/api/work_orders/74/claim", {}, user=user).status == 403, user
+    assert app.post("/api/work_orders/2/claim", {}, user="ruth").status == 403  # 403 beats 409
+    assert app.post("/api/work_orders/74/claim", {"x": 1}, user="ruth").status == 403  # 403 beats 400
+    assert app.post("/api/work_orders/999/claim", {}, user="olga").status == 404
+    assert _order(app, 74)["status"] == "open" and _outbox(app) == []
+
+
+def test_claim_uses_current_site_and_active_flag(app):
+    app.patch("/api/staff/9", {"active": False}, user="sofia")
+    assert app.post("/api/work_orders/74/claim", {}, user="olga").status == 403
+    app.patch("/api/staff/9", {"active": True, "site": "South"}, user="sofia")
+    assert app.post("/api/work_orders/74/claim", {}, user="olga").status == 403
+    assert app.post("/api/work_orders/54/claim", {}, user="olga").status == 200
+
+
+def test_claim_only_open_orders(app):
+    for order_id in (75, 79, 4, 3):  # North: assigned, in_progress, completed, cancelled
+        assert app.post(f"/api/work_orders/{order_id}/claim", {}, user="olga").status == 409
+    assert app.post("/api/work_orders/79/claim", {"x": 1}, user="olga").status == 409  # 409 beats 400
+    assert app.post("/api/work_orders/74/claim", {"x": 1}, user="olga").status == 400
+    assert app.post("/api/work_orders/74/claim", [], user="olga").status == 400
+    assert _order(app, 74)["status"] == "open" and _outbox(app) == []
+
+
+def test_claim_workload_cap(app):
