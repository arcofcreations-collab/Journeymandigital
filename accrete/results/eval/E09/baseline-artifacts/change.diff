--- a/tests/test_library_guardians.py
+++ b/tests/test_library_guardians.py
@@ -0,0 +1,195 @@
+"""Household guardians: the guardian field, its validation, and a guardian's rights over dependants.
+
+Seed households: dara (4) guards eli (5) and jo (10); fatima (6) guards gus (7);
+kemal (11) guards lena (12, inactive).
+"""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+NOW = "2026-03-01T10:00:00"
+GUARDIANS = {5: 4, 10: 4, 7: 6, 12: 11}
+
+
+def _loan_ids(app, user, query=""):
+    return [l["id"] for l in app.get(f"/api/loans{query}", user=user).json["items"]]
+
+
+def _loans_of(app, member_ids, query=""):
+    return [l["id"] for l in app.get(f"/api/loans{query}", user="ada").json["items"] if l["member"] in member_ids]
+
+
+# --- data and the field ---------------------------------------------------------------
+
+def test_existing_members_have_their_guardians(app):
+    members = app.get("/api/members", user="ada").json["items"]
+    assert {m["id"]: m["guardian"] for m in members} == {m: GUARDIANS.get(m) for m in range(1, 13)}
+
+
+def test_migration_keeps_other_data(app):
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    counts = [conn.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0] for t in ("members", "books", "loans", "outbox")]
+    conn.close()
+    assert counts == [12, 40, 60, 0]
+
+
+def test_guardian_filter(app):
+    assert [m["id"] for m in app.get("/api/members?guardian=4", user="ada").json["items"]] == [5, 10]
+    assert [m["id"] for m in app.get("/api/members?guardian=null", user="ada").json["items"]] == [1, 2, 3, 4, 6, 8, 9, 11]
+    assert [m["id"] for m in app.get("/api/members?guardian=null", user="dara").json["items"]] == [4]
+
+
+def test_librarian_sets_guardian_on_create_and_patch(app):
+    r = app.post("/api/members", {"username": "kid", "name": "Kid", "role": "member", "guardian": 3}, user="ada")
+    assert r.status == 201 and r.json["guardian"] == 3
+    assert app.patch("/api/members/9", {"guardian": 8}, user="ada").json["guardian"] == 8
+    assert app.patch("/api/members/5", {"guardian": None}, user="ada").json["guardian"] is None
+
+
+def test_only_librarians_set_guardian(app):
+    assert app.patch("/api/members/3", {"guardian": 4}, user="chen").status == 403
+    assert app.patch("/api/members/5", {"guardian": None}, user="eli").status == 403
+    assert app.patch("/api/members/5", {"name": "Eli N.", "guardian": 4}, user="eli").status == 403
+    assert app.patch("/api/members/5", {"name": "Eli N."}, user="eli").status == 200
+
+
+def test_guardian_validation(app):
+    def patch(member_id, guardian):
+        return app.patch(f"/api/members/{member_id}", {"guardian": guardian}, user="ada")
+
+    assert patch(3, 3).status == 400  # self
+    assert patch(3, 999).status == 400  # unknown
+    assert patch(3, "dara").status == 400
+    assert patch(3, True).status == 400
+    assert patch(3, 5).status == 400  # eli has a guardian of their own
+    r = patch(4, 3)  # dara is already a guardian
+    assert r.status == 400 and set(r.json["fields"]) == {"guardian"}
+    assert app.post("/api/members", {"username": "k", "name": "K", "role": "member", "guardian": 7},
+                    user="ada").status == 400
+    assert app.post("/api/members", {"username": "k", "name": "K", "role": "member", "guardian": 99},
+                    user="ada").status == 400
+    assert app.get("/api/members/3", user="ada").json["guardian"] is None
+    assert patch(5, 4).status == 200  # unchanged value is fine
+    assert patch(5, 6).status == 200  # moving a dependant to another guardian
+
+
+def test_deleting_a_guardian_is_409(app):
+    r = app.post("/api/members", {"username": "g", "name": "G", "role": "member"}, user="ada").json
+    kid = app.post("/api/members", {"username": "k", "name": "K", "role": "member", "guardian": r["id"]}, user="ada").json
+    assert app.delete(f"/api/members/{r['id']}", user="ada").status == 409
+    assert app.patch(f"/api/members/{kid['id']}", {"guardian": None}, user="ada").status == 200
+    assert app.delete(f"/api/members/{r['id']}", user="ada").status == 204
+
+
+# --- reading --------------------------------------------------------------------------
+
+def test_guardian_reads_dependants_records(app):
+    assert [m["id"] for m in app.get("/api/members", user="dara").json["items"]] == [4, 5, 10]
+    assert app.get("/api/members/5", user="dara").json["username"] == "eli"
+    assert app.get("/api/members/12", user="kemal").json["active"] is False
+    assert app.get("/api/members/7", user="dara").status == 403
+    # no rights the other way round
+    assert [m["id"] for m in app.get("/api/members", user="eli").json["items"]] == [5]
+    assert app.get("/api/members/4", user="eli").status == 403
+    assert app.get("/api/members/10", user="eli").status == 403  # siblings see nothing of each other
+
+
+def test_guardian_reads_dependants_loans(app):
+    assert _loan_ids(app, "dara") == _loans_of(app, {4, 5, 10})
+    assert _loan_ids(app, "dara", "?member=10&returned_at=null") == [46, 50, 57]
+    assert _loan_ids(app, "dara", "?member=7") == []
+    assert app.get("/api/loans/46", user="dara").status == 200
+    assert app.get("/api/loans/47", user="dara").status == 403  # gus is fatima's
