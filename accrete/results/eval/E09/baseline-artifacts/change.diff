+    assert app.post("/api/loans/46/return", {}, user="dara").status == 409
+    assert app.post("/api/loans/47/return", {}, user="dara").status == 403
+    assert app.post("/api/loans/59/return", {}, user="eli").status == 403  # the guardian's loan
+    assert app.post("/api/books/3/borrow", {"member": 10}, user="dara").status == 200  # jo is below 3 again
