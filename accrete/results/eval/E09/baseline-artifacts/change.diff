+def test_guardian_borrowing_rules(app):
+    assert app.post("/api/books/3/borrow", {"member": 10}, user="dara").status == 409  # jo has 3 open loans
+    assert app.post("/api/books/3/borrow", {"member": 12}, user="kemal").status == 409  # lena is inactive
+    assert app.post("/api/books/4/borrow", {"member": 5}, user="dara").status == 409  # on loan
+    assert app.post("/api/books/3/borrow", {"member": 7}, user="dara").status == 403  # not a dependant
+    assert app.post("/api/books/4/borrow", {"member": 7}, user="dara").status == 403  # 403 before 409
+    assert app.post("/api/books/3/borrow", {"member": "eli"}, user="dara").status == 403
+    assert app.post("/api/books/3/borrow", {"member": 4}, user="eli").status == 403  # no rights over the guardian
+    assert app.post("/api/books/3/borrow", {"member": 10}, user="eli").status == 403
+    assert app.get("/api/_outbox", user="ada").json["items"] == []
+
+
+def test_guardian_returns_dependants_loans(app):
