+-- Household guardians: a member may have another member as guardian, who can then read
+-- the dependant's record and loans, borrow for them and return their loans.
+-- No chains: a guardian has no guardian of their own (enforced by services).
+
+ALTER TABLE members ADD COLUMN guardian_id INTEGER REFERENCES members (id);
+
+CREATE INDEX members_guardian_id ON members (guardian_id);
+
+-- Existing households (all other members keep guardian_id = NULL).
+UPDATE members SET guardian_id = 4  WHERE id IN (5, 10);  -- eli, jo   -> dara
+UPDATE members SET guardian_id = 6  WHERE id = 7;         -- gus       -> fatima
+UPDATE members SET guardian_id = 11 WHERE id = 12;        -- lena      -> kemal
