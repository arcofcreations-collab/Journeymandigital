+      - {as: nils, do: "GET /api/_outbox?channel=work_completed", json: {items: [{payload: {work_order: 49, asset: 6, technician: 8, labor_minutes: 30, parts_cost: 206.75}}]}}
+      - {as: nils, do: "POST /api/work_orders/49/use_parts", body: {items: [{part: 1, quantity: 1}]}, status: 409}
