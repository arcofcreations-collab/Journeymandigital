+      - {as: ravi, do: "GET /api/part_usages", count: 0}
+      - {as: ravi, do: "GET /api/part_usages/1", status: 403}
+      - {as: ruth, do: "GET /api/part_usages", count: 3}
+      - {as: sofia, do: "PATCH /api/part_usages/1", body: {quantity: 5}, status: 403}
+      - {as: sofia, do: "DELETE /api/part_usages/1", status: 403}
