+      - {as: nils, do: "GET /api/work_orders/49", json: {parts_cost: 106.75}}
+      - {as: nils, do: "POST /api/work_orders/49/use_parts", body: {items: [{part: 2, quantity: 1}]}, status: 200, json: {parts_cost: 206.75}}
