+def clean_use_parts_params(data):
+    """Shape-check a ``use_parts`` body: ``{"items": [{"part": id, "quantity": n}, ...]}``.
+
+    Returns ``(items, errors)`` instead of raising, because a stock shortage (409) on any item
+    with a valid part and quantity wins over every 400 in the same request: ``services`` checks
+    stock first and then raises these errors. Each item is ``{"part": id, "quantity": n}`` with
+    ``None`` where that value is invalid. Part existence, site and duplicates need the database
+    and are checked in ``services``.
+    """
+    data = require_object(data)
+    errors = unknown_field_errors(data, ("items",))
+    raw_items = data.get("items")
+    if not isinstance(raw_items, list) or not raw_items:
+        errors["items"] = "must be a non-empty list"
+        raw_items = raw_items if isinstance(raw_items, list) else []
+    items = []
+    for index, raw in enumerate(raw_items):
+        prefix = f"items[{index}]"
+        item = {"part": None, "quantity": None}
+        if not isinstance(raw, dict):
+            errors[prefix] = "must be an object with part and quantity"
+        else:
+            for name, problem in unknown_field_errors(raw, USE_PARTS_ITEM_KEYS).items():
+                errors[f"{prefix}.{name}"] = problem
+            with collect(errors, f"{prefix}.part"):
+                item["part"] = record_id(raw.get("part"))
+            with collect(errors, f"{prefix}.quantity"):
+                item["quantity"] = positive_integer(raw.get("quantity"))
+        items.append(item)
+    return items, errors
