+    assert items == expected
+    assert [p["id"] for p in app.get("/api/parts?low_stock=true", user="nils").json["items"]] == [5, 8]
+    assert [p["id"] for p in app.get("/api/parts?site=South", user="nils").json["items"]] == [4, 5, 6]
+    assert app.get("/api/part_usages", user="sofia").json == {"items": []}
