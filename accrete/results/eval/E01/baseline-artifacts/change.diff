+-- Spare parts inventory and the history of parts used on work orders.
+
+CREATE TABLE parts (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    sku           TEXT    NOT NULL UNIQUE,
+    name          TEXT    NOT NULL,
+    site          TEXT    NOT NULL,
+    unit_cost     REAL    NOT NULL CHECK (unit_cost >= 0),
+    quantity      INTEGER NOT NULL CHECK (quantity >= 0),
+    reorder_level INTEGER NOT NULL CHECK (reorder_level >= 0)
+);
+
+-- One row per part line of a use_parts action; unit_cost is the part's price at that moment.
+CREATE TABLE part_usages (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    work_order_id INTEGER NOT NULL REFERENCES work_orders (id),
+    part_id       INTEGER NOT NULL REFERENCES parts (id),
+    quantity      INTEGER NOT NULL CHECK (quantity >= 1),
+    unit_cost     REAL    NOT NULL CHECK (unit_cost >= 0),
+    used_by_id    INTEGER NOT NULL REFERENCES staff (id),
+    used_at       TEXT    NOT NULL  -- YYYY-MM-DDTHH:MM:SS (UTC)
+);
+
+CREATE INDEX part_usages_work_order_id ON part_usages (work_order_id);
+CREATE INDEX part_usages_part_id ON part_usages (part_id);
+CREATE INDEX part_usages_used_by_id ON part_usages (used_by_id);
+
+-- Starting stock (ids are fixed; new parts continue after 8).
+INSERT INTO parts (id, sku, name, site, unit_cost, quantity, reorder_level) VALUES
+    (1, 'FLT-AHU',    'AHU filter',       'North', 42.5, 12, 4),
+    (2, 'BELT-A40',   'V-belt A40',       'North', 18.0,  3, 2),
+    (3, 'FUSE-10A',   'Fuse 10A',         'North', 1.25, 50, 10),
+    (4, 'BRG-6204',   'Bearing 6204',     'South', 9.8,   6, 2),
+    (5, 'BELT-A40-S', 'V-belt A40',       'South', 18.0,  2, 2),
+    (6, 'SEAL-KIT',   'Pump seal kit',    'South', 64.0,  1, 0),
+    (7, 'LAMP-LED',   'LED lamp',         'East',  7.4,  20, 5),
+    (8, 'REMOTE-DK',  'Dock door remote', 'North', 23.9,  0, 1);
