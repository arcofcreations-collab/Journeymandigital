+    r = app.patch("/api/parts/9", {"quantity": 2, "unit_cost": 4}, user="sofia")
+    assert r.status == 200 and (r.json["quantity"], r.json["unit_cost"], r.json["low_stock"]) == (2, 4, True)
+    assert app.patch("/api/parts/9", {"sku": "GSKT-01"}, user="sofia").status == 200  # own sku is fine
+    assert app.delete("/api/parts/9", user="sofia").status == 204
