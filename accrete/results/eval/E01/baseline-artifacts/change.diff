+def test_completion_and_cancellation_keep_parts(app):
+    _use(app, 80, [{"part": 4, "quantity": 2}, {"part": 6, "quantity": 1}], user="wade")
+    r = app.post("/api/work_orders/80/complete", {"resolution": "Fixed", "labor_minutes": 30}, user="wade", now=NOW)
+    assert r.status == 200 and r.json["parts_cost"] == 83.6  # 2*9.8 + 64
+    completed = [m for m in _outbox(app) if m["channel"] == "work_completed"]
+    assert [m["payload"] for m in completed] == [
+        {"work_order": 80, "asset": 22, "technician": 15, "labor_minutes": 30, "parts_cost": 83.6}
+    ]
+    _use(app, 79, [{"part": 1, "quantity": 1}])
+    assert app.post("/api/work_orders/79/cancel", {"reason": "Dup"}, user="sofia").status == 200
+    assert _part(app, 1)["quantity"] == 11
+    assert app.get("/api/work_orders/79", user="sofia").json["parts_cost"] == 42.5
+    assert len(app.get("/api/part_usages?work_order=79", user="sofia").json["items"]) == 1
