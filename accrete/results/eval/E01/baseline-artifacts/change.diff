+    items = app.get("/api/parts", user="mei").json["items"]
+    expected = [
+        {"id": i, "sku": sku, "name": name, "site": site, "unit_cost": cost, "quantity": qty,
+         "reorder_level": level, "low_stock": qty <= level}
+        for i, sku, name, site, cost, qty, level in SEED_PARTS
