+    return apply_filters(parts, filters or {}, PART_FIELDS)
+
+
+def get_part(ctx, part_id):
+    part = _load_part(part_id)
+    if not permissions.can_read_part(ctx.user, part):
+        raise Forbidden()
+    return part
+
+
+def ensure_can_create_part(ctx):
+    if not permissions.can_manage_parts(ctx.user):
+        raise Forbidden("Only supervisors can create parts.")
+
+
+def create_part(ctx, data):
+    ensure_can_create_part(ctx)
+    with transaction():
+        values = validation.clean_part(data, partial=False)
+        _ensure_sku_free(values["sku"])
+        part_id = repository.insert_part(values)
+    return repository.get_part(part_id)
+
+
+def update_part(ctx, part_id, data):
+    with transaction():
+        _load_part(part_id)
+        if not permissions.can_manage_parts(ctx.user):
+            raise Forbidden("Only supervisors can update parts.")
+        values = validation.clean_part(data, partial=True)
+        if "sku" in values:
+            _ensure_sku_free(values["sku"], exclude_id=part_id)
+        repository.update_part(part_id, values)
+    return repository.get_part(part_id)
+
+
+def delete_part(ctx, part_id):
+    with transaction():
+        _load_part(part_id)
+        if not permissions.can_manage_parts(ctx.user):
+            raise Forbidden("Only supervisors can delete parts.")
+        if repository.part_has_usages(part_id):
+            raise Conflict("A part that has been used on work orders cannot be deleted.")
+        repository.delete_part(part_id)
+
+
+def _load_part(part_id):
+    part = repository.get_part(part_id)
+    if part is None:
+        raise NotFound("No such part.")
+    return part
+
+
+def _ensure_sku_free(sku, exclude_id=None):
+    if repository.sku_taken(sku, exclude_id):
+        raise ValidationError("SKU already in use.", {"sku": "already in use"})
+
+
+# --- part usages (read-only history, written by ``use_parts``) -------------------------
+
+def list_part_usages(ctx, filters=None):
+    assets = {a["id"]: a for a in repository.list_assets()}
+    orders = {o["id"]: o for o in repository.list_work_orders()}
+
+    def readable(usage):
+        order = orders[usage["work_order"]]
+        return permissions.can_read_part_usage(ctx.user, order, assets[order["asset"]])
+
+    usages = [u for u in repository.list_part_usages() if readable(u)]
+    return apply_filters(usages, filters or {}, PART_USAGE_FIELDS)
+
+
+def get_part_usage(ctx, usage_id):
+    usage = _load_part_usage(usage_id)
+    order = repository.get_work_order(usage["work_order"])
+    if not permissions.can_read_part_usage(ctx.user, order, repository.get_asset(order["asset"])):
+        raise Forbidden()
+    return usage
+
+
+def ensure_can_write_part_usages(ctx, usage_id=None):
+    """POST, PATCH and DELETE on part usages: 404 for an unknown usage, else always 403."""
+    if usage_id is not None:
+        _load_part_usage(usage_id)
+    if not permissions.can_write_part_usages(ctx.user):
+        raise Forbidden("Part usages are recorded by the use_parts action and cannot be changed.")
+
+
+def _load_part_usage(usage_id):
+    usage = repository.get_part_usage(usage_id)
+    if usage is None:
+        raise NotFound("No such part usage.")
+    return usage
+
+
