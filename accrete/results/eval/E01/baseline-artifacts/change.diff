+def test_stock_shortage_is_409_and_wins_over_400(app):
+    assert _use(app, 79, [{"part": 2, "quantity": 4}]).status == 409
+    assert _use(app, 79, [{"part": 8, "quantity": 1}]).status == 409  # none in stock
+    assert _use(app, 79, [{"part": 1, "quantity": 1}, {"part": 2, "quantity": 4}]).status == 409
+    assert _use(app, 79, [{"part": "x", "quantity": 1}, {"part": 2, "quantity": 4}]).status == 409
+    assert _use(app, 79, [{"part": 2, "quantity": 4}, {"part": 4, "quantity": 1}]).status == 409
+    # A part at another site is not a valid part, so its shortage is not a conflict.
+    assert _use(app, 79, [{"part": 6, "quantity": 5}]).status == 400
+    assert (_part(app, 1)["quantity"], _part(app, 2)["quantity"]) == (12, 3)
+    assert app.get("/api/part_usages", user="sofia").json["items"] == []
+    assert _outbox(app) == []
+    assert _use(app, 79, [{"part": 2, "quantity": 3}]).status == 200  # exactly the stock
+    assert _part(app, 2)["quantity"] == 0
