+def test_migration_0006_on_a_pre_0006_database(tmp_path):
+    """Apply 0001-0005, add orders dispatched every way in every status, then apply 0006."""
+    sys.path.insert(0, APP_DIR)
+    try:
+        from maintenance_app import db
+    finally:
+        sys.path.remove(APP_DIR)
+    old_migrations = tmp_path / "migrations"
+    old_migrations.mkdir()
+    for name in os.listdir(db.MIGRATIONS_DIR):
+        if name.endswith(".sql") and int(name[:4]) <= 5:
+            shutil.copy(os.path.join(db.MIGRATIONS_DIR, name), old_migrations / name)
+    path = str(tmp_path / "data.db")
+    db.migrate(path, str(old_migrations))
+
+    conn = sqlite3.connect(path)
+    conn.row_factory = sqlite3.Row
+    conn.executescript("""
+        INSERT INTO staff (id, username, name, role, site, active) VALUES
+            (1, 'sup', 'Sup', 'supervisor', 'North', 1), (2, 'tech', 'Tech', 'technician', 'North', 1),
+            (3, 'req', 'Req', 'requester', 'North', 1);
+        INSERT INTO assets (id, tag, name, site, criticality, retired) VALUES (1, 'A-1', 'Pump', 'North', 'low', 0);
+        INSERT INTO work_orders (id, asset_id, title, description, priority, status, requested_by_id, created_at,
+                                 assignee_id, started_at, completed_at, resolution, cancel_reason, dispatch) VALUES
+            (1, 1, 'self assigned', 'd', 'p3', 'assigned', 2, '2026-01-01T08:00:00', 2, NULL, NULL, NULL, NULL, 'self'),
+            (2, 1, 'self started', NULL, 'p4', 'in_progress', 2, '2026-01-02T08:00:00', 2, '2026-01-03T08:00:00', NULL, NULL, NULL, 'self'),
+            (3, 1, 'self done', NULL, 'p3', 'completed', 2, '2026-01-02T08:00:00', 2, '2026-01-03T08:00:00', '2026-01-04T08:00:00', 'ok', NULL, 'self'),
+            (4, 1, 'self cancelled', NULL, 'p4', 'cancelled', 2, '2026-01-02T08:00:00', 2, NULL, NULL, NULL, 'dup', 'self'),
+            (5, 1, 'supervisor assigned', NULL, 'p1', 'assigned', 3, '2026-01-05T08:00:00', 2, NULL, NULL, NULL, NULL, 'supervisor'),
+            (6, 1, 'claimed by another', NULL, 'p4', 'assigned', 3, '2026-01-06T08:00:00', 2, NULL, NULL, NULL, NULL, 'self'),
+            (7, 1, 'never assigned', NULL, 'p2', 'open', 3, '2026-01-07T08:00:00', NULL, NULL, NULL, NULL, NULL, NULL);
+    """)
+    before = {row["id"]: dict(row) for row in conn.execute("SELECT * FROM work_orders ORDER BY id")}
+    conn.close()
+
+    assert db.migrate(path) == ["0006_withdraw_self_dispatch.sql"]
+
+    conn = sqlite3.connect(path)
+    conn.row_factory = sqlite3.Row
+    try:
+        after = {row["id"]: dict(row) for row in conn.execute("SELECT * FROM work_orders ORDER BY id")}
+        assert "dispatch" not in after[1]
+        for order_id, row in before.items():
+            expected = {k: v for k, v in row.items() if k != "dispatch"}
+            if order_id in (1, 6):  # self-dispatched and not started: back to the pool
+                expected.update(status="open", assignee_id=None)
+            assert after[order_id] == expected, order_id
+        assert conn.execute("SELECT COUNT(*) FROM outbox").fetchone()[0] == 0
+        assert conn.execute("SELECT COUNT(*) FROM time_entries").fetchone()[0] == 0
+    finally:
+        conn.close()
