+"""The workload cap for assign (E02) and the withdrawal of technician self-dispatch (E05): no
+`claim` action, no `dispatch` field, and migration 0006, which returned the self-claimed orders
+that were still `assigned` (72 by sara, 75 by olga) to the pool.
+
+Workloads after the migration (assigned + in_progress orders per assignee): nils 3 (49, 62, 77),
+olga 1 (79), ravi 4 (53, 56, 68, 73: kept above the cap), sara 2 (61, 64), tess 2, umar 1 (inactive),
+wade 1 (80). Open North orders: 38, 52, 63, 65, 74, 75, 82; open South orders: 54, 60, 71, 72, 76, 78.
+"""
+import os
+import shutil
+import sqlite3
+import sys
+
+from accept_client import parse_ui
+from test_maintenance_ui import _post_form
+
+APP_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+NOW = "2026-03-02T09:30:00"
+
+
+def _outbox(app):
+    return app.get("/api/_outbox", user="ruth").json["items"]
+
+
+def _order(app, order_id):
+    return app.get(f"/api/work_orders/{order_id}", user="sofia").json
+
