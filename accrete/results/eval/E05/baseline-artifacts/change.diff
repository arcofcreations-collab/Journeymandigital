--- a/maintenance_app/migrations/0006_withdraw_self_dispatch.sql
+++ b/maintenance_app/migrations/0006_withdraw_self_dispatch.sql
@@ -0,0 +1,13 @@
+-- Technician self-dispatch (claim) is withdrawn; the workload cap for assign stays.
+--
+-- Orders a technician claimed for themselves (dispatch = 'self') that are still 'assigned'
+-- (not started) go back to the pool: status 'open', no assignee. Every other column stays as
+-- it is. Self-dispatched orders in any other status (in_progress, completed, cancelled) keep
+-- their assignee and status. No outbox messages, time entries or part usages are created.
+UPDATE work_orders
+   SET status = 'open', assignee_id = NULL
+ WHERE dispatch = 'self' AND status = 'assigned';
+
+-- The dispatch field goes away with the claim action. (Its CHECK constraint belongs to the
+-- column itself, so SQLite can drop it in place.)
+ALTER TABLE work_orders DROP COLUMN dispatch;
