+    assert _assign(app, 60, 11, user="tomas").status == 409
+    assert _assign(app, 74, 9).status == 200  # olga: 1 -> 2
+    assert _assign(app, 82, 9).status == 200  # olga: 2 -> 3
+    assert _assign(app, 38, 9).status == 409
