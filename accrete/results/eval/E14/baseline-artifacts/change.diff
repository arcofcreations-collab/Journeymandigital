@@ -0,0 +1,200 @@
+"""Lost copies: declare_lost on loans, found on copies, and how lost copies affect status and borrowing."""
+import os
+import sqlite3
+
+from accept_client import fresh_app, parse_ui
+
+NOW = "2026-03-01T10:00:00"
+
+
+# --- migrated data --------------------------------------------------------------------
+
+def test_reported_losses_are_migrated(app):
+    loans = app.get("/api/loans", user="ada").json["items"]
+    assert {l["id"]: l["lost_at"] for l in loans if l["lost_at"] is not None} == \
+           {46: "2026-02-28T10:00:00", 50: "2026-02-28T10:00:00"}
+    assert all(l["returned_at"] is None and l["overdue"] is False for l in loans if l["lost_at"])
+    copies = app.get("/api/copies", user="ada").json["items"]
+    assert [c["id"] for c in copies if c["lost"]] == [4, 16]
+    assert app.get("/api/copies/4", user="ada").json["status"] == "lost"
+    assert [c["id"] for c in app.get("/api/copies?status=lost", user="ada").json["items"]] == [4, 16]
+    for book_id in (4, 16):
+        book = app.get(f"/api/books/{book_id}", user="chen").json
+        assert book["status"] == "unavailable" and book["available_copies"] == 0
+    jo_open = [l["id"] for l in app.get("/api/loans", user="jo").json["items"]
+               if l["returned_at"] is None and l["lost_at"] is None]
+    assert jo_open == [57]
+    assert app.get("/api/_outbox", user="ada").json["items"] == []
+
+
+def test_migration_upgrades_a_database_without_lost_fields(app, seed):
+    """Rebuild the E08 database (0001 + 0002 + records without lost fields) and let startup migrate it."""
+    path = os.path.join(app.workdir, "data.db")
+    os.remove(path)
+    migrations = os.path.join(app.workdir, "library_app", "migrations")
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE schema_version (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL)")
+    for version, name in ((1, "initial"), (2, "copies")):
+        with open(os.path.join(migrations, f"{version:04d}_{name}.sql")) as fh:
+            conn.executescript(fh.read())
+        conn.execute("INSERT INTO schema_version VALUES (?, ?, '2026-01-01T00:00:00')", (version, name))
+    conn.executemany("INSERT INTO members VALUES (:id, :username, :name, :role, :active)", seed["members"])
+    conn.executemany("INSERT INTO books VALUES (:id, :title, :author, :isbn, :year)", seed["books"])
+    conn.executemany("INSERT INTO copies VALUES (:id, :book, :barcode)", seed["copies"])
+    conn.executemany("INSERT INTO loans VALUES (:id, :copy, :member, :borrowed_at, :due_at, :returned_at)",
+                     seed["loans"])
+    conn.commit()
+    conn.close()
+
+    upgraded = fresh_app(app.workdir)
+    copies = upgraded.get("/api/copies", user="ada").json["items"]
+    assert [{k: v for k, v in c.items() if k != "status"} for c in copies] == seed["copies"]
+    loans = upgraded.get("/api/loans", user="ada").json["items"]
+    assert [{k: v for k, v in l.items() if k != "overdue"} for l in loans] == seed["loans"]
+    assert upgraded.get("/api/_outbox", user="ada").json["items"] == []
+    # The lost loan of copy 4 no longer blocks lending that copy once it is found.
+    assert upgraded.post("/api/copies/4/found", {}, user="ada").status == 200
+    assert upgraded.post("/api/books/4/borrow", {}, user="chen").status == 200
+    assert upgraded.get("/api/loans/61", user="chen").json["copy"] == 4
+
+
+# --- declare_lost ---------------------------------------------------------------------
+
+def test_librarian_declares_loan_lost(app):
+    r = app.post("/api/loans/52/declare_lost", {}, user="ada", now=NOW)
+    assert r.status == 200
+    assert r.json == {"id": 52, "book": 22, "copy": 22, "member": 3, "borrowed_at": "2026-02-18T16:00:00",
+                      "due_at": "2026-03-04", "returned_at": None, "lost_at": NOW, "overdue": False}
+    assert app.get("/api/copies/22", user="chen").json == \
+           {"id": 22, "book": 22, "barcode": "C0022", "lost": True, "status": "lost"}
+    assert app.get("/api/_outbox", user="chen").json["items"] == [
+        {"id": 1, "channel": "copy_lost", "payload": {"loan": 52, "copy": 22, "book": 22, "member": 3},
+         "created_at": NOW}]
+    book = app.get("/api/books/22", user="chen").json
+    assert book["status"] == "available" and book["available_copies"] == 1  # second copy 42
+
+
+def test_lost_loan_is_closed(app):
+    assert app.post("/api/loans/47/declare_lost", {}, user="ben").status == 200
+    assert app.get("/api/loans/47", user="gus", now="2027-01-01T00:00:00").json["overdue"] is False
+    assert app.post("/api/loans/47/return", {}, user="gus").status == 409
+    assert app.post("/api/loans/47/return", {}, user="ben").status == 409
+    assert app.post("/api/loans/47/declare_lost", {}, user="ben").status == 409
+    assert app.get("/api/loans/47", user="gus").json["returned_at"] is None
+    assert len(app.get("/api/_outbox", user="ada").json["items"]) == 1
+
+
+def test_lost_loans_do_not_count_towards_the_limit(app):
+    assert app.post("/api/books/3/borrow", {}, user="hana").status == 409  # 3 open loans
+    assert app.post("/api/loans/51/declare_lost", {}, user="ada").status == 200
+    assert app.post("/api/books/3/borrow", {}, user="hana").status == 200
+    # jo's two lost loans don't count: one open loan, so two more borrows succeed.
+    assert app.post("/api/books/2/borrow", {}, user="jo").status == 200
+    assert app.post("/api/books/6/borrow", {}, user="jo").status == 200
+    assert app.post("/api/books/12/borrow", {}, user="jo").status == 409
+
+
+def test_declare_lost_refusals_change_nothing(app):
+    assert app.post("/api/loans/52/declare_lost", {}, user="chen").status == 403  # the borrower
+    assert app.post("/api/loans/1/declare_lost", {}, user="dara").status == 403  # 403 beats 409
+    assert app.post("/api/loans/999/declare_lost", {}, user="ada").status == 404
+    assert app.post("/api/loans/1/declare_lost", {}, user="ada").status == 409  # returned
+    assert app.post("/api/loans/46/declare_lost", {}, user="ada").status == 409  # already lost
+    assert app.post("/api/loans/1/declare_lost", {"x": 1}, user="ada").status == 409  # 409 beats 400
+    assert app.post("/api/loans/52/declare_lost", {"lost_at": NOW}, user="ada").status == 400
+    assert app.get("/api/loans/52", user="ada").json["lost_at"] is None
+    assert app.get("/api/copies/22", user="ada").json["lost"] is False
+    assert app.get("/api/_outbox", user="ada").json["items"] == []
+
+
+def test_lost_fields_are_read_only(app):
+    assert app.post("/api/copies", {"book": 3, "barcode": "X", "lost": False}, user="ada").status == 400
+    assert app.patch("/api/copies/3", {"lost": True}, user="ada").status == 400
+    assert app.patch("/api/copies/4", {"lost": False}, user="ada").status == 400
+    assert app.patch("/api/copies/3", {"lost": True}, user="chen").status == 403
+    assert app.patch("/api/loans/52", {"lost_at": NOW}, user="ada").status == 403
+    assert app.get("/api/copies/3", user="ada").json["lost"] is False
+
+
+# --- found ----------------------------------------------------------------------------
+
+def test_found_copy_is_back_in_circulation(app):
+    r = app.post("/api/copies/4/found", {}, user="ada", now=NOW)
+    assert r.status == 200 and r.json == {"id": 4, "book": 4, "barcode": "C0004", "lost": False, "status": "available"}
+    loan = app.get("/api/loans/46", user="ada").json
+    assert loan["lost_at"] == "2026-02-28T10:00:00" and loan["returned_at"] is None and loan["overdue"] is False
+    assert app.post("/api/loans/46/return", {}, user="ada").status == 409  # stays closed
+    book = app.get("/api/books/4", user="chen").json
+    assert book["status"] == "available" and book["available_copies"] == 1
+    assert app.post("/api/books/4/borrow", {}, user="chen").status == 200
+    assert app.get("/api/loans/61", user="chen").json["copy"] == 4
+    assert app.get("/api/copies/4", user="chen").json["status"] == "on_loan"
+    assert app.get("/api/_outbox", user="chen").json["items"][0]["channel"] == "loan_created"
+
+
+def test_found_refusals(app):
+    assert app.post("/api/copies/4/found", {}, user="jo").status == 403
+    assert app.post("/api/copies/3/found", {}, user="chen").status == 403  # 403 beats 409
+    assert app.post("/api/copies/999/found", {}, user="ada").status == 404
+    assert app.post("/api/copies/3/found", {}, user="ada").status == 409  # not lost
+    assert app.post("/api/copies/1/found", {}, user="ada").status == 409  # on loan, not lost
+    assert app.post("/api/copies/4/found", {"lost": False}, user="ada").status == 400
+    assert app.get("/api/copies/4", user="ada").json["lost"] is True
+
+
+# --- books and copies -----------------------------------------------------------------
+
+def test_book_status_ignores_lost_copies(app):
+    assert app.post("/api/loans/55/declare_lost", {}, user="ada").status == 200  # copy 1; copy 41 free
+    book = app.get("/api/books/1", user="chen").json
+    assert book["status"] == "available" and book["available_copies"] == 1
+    assert app.post("/api/books/1/borrow", {}, user="chen").status == 200
+    assert app.get("/api/loans/61", user="chen").json["copy"] == 41  # lost copy 1 is never lent
+    assert app.get("/api/books/1", user="chen").json["status"] == "on_loan"
+    assert app.post("/api/loans/61/declare_lost", {}, user="ada").status == 200
+    assert app.get("/api/books/1", user="chen").json["status"] == "unavailable"
+    assert app.post("/api/books/1/borrow", {}, user="dara").status == 409
+
+
+def test_book_with_a_lost_and_a_lent_copy_is_on_loan(app):
+    copy = app.post("/api/copies", {"book": 4, "barcode": "C0004-2"}, user="ada").json
+    assert app.get("/api/books/4", user="chen").json["status"] == "available"
+    assert app.post("/api/books/4/borrow", {}, user="chen").status == 200
+    assert app.get("/api/loans/61", user="chen").json["copy"] == copy["id"]
+    book = app.get("/api/books/4", user="chen").json
+    assert book["status"] == "on_loan" and book["available_copies"] == 0
+
+
+def test_lost_copies_with_loans_cannot_be_deleted(app):
+    assert app.delete("/api/copies/4", user="ada").status == 409
+    assert app.delete("/api/books/4", user="ada").status == 409
+
+
+# --- UI -------------------------------------------------------------------------------
+
+def test_loan_pages_offer_declare_lost(app):
+    page = parse_ui(app.get("/ui/loans/52", user="ada").text)
+    assert page.actions == ["return", "declare_lost"] and page.fields["lost_at"] == ""
+    assert parse_ui(app.get("/ui/loans/52", user="chen").text).actions == ["return"]
+    lost = parse_ui(app.get("/ui/loans/46", user="ada").text)
+    assert lost.actions == [] and lost.fields["lost_at"] == "2026-02-28T10:00:00"
+    assert parse_ui(app.get("/ui/loans/46", user="jo").text).actions == []
+    assert parse_ui(app.get("/ui/loans/1", user="ada").text).actions == []  # returned
+
+
+def test_copy_pages_offer_found(app):
+    page = parse_ui(app.get("/ui/copies/4", user="ada").text)
+    assert page.fields["lost"] == "true" and page.fields["status"] == "lost" and page.actions == ["found"]
+    assert parse_ui(app.get("/ui/copies/4", user="chen").text).actions == []
+    assert parse_ui(app.get("/ui/copies/3", user="ada").text).actions == []
+
+
+def test_ui_forms_declare_lost_and_found(app):
+    r = app.request("POST", "/ui/loans/52/declare_lost", None, user="ada")
+    assert r.status == 303 and r.headers["Location"].endswith("/ui/loans/52")
+    assert app.get("/api/copies/22", user="ada").json["lost"] is True
+    r = app.request("POST", "/ui/copies/22/found", None, user="ada")
+    assert r.status == 303 and r.headers["Location"].endswith("/ui/copies/22")
+    assert app.get("/api/copies/22", user="ada").json["lost"] is False
+    assert app.request("POST", "/ui/copies/22/found", None, user="ada").status == 409
+    assert app.request("POST", "/ui/loans/53/declare_lost", None, user="hana").status == 403
