--- a/library_app/migrations/0003_lost_copies.sql
+++ b/library_app/migrations/0003_lost_copies.sql
@@ -0,0 +1,15 @@
+-- Lost copies: a loan can be closed by declaring its copy lost (loans.lost_at), which takes
+-- the copy out of circulation (copies.lost) until it is found again.
+
+ALTER TABLE loans ADD COLUMN lost_at TEXT;  -- YYYY-MM-DDTHH:MM:SS (UTC) or NULL
+ALTER TABLE copies ADD COLUMN lost INTEGER NOT NULL DEFAULT 0 CHECK (lost IN (0, 1));
+
+-- A loan is open while it is neither returned nor lost; a found copy can be lent again
+-- even though its lost loan keeps returned_at NULL.
+DROP INDEX loans_one_open_loan_per_copy;
+CREATE UNIQUE INDEX loans_one_open_loan_per_copy ON loans (copy_id)
+    WHERE returned_at IS NULL AND lost_at IS NULL;
+
+-- Loans 46 (copy 4) and 50 (copy 16) were reported lost. No outbox messages for this.
+UPDATE loans SET lost_at = '2026-02-28T10:00:00' WHERE id IN (46, 50);
+UPDATE copies SET lost = 1 WHERE id IN (4, 16);
