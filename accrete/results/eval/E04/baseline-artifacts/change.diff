--- a/maintenance_app/migrations/0005_time_entries.sql
+++ b/maintenance_app/migrations/0005_time_entries.sql
@@ -0,0 +1,28 @@
+-- Time logging: technicians log their working time on an order while it is in progress, and
+-- work_orders.labor_minutes becomes derived (the sum of the order's time entries, NULL without any).
+--
+-- Every existing order with a labor_minutes value gets exactly one entry carrying it (logged by
+-- its assignee at its completion time, note 'migrated'); ids 1, 2, 3, ... follow the work order
+-- ids, so the derived total equals the former stored value. Entries of inactive technicians are
+-- migrated like any other. The stored column is then dropped.
+
+CREATE TABLE time_entries (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    work_order_id INTEGER NOT NULL REFERENCES work_orders (id),
+    technician_id INTEGER NOT NULL REFERENCES staff (id),
+    minutes       INTEGER NOT NULL CHECK (minutes >= 1),
+    logged_at     TEXT    NOT NULL,  -- YYYY-MM-DDTHH:MM:SS (UTC)
+    note          TEXT
+);
+
+CREATE INDEX time_entries_work_order_id ON time_entries (work_order_id);
+CREATE INDEX time_entries_technician_id ON time_entries (technician_id);
+
+INSERT INTO time_entries (id, work_order_id, technician_id, minutes, logged_at, note)
+SELECT ROW_NUMBER() OVER (ORDER BY id), id, assignee_id, labor_minutes, completed_at, 'migrated'
+  FROM work_orders
+ WHERE labor_minutes IS NOT NULL
+ ORDER BY id;
+
+-- (Its CHECK constraint belongs to the column itself, so SQLite can drop it in place.)
+ALTER TABLE work_orders DROP COLUMN labor_minutes;
