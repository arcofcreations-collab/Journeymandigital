--- a/tests/test_maintenance_time_entries.py
+++ b/tests/test_maintenance_time_entries.py
@@ -0,0 +1,244 @@
+"""Time logging: the log_time action, read-only time entries, the derived labor_minutes, the
+time-entry requirement of complete and the migration of the former stored labor figures.
+
+Order 79: in progress, asset 13 (North), requested by sofia, assignee olga (9).
+Order 80: in progress, asset 22 (South), requested by lina, assignee wade (15).
+Order 77: assigned (not started), assignee nils (8). The seed has 39 orders with labor_minutes,
+so migration 0005 created time entries 1-39.
+"""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+NOW = "2026-03-02T09:30:00"
+MIGRATED = 39
+
+
+def _log(app, order_id, body, user="olga", now=NOW):
+    return app.post(f"/api/work_orders/{order_id}/log_time", body, user=user, now=now)
+
+
+def _order(app, order_id):
+    return app.get(f"/api/work_orders/{order_id}", user="sofia").json
+
+
+def _entries(app, query="", user="sofia"):
+    return app.get(f"/api/time_entries{query}", user=user).json["items"]
+
+
+def _outbox(app):
+    return app.get("/api/_outbox", user="ruth").json["items"]
+
+
+# --- log_time -------------------------------------------------------------------------
+
+def test_log_time(app):
+    assert _order(app, 79)["labor_minutes"] is None
+    r = _log(app, 79, {"minutes": 45})
+    assert r.status == 200 and r.json["id"] == 79
+    assert (r.json["status"], r.json["labor_minutes"]) == ("in_progress", 45)
+    r = _log(app, 79, {"minutes": 20, "note": "Waited for parts"}, now="2026-03-02T11:00:00")
+    assert r.json["labor_minutes"] == 65
+    assert _entries(app, "?work_order=79") == [
+        {"id": MIGRATED + 1, "work_order": 79, "technician": 9, "minutes": 45, "logged_at": NOW, "note": None},
+        {"id": MIGRATED + 2, "work_order": 79, "technician": 9, "minutes": 20, "logged_at": "2026-03-02T11:00:00",
+         "note": "Waited for parts"},
+    ]
+    assert _log(app, 79, {"minutes": 1, "note": None}).status == 200
+    assert _log(app, 79, {"minutes": 600, "note": ""}).status == 200  # bounds are inclusive
+    assert _order(app, 79)["labor_minutes"] == 666
+    assert _outbox(app) == []  # no message
+    assert [o["id"] for o in app.get("/api/work_orders?labor_minutes=666", user="sofia").json["items"]] == [79]
+
+
+def test_log_time_permission_and_state(app):
+    body = {"minutes": 10}
+    for user in ("nils", "sofia", "ruth"):  # site technician, supervisor (and requester), requester
+        assert _log(app, 79, body, user=user).status == 403, user
+    assert _log(app, 79, {"minutes": 0, "x": 1}, user="nils").status == 403  # 403 beats 400
+    assert _log(app, 77, body, user="olga").status == 403  # not the assignee, even though not in progress
+    assert _log(app, 74, body, user="nils").status == 403  # unassigned
+    assert _log(app, 77, body, user="nils").status == 409  # assigned, not started
+    assert _log(app, 77, {"minutes": "x"}, user="nils").status == 409  # 409 beats 400
+    assert _log(app, 2, body, user="tess").status == 409  # completed
+    assert app.post("/api/work_orders/79/cancel", {"reason": "Dup"}, user="sofia").status == 200
+    assert _log(app, 79, body).status == 409  # cancelled
+    assert _log(app, 999, body).status == 404
+    assert _entries(app) == _entries(app, "?note=migrated")  # nothing logged
+    assert _outbox(app) == []
+
+
+def test_log_time_validation(app):
+    bad_bodies = [
+        {}, {"note": "x"}, {"minutes": None}, {"minutes": 10, "extra": 1}, {"minutes": 10, "technician": 9},
+        {"minutes": 10, "note": 3}, {"minutes": 10, "note": ["x"]}, {"minutes": 10, "note": True},
+    ] + [{"minutes": m} for m in (0, -1, 601, 1000, 1.5, 2.0, "30", True, False)]
+    for body in bad_bodies:
+        assert _log(app, 79, body).status == 400, body
+    for body in ([10], "10", 10):
+        assert _log(app, 79, body).status == 400, body
+    assert _order(app, 79)["labor_minutes"] is None
+    assert len(_entries(app)) == MIGRATED
+
+
+def test_labor_minutes_cannot_be_sent(app):
+    body = {"asset": 1, "title": "x", "priority": "p3"}
+    assert app.post("/api/work_orders", {**body, "labor_minutes": 5}, user="ruth").status == 400
+    assert app.post("/api/work_orders", {**body, "labor_minutes": None}, user="ruth").status == 400
+    assert app.patch("/api/work_orders/74", {"labor_minutes": 5}, user="sofia").status == 400
+    assert app.patch("/api/work_orders/74", {"labor_minutes": 5}, user="kofi").status == 403  # 403 beats 400
+
+
+# --- complete -------------------------------------------------------------------------
+
+def test_complete_needs_a_time_entry(app):
+    assert app.post("/api/work_orders/79/complete", {"resolution": "Done"}, user="olga").status == 409
+    assert app.post("/api/work_orders/79/complete", {}, user="olga").status == 409  # 409 beats 400
+    assert app.post("/api/work_orders/79/complete", {"resolution": "Done"}, user="nils").status == 403  # 403 first
+    _log(app, 79, {"minutes": 50})
+    assert app.post("/api/work_orders/79/complete", {"resolution": "Done", "labor_minutes": 50},
+                    user="olga").status == 400
+    assert app.post("/api/work_orders/79/complete", {"resolution": "Done"}, user="nils").status == 403
+    r = app.post("/api/work_orders/79/complete", {"resolution": "Done"}, user="olga", now=NOW)
+    assert r.status == 200 and (r.json["status"], r.json["labor_minutes"]) == ("completed", 50)
+    assert [m["payload"] for m in _outbox(app)] == [
+        {"work_order": 79, "asset": 13, "technician": 9, "labor_minutes": 50, "parts_cost": 0}
+    ]
+    assert _log(app, 79, {"minutes": 5}).status == 409  # no more logging once completed
+    assert _order(app, 79)["labor_minutes"] == 50
+
+
+def test_work_completed_carries_the_total_with_parts(app):
+    app.post("/api/work_orders/80/use_parts", {"items": [{"part": 4, "quantity": 1}]}, user="wade")
+    _log(app, 80, {"minutes": 25}, user="wade")
+    _log(app, 80, {"minutes": 35, "note": "second visit"}, user="wade")
+    app.post("/api/work_orders/80/complete", {"resolution": "Fixed"}, user="wade")
+    assert _outbox(app)[-1]["payload"] == {"work_order": 80, "asset": 22, "technician": 15, "labor_minutes": 60,
+                                           "parts_cost": 9.8}
+
+
+def test_cancelling_keeps_time_entries(app):
+    _log(app, 79, {"minutes": 40})
+    assert app.post("/api/work_orders/79/cancel", {"reason": "Dup"}, user="sofia").status == 200
+    order = _order(app, 79)
+    assert (order["status"], order["labor_minutes"]) == ("cancelled", 40)
+    assert [e["minutes"] for e in _entries(app, "?work_order=79")] == [40]
+
+
+def test_entries_stay_with_the_technician_who_logged_them(app):
+    # Only the assignee logs, and an in-progress order cannot be re-assigned, so the technician of
+    # every entry is the order's assignee; deleting them stays a 409.
+    _log(app, 80, {"minutes": 15}, user="wade")
+    assert _entries(app, "?technician=15&note=null")[0]["work_order"] == 80
+    assert app.delete("/api/staff/15", user="sofia").status == 409
+
+
+# --- time entries (read-only) ---------------------------------------------------------
+
+def test_time_entries_follow_work_order_read_rules(app):
+    _log(app, 79, {"minutes": 10})  # North order requested by sofia: entry 40
+    _log(app, 80, {"minutes": 20}, user="wade")  # South order requested by lina: entry 41
+    new = [MIGRATED + 1, MIGRATED + 2]
+    assert [e["id"] for e in _entries(app, user="tomas")][-2:] == new  # supervisors read everything
+    assert len(_entries(app, user="tomas")) == MIGRATED + 2
+    assert [e["id"] for e in _entries(app, "?note=null", user="nils")] == [MIGRATED + 1]
+    assert [e["id"] for e in _entries(app, "?note=null", user="lina")] == [MIGRATED + 2]
+    assert _entries(app, "?note=null", user="ruth") == []
+    readable = {o["id"] for o in app.get("/api/work_orders", user="nils").json["items"]}
+    assert all(e["work_order"] in readable for e in _entries(app, user="nils"))
+    assert app.get(f"/api/time_entries/{MIGRATED + 1}", user="ruth").status == 403
+    assert app.get(f"/api/time_entries/{MIGRATED + 2}", user="nils").status == 403
+    assert app.get(f"/api/time_entries/{MIGRATED + 2}", user="lina").json["minutes"] == 20
+    assert app.get("/api/time_entries/999", user="lina").status == 404
+    assert app.get("/api/time_entries?colour=red", user="sofia").status == 400
+
+
+def test_time_entries_are_read_only(app):
+    body = {"work_order": 79, "technician": 9, "minutes": 10}
+    for user in ("sofia", "olga", "ruth"):
+        assert app.post("/api/time_entries", body, user=user).status == 403
+        assert app.post("/api/time_entries", {}, user=user).status == 403
+        assert app.patch("/api/time_entries/1", {"minutes": 5}, user=user).status == 403
+        assert app.delete("/api/time_entries/1", user=user).status == 403
+    assert app.patch("/api/time_entries/999", {}, user="sofia").status == 404
+    assert app.delete("/api/time_entries/999", user="sofia").status == 404
+    assert app.get("/api/time_entries/1", user="sofia").json["minutes"] == 315
+
+
+# --- UI -------------------------------------------------------------------------------
+
+def test_time_entries_ui(app):
+    _log(app, 79, {"minutes": 10, "note": "Diagnosis"})
+    new_id = MIGRATED + 1
+    assert parse_ui(app.get("/ui/time_entries", user="sofia").text).rows == list(range(1, new_id + 1))
+    nils_rows = parse_ui(app.get("/ui/time_entries", user="nils").text).rows
+    assert nils_rows == [e["id"] for e in _entries(app, user="nils")] and new_id in nils_rows
+    assert new_id not in parse_ui(app.get("/ui/time_entries", user="ruth").text).rows
+    assert parse_ui(app.get(f"/ui/time_entries/{new_id}", user="nils").text).fields == {
+        "work_order": "79", "technician": "9", "minutes": "10", "logged_at": NOW, "note": "Diagnosis"}
+    assert app.get(f"/ui/time_entries/{new_id}", user="ruth").status == 403
+    assert app.get("/ui/time_entries/999", user="ruth").status == 404
+    assert parse_ui(app.get("/ui/work_orders/79", user="olga").text).fields["labor_minutes"] == "10"
+
+
+def test_log_time_and_complete_forms(app):
+    def actions(order_id, user):
+        return parse_ui(app.get(f"/ui/work_orders/{order_id}", user=user).text).actions
+
+    assert actions(79, "olga") == ["log_time", "use_parts"]  # no time yet: complete not allowed
+    for user in ("nils", "sofia"):
+        assert "log_time" not in actions(79, user)
+    assert "log_time" not in actions(77, "nils")  # assigned, not started
+    page = parse_ui(app.get("/ui/work_orders/79", user="olga").text)
+    assert {"minutes", "note"} <= set(page.inputs)
+    _log(app, 79, {"minutes": 10})
+    assert actions(79, "olga") == ["complete", "log_time", "use_parts"]
+    page = parse_ui(app.get("/ui/work_orders/79", user="olga").text)
+    assert "labor_minutes" not in page.inputs and "resolution" in page.inputs
+    app.post("/api/work_orders/79/complete", {"resolution": "Done"}, user="olga")
+    assert actions(79, "olga") == []
+
