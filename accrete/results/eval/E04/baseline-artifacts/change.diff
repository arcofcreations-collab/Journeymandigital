+def test_migrated_database(app):
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    try:
+        columns = [row[1] for row in conn.execute("PRAGMA table_info(work_orders)")]
+        assert "labor_minutes" not in columns  # derived now, not stored
+        assert conn.execute("SELECT seq FROM sqlite_sequence WHERE name = 'time_entries'").fetchone()[0] == MIGRATED
+        assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+        assert conn.execute("SELECT COUNT(*) FROM outbox").fetchone()[0] == 0
+    finally:
+        conn.close()
+    assert _log(app, 79, {"minutes": 5}).status == 200
+    assert _entries(app, "?work_order=79")[0]["id"] == MIGRATED + 1
