+def test_existing_labor_is_migrated_to_time_entries(app, seed):
+    with_labor = [o for o in seed["work_orders"] if o["labor_minutes"] is not None]
+    assert len(with_labor) == MIGRATED
+    expected = [
+        {"id": i, "work_order": o["id"], "technician": o["assignee"], "minutes": o["labor_minutes"],
+         "logged_at": o["completed_at"], "note": "migrated"}
+        for i, o in enumerate(with_labor, start=1)
+    ]
+    assert _entries(app) == expected
+    assert any(e["technician"] == 13 for e in expected)  # umar is inactive: migrated all the same
+    orders = {o["id"]: o for o in app.get("/api/work_orders", user="sofia").json["items"]}
+    for order in seed["work_orders"]:
+        assert orders[order["id"]]["labor_minutes"] == order["labor_minutes"], order["id"]
