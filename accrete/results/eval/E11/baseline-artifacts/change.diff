+-- Cost centres with budgets; every claim is charged to one.
+
+CREATE TABLE cost_centres (
+    id         INTEGER PRIMARY KEY AUTOINCREMENT,
+    code       TEXT    NOT NULL UNIQUE,
+    name       TEXT    NOT NULL,
+    department TEXT    UNIQUE,  -- optional; unique among non-null values
+    budget     REAL    NOT NULL CHECK (budget >= 0)
+);
+
+INSERT INTO cost_centres (id, code, name, department, budget) VALUES
+    (1, 'ENG', 'Engineering', 'Engineering', 31000.00),
+    (2, 'SAL', 'Sales',       'Sales',       12000.00),
+    (3, 'FIN', 'Finance',     'Finance',      2000.00),
+    (4, 'TRV', 'Travel pool', NULL,           5000.00);
+
+-- claims.cost_centre_id is NOT NULL, which ALTER TABLE ADD COLUMN cannot add to a table
+-- with rows: rebuild the table (create-copy-drop-rename).
+CREATE TABLE claims_new (
+    id               INTEGER PRIMARY KEY AUTOINCREMENT,
+    employee_id      INTEGER NOT NULL REFERENCES employees (id),
+    amount           REAL    NOT NULL CHECK (amount > 0 AND amount <= 5000),
+    category         TEXT    NOT NULL CHECK (category IN ('travel', 'meals', 'equipment', 'other')),
+    description      TEXT    NOT NULL,
+    status           TEXT    NOT NULL DEFAULT 'draft'
+                             CHECK (status IN ('draft', 'submitted', 'approved', 'rejected', 'paid')),
+    submitted_at     TEXT,   -- YYYY-MM-DDTHH:MM:SS (UTC)
+    decided_at       TEXT,   -- YYYY-MM-DDTHH:MM:SS (UTC)
+    decided_by_id    INTEGER REFERENCES employees (id),
+    rejection_reason TEXT,
+    cost_centre_id   INTEGER NOT NULL REFERENCES cost_centres (id)
+);
+
+-- Existing claims go to the cost centre of their employee's current department
+-- (Sales -> 2, Engineering -> 1); a department without a cost centre falls back to 1.
+INSERT INTO claims_new (id, employee_id, amount, category, description, status,
+                        submitted_at, decided_at, decided_by_id, rejection_reason, cost_centre_id)
+SELECT c.id, c.employee_id, c.amount, c.category, c.description, c.status,
+       c.submitted_at, c.decided_at, c.decided_by_id, c.rejection_reason,
+       COALESCE((SELECT cc.id FROM cost_centres cc JOIN employees e ON e.department = cc.department
+                 WHERE e.id = c.employee_id), 1)
+FROM claims c;
+
+-- Keep the AUTOINCREMENT high-water mark so ids of deleted claims are never reused.
+DELETE FROM sqlite_sequence WHERE name = 'claims_new';
+INSERT INTO sqlite_sequence (name, seq)
+SELECT 'claims_new', max(COALESCE((SELECT max(id) FROM claims_new), 0),
+                         COALESCE((SELECT seq FROM sqlite_sequence WHERE name = 'claims'), 0));
+
+DROP TABLE claims;
+ALTER TABLE claims_new RENAME TO claims;
+
+CREATE INDEX claims_employee_id ON claims (employee_id);
+CREATE INDEX claims_decided_by_id ON claims (decided_by_id);
+CREATE INDEX claims_cost_centre_id ON claims (cost_centre_id);
