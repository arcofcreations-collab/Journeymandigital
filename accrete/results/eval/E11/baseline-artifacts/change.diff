+def get_cost_centre(ctx, cost_centre_id):
+    cost_centre = _load_cost_centre(cost_centre_id)
+    if not permissions.can_read_cost_centre(ctx.user, cost_centre):
+        raise Forbidden()
+    return cost_centre
