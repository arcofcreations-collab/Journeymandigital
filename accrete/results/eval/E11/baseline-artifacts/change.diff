@@ -0,0 +1,16 @@
+"""Money arithmetic: amounts are stored as floats, compared and rounded to the cent."""
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+
+
+def cents(value):
+    """``value`` (int, float or Decimal) as a Decimal rounded to the cent."""
+    if not isinstance(value, Decimal):
+        value = Decimal(repr(value))
+    return value.quantize(CENT, rounding=ROUND_HALF_UP)
+
+
+def round_money(value):
+    """``value`` rounded to the cent, as a JSON-friendly float."""
+    return float(cents(value))
