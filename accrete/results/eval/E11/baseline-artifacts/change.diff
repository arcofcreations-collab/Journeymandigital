+"""Cost centres: the collection, claims charged to them, the approval budget rule, the UI."""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+SALES = {"id": 2, "code": "SAL", "name": "Sales", "department": "Sales", "budget": 12000.0,
+         "committed": 10750.94, "remaining": 1249.06}
+NEW = {"code": "OPS", "name": "Operations", "department": "Ops", "budget": 1500}
+
+
+# --- the collection and its starting data ----------------------------------------------
+
+def test_starting_cost_centres_are_readable_by_everyone(app):
+    items = app.get("/api/cost_centres", user="priya").json["items"]
+    assert [(c["id"], c["code"], c["name"], c["department"], c["budget"]) for c in items] == [
+        (1, "ENG", "Engineering", "Engineering", 31000.0), (2, "SAL", "Sales", "Sales", 12000.0),
+        (3, "FIN", "Finance", "Finance", 2000.0), (4, "TRV", "Travel pool", None, 5000.0)]
+    assert [(c["committed"], c["remaining"]) for c in items] == [
+        (28886.18, 2113.82), (10750.94, 1249.06), (0.0, 2000.0), (0.0, 5000.0)]
+    assert app.get("/api/cost_centres/2", user="rosa").json == SALES
+    assert app.get("/api/cost_centres/99", user="rosa").status == 404
+    assert [c["id"] for c in app.get("/api/cost_centres?department=null", user="sam").json["items"]] == [4]
+
+
+def test_existing_claims_are_charged_to_their_employees_department(app):
+    employees = {e["id"]: e for e in app.get("/api/employees", user="fiona").json["items"]}
+    for claim in app.get("/api/claims", user="fiona").json["items"]:
+        expected = 2 if employees[claim["employee"]]["department"] == "Sales" else 1
+        assert claim["cost_centre"] == expected, claim["id"]
+
+
+def test_claims_reference_cost_centres_in_the_database(app):
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    assert conn.execute("SELECT COUNT(*) FROM claims WHERE cost_centre_id IS NULL").fetchone() == (0,)
+    assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+    conn.close()
+
+
+def test_only_finance_manages_cost_centres(app):
+    assert app.post("/api/cost_centres", NEW, user="marco").status == 403
+    assert app.post("/api/cost_centres", {"budget": -1}, user="marco").status == 403  # 403 beats 400
+    assert app.patch("/api/cost_centres/4", {"name": "x"}, user="marco").status == 403
+    assert app.patch("/api/cost_centres/4", {"budget": "x"}, user="priya").status == 403
+    assert app.delete("/api/cost_centres/4", user="priya").status == 403
+    assert app.patch("/api/cost_centres/99", {"name": "x"}, user="priya").status == 404
+    r = app.post("/api/cost_centres", NEW, user="fiona")
+    assert r.status == 201
+    assert r.json == {"id": 5, **NEW, "committed": 0.0, "remaining": 1500.0}
+    r = app.patch("/api/cost_centres/5", {"name": "Ops", "department": None, "budget": 99.5}, user="fiona")
+    assert r.status == 200 and (r.json["name"], r.json["department"], r.json["remaining"]) == ("Ops", None, 99.5)
+    assert app.delete("/api/cost_centres/5", user="fiona").status == 204
+    assert app.get("/api/cost_centres/5", user="fiona").status == 404
+
+
+def test_cost_centre_validation(app):
+    def create(**changes):
+        return app.post("/api/cost_centres", dict(NEW, **changes), user="fiona")
+
+    r = app.post("/api/cost_centres", {}, user="fiona")
+    assert r.status == 400 and set(r.json["fields"]) == {"code", "name", "budget"}
+    for field, value in (("budget", -0.01), ("budget", "10"), ("budget", True), ("budget", None),
+                         ("code", "  "), ("name", None), ("department", ""), ("department", 3),
+                         ("committed", 0), ("remaining", 0), ("id", 9), ("colour", "red")):
+        r = create(**{field: value})
+        assert r.status == 400 and field in r.json["fields"], (field, value)
+    assert create(code="ENG").status == 400  # duplicate code
+    assert create(department="Sales").status == 400  # duplicate department
+    assert app.post("/api/cost_centres", {"code": "X", "name": "X", "budget": 0}, user="fiona").status == 201
+    assert create(department=None).status == 201  # several cost centres without a department
+    assert app.patch("/api/cost_centres/4", {"code": "SAL"}, user="fiona").status == 400
+    assert app.patch("/api/cost_centres/4", {"department": "Finance"}, user="fiona").status == 400
+    assert app.patch("/api/cost_centres/2", {"code": "SAL", "department": "Sales"}, user="fiona").status == 200
+    assert app.patch("/api/cost_centres/4", {"committed": 1}, user="fiona").status == 400
+
+
+def test_budget_cannot_drop_below_committed(app):
+    assert app.patch("/api/cost_centres/2", {"budget": 10750.93}, user="fiona").status == 409
+    assert app.patch("/api/cost_centres/2", {"budget": 0, "code": ""}, user="fiona").status == 409  # 409 beats 400
+    assert app.patch("/api/cost_centres/2", {"budget": -5}, user="fiona").status == 400
+    r = app.patch("/api/cost_centres/2", {"budget": 10750.94}, user="fiona")
+    assert r.status == 200 and r.json["remaining"] == 0.0
+    assert app.patch("/api/cost_centres/3", {"budget": 0}, user="fiona").status == 200
+
+
+def test_cost_centre_with_claims_cannot_be_deleted(app):
+    assert app.delete("/api/cost_centres/1", user="fiona").status == 409
+    claim = app.post("/api/claims", {"amount": 5, "category": "travel", "description": "Bus", "cost_centre": 4},
+                     user="sam").json
+    assert app.delete("/api/cost_centres/4", user="fiona").status == 409  # even a draft claim counts
+    assert app.delete(f"/api/claims/{claim['id']}", user="sam").status == 204
+    assert app.delete("/api/cost_centres/4", user="fiona").status == 204
+
+
+# --- claims charged to cost centres ----------------------------------------------------
+
+def test_claim_cost_centre_on_create(app):
+    new = {"amount": 10, "category": "travel", "description": "Bus"}
+    assert app.post("/api/claims", dict(new, cost_centre=4), user="rosa").json["cost_centre"] == 4
+    for value in (None, 99, "2", True, 1.5):
+        r = app.post("/api/claims", dict(new, cost_centre=value), user="rosa")
+        assert r.status == 400 and "cost_centre" in r.json["fields"], value
+    # An employee whose department has no cost centre must name one.
+    assert app.post("/api/employees", {"username": "ann", "name": "Ann", "role": "employee", "manager": 2,
+                                       "department": "Ops"}, user="fiona").status == 201
+    r = app.post("/api/claims", new, user="ann")
+    assert r.status == 400 and "cost_centre" in r.json["fields"]
+    assert app.post("/api/claims", dict(new, cost_centre=4), user="ann").status == 201
+
+
+def test_claim_cost_centre_on_patch(app):
+    r = app.patch("/api/claims/1", {"cost_centre": 4}, user="wen")
+    assert r.status == 200 and r.json["cost_centre"] == 4
+    assert app.patch("/api/claims/1", {"cost_centre": 2}, user="marco").status == 403
+    assert app.patch("/api/claims/1", {"cost_centre": None}, user="wen").status == 400
+    assert app.patch("/api/claims/1", {"cost_centre": 99}, user="wen").status == 400
+    assert app.patch("/api/claims/2", {"cost_centre": 4}, user="victor").status == 409
+    assert app.patch("/api/claims/2", {"cost_centre": 99}, user="victor").status == 409  # 409 beats 400
+    assert [c["id"] for c in app.get("/api/claims?cost_centre=4", user="wen").json["items"]] == [1]
+
+
+# --- the approval budget rule ----------------------------------------------------------
+
+def test_approve_within_budget_updates_committed(app):
+    assert app.post("/api/claims/58/approve", {}, user="nadia").status == 200  # 1118.43 of 1249.06 left
+    sales = app.get("/api/cost_centres/2", user="nadia").json
+    assert (sales["committed"], sales["remaining"]) == (11869.37, 130.63)
+
+
+def test_approve_beyond_budget_is_409_and_changes_nothing(app):
+    before = app.get("/api/claims/72", user="nadia").json
+    assert app.post("/api/claims/72/approve", {}, user="nadia").status == 409  # 1646.02 > 1249.06
+    assert app.post("/api/claims/72/approve", {}, user="marco").status == 403  # 403 still comes first
+    assert app.post("/api/claims/72/approve", {"x": 1}, user="nadia").status == 409  # 409 beats 400
+    assert app.get("/api/claims/72", user="nadia").json == before
+    assert app.get("/api/cost_centres/2", user="nadia").json == SALES
+    assert app.post("/api/claims/72/reject", {"reason": "Over budget"}, user="nadia").status == 200
+
+
+def test_budget_is_compared_to_the_cent(app):
+    assert app.patch("/api/cost_centres/2", {"budget": 11869.36}, user="fiona").status == 200
+    assert app.post("/api/claims/58/approve", {}, user="nadia").status == 409
+    assert app.patch("/api/cost_centres/2", {"budget": 11869.37}, user="fiona").status == 200
+    assert app.post("/api/claims/58/approve", {}, user="nadia").status == 200
+    assert app.get("/api/cost_centres/2", user="nadia").json["remaining"] == 0.0
+
+
+def test_moving_a_draft_to_another_cost_centre_changes_whose_budget_counts(app):
+    # Wen's draft claim 1 (1271.32) is over Sales' remaining budget but within the travel pool's.
+    claim_path = "/api/claims/1"
+    app.patch(claim_path, {"cost_centre": 2}, user="wen")
+    app.post(f"{claim_path}/submit", {}, user="wen")
+    assert app.post(f"{claim_path}/approve", {}, user="marco").status == 409
+    claim = app.post("/api/claims", {"amount": 1271.32, "category": "other", "description": "Hotel",
+                                     "cost_centre": 4}, user="wen").json
+    app.post(f"/api/claims/{claim['id']}/submit", {}, user="wen")
+    assert app.post(f"/api/claims/{claim['id']}/approve", {}, user="marco").status == 200
+    assert app.get("/api/cost_centres/4", user="wen").json["remaining"] == 3728.68
+
+
+def test_paying_does_not_change_committed(app):
+    assert app.post("/api/claims/4/pay", {}, user="fiona").status == 200
+    assert app.get("/api/cost_centres/2", user="fiona").json == SALES
+    payload = app.get("/api/_outbox", user="fiona").json["items"][0]["payload"]
