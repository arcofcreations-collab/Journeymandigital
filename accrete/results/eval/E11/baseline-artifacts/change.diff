+# --- cost centres ---------------------------------------------------------------------
+
+# ``committed``: the amounts of the cost centre's approved and paid claims.
+_COST_CENTRE_SELECT = """
+    SELECT cc.id, cc.code, cc.name, cc.department, cc.budget,
+           (SELECT COALESCE(SUM(c.amount), 0) FROM claims c
+            WHERE c.cost_centre_id = cc.id AND c.status IN ('approved', 'paid')) AS committed
+    FROM cost_centres cc
+"""
+
+
+def _cost_centre(row):
+    if row is None:
+        return None
+    committed = cents(row["committed"])
+    return {
+        "id": row["id"],
+        "code": row["code"],
+        "name": row["name"],
+        "department": row["department"],
+        "budget": row["budget"],
+        "committed": float(committed),
+        "remaining": round_money(cents(row["budget"]) - committed),
+    }
+
+
+def list_cost_centres():
+    return [_cost_centre(row) for row in get_db().execute(f"{_COST_CENTRE_SELECT} ORDER BY cc.id")]
+
+
+def get_cost_centre(cost_centre_id):
+    return _cost_centre(get_db().execute(f"{_COST_CENTRE_SELECT} WHERE cc.id = ?", (cost_centre_id,)).fetchone())
+
+
+def get_cost_centre_for_department(department):
+    row = get_db().execute(f"{_COST_CENTRE_SELECT} WHERE cc.department = ?", (department,)).fetchone()
+    return _cost_centre(row)
+
+
+def cost_centre_value_taken(field, value, exclude_id=None):
+    """True if another cost centre has ``field`` (``code`` or ``department``) equal to ``value``."""
+    column = {"code": "code", "department": "department"}[field]
+    row = get_db().execute(
+        f"SELECT 1 FROM cost_centres WHERE {column} = ? AND id IS NOT ?", (value, exclude_id)
+    ).fetchone()
+    return row is not None
+
+
+def insert_cost_centre(values):
+    cur = get_db().execute(
+        "INSERT INTO cost_centres (code, name, department, budget) VALUES (?, ?, ?, ?)",
+        (values["code"], values["name"], values["department"], values["budget"]),
+    )
+    return cur.lastrowid
+
+
+def update_cost_centre(cost_centre_id, values):
+    columns = {"code": "code", "name": "name", "department": "department", "budget": "budget"}
+    _update("cost_centres", columns, cost_centre_id, values)
+
+
+def delete_cost_centre(cost_centre_id):
+    get_db().execute("DELETE FROM cost_centres WHERE id = ?", (cost_centre_id,))
+
+
+def cost_centre_has_claims(cost_centre_id):
+    row = get_db().execute("SELECT EXISTS (SELECT 1 FROM claims WHERE cost_centre_id = ?)", (cost_centre_id,))
+    return bool(row.fetchone()[0])
 
 
