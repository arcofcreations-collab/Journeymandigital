+        raise Forbidden("Only finance can create cost centres.")
+
+
+def create_cost_centre(ctx, data):
+    ensure_can_create_cost_centre(ctx)
+    with transaction():
+        values = validation.clean_cost_centre(data, partial=False)
+        _check_cost_centre_uniqueness(values)
+        cost_centre_id = repository.insert_cost_centre(values)
+    return repository.get_cost_centre(cost_centre_id)
+
+
+def update_cost_centre(ctx, cost_centre_id, data):
+    with transaction():
+        cost_centre = _load_cost_centre(cost_centre_id)
+        if not permissions.can_manage_cost_centres(ctx.user):
+            raise Forbidden("Only finance can update cost centres.")
+        _require_budget_covers_committed(cost_centre, data)
+        values = validation.clean_cost_centre(data, partial=True)
+        _check_cost_centre_uniqueness(values, cost_centre_id)
+        repository.update_cost_centre(cost_centre_id, values)
+    return repository.get_cost_centre(cost_centre_id)
+
+
+def delete_cost_centre(ctx, cost_centre_id):
+    with transaction():
+        _load_cost_centre(cost_centre_id)
+        if not permissions.can_manage_cost_centres(ctx.user):
+            raise Forbidden("Only finance can delete cost centres.")
+        if repository.cost_centre_has_claims(cost_centre_id):
+            raise Conflict("A cost centre with claims cannot be deleted.")
+        repository.delete_cost_centre(cost_centre_id)
+
+
+def _load_cost_centre(cost_centre_id):
+    cost_centre = repository.get_cost_centre(cost_centre_id)
+    if cost_centre is None:
+        raise NotFound("No such cost centre.")
+    return cost_centre
+
+
+def _require_budget_covers_committed(cost_centre, data):
+    """A valid new ``budget`` below the current ``committed`` is a 409 (checked before other 400s)."""
+    if not isinstance(data, dict) or "budget" not in data:
+        return
+    try:
+        budget = validation.budget_amount(data["budget"])
+    except validation.FieldInvalid:
+        return  # reported as a 400 by clean_cost_centre
+    if cents(budget) < cents(cost_centre["committed"]):
+        raise Conflict("The budget cannot be lower than the amount already committed.",
+                       {"budget": f"must be at least {cost_centre['committed']}"})
+
+
+def _check_cost_centre_uniqueness(values, cost_centre_id=None):
+    """``code`` is unique; ``department`` is unique among non-null values."""
+    errors = {}
+    for field in ("code", "department"):
+        if values.get(field) is not None and repository.cost_centre_value_taken(field, values[field], cost_centre_id):
+            errors[field] = "already in use"
+    if errors:
+        raise ValidationError("Invalid input.", errors)
