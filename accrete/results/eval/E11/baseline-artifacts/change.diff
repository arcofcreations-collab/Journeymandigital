+def _default_cost_centre_id(employee):
+    """The cost centre of the employee's department; claims need one, so none is a 400."""
+    cost_centre = repository.get_cost_centre_for_department(employee["department"])
+    if cost_centre is None:
+        raise ValidationError("Invalid input.", {"cost_centre": "required: your department has no cost centre"})
+    return cost_centre["id"]
+
+
+def _check_claim_references(values):
+    if "cost_centre" in values and repository.get_cost_centre(values["cost_centre"]) is None:
+        raise ValidationError("Invalid input.", {"cost_centre": "no such cost centre"})
+
+
+def _within_budget(claim):
+    """True if approving ``claim`` keeps its cost centre's committed amount within budget (to the cent)."""
+    cost_centre = repository.get_cost_centre(claim["cost_centre"])
+    committed_after = cents(cents(cost_centre["committed"]) + Decimal(repr(claim["amount"])))
+    return committed_after <= cents(cost_centre["budget"])
+
