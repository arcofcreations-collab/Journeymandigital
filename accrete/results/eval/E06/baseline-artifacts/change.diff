--- a/maintenance_app/migrations/0007_manager_role.sql
+++ b/maintenance_app/migrations/0007_manager_role.sql
@@ -0,0 +1,31 @@
+-- Site-scoped supervisors and a new 'manager' role. A manager has the supervisor rights on every
+-- site (and is the only role that manages staff); supervisors now run only their own site.
+--
+-- Data: staff sofia (id 1) becomes the company-wide manager and keeps her site (North); tomas
+-- (South) and yara (East) remain supervisors. No other record changes.
+--
+-- The CHECK constraint on role can't be altered in place, so the table is rebuilt
+-- (create-copy-drop-rename; the runner applies migrations with foreign keys off and checks
+-- them before committing). The UNIQUE constraint on username comes back with the table.
+
+CREATE TABLE staff_new (
+    id       INTEGER PRIMARY KEY AUTOINCREMENT,
+    username TEXT    NOT NULL UNIQUE,
+    name     TEXT    NOT NULL,
+    role     TEXT    NOT NULL CHECK (role IN ('requester', 'technician', 'supervisor', 'manager')),
+    site     TEXT    NOT NULL,
+    active   INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1))
+);
+
+INSERT INTO staff_new (id, username, name, role, site, active)
+SELECT id, username, name, role, site, active
+  FROM staff;
+
+-- Keep the id counter where it was, so new staff continue exactly as before.
+DELETE FROM sqlite_sequence WHERE name = 'staff_new';
+INSERT INTO sqlite_sequence (name, seq) SELECT 'staff_new', seq FROM sqlite_sequence WHERE name = 'staff';
+
+DROP TABLE staff;
+ALTER TABLE staff_new RENAME TO staff;
+
+UPDATE staff SET role = 'manager' WHERE id = 1 AND username = 'sofia';
