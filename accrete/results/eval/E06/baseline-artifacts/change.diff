--- a/tests/test_maintenance_sites.py
+++ b/tests/test_maintenance_sites.py
@@ -0,0 +1,273 @@
+"""Site-scoped supervisors and the company-wide manager (migration 0007).
+
+sofia (id 1, North) is the manager: the former supervisor rights on every site, and the only
+one who manages staff. tomas (id 2, South) and yara (id 16, East) supervise their own site only.
+Orders used here: 74 open, 77 assigned, 79 in_progress (North); 76 open, 61 in_progress (South).
+"""
+import os
+import shutil
+import sqlite3
+import sys
+
+from accept_client import parse_ui
+
+APP_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+NEW_STAFF = {"username": "ada", "name": "Ada Byrne", "role": "technician", "site": "East"}
+NEW_ASSET = {"tag": "S-NEW-01", "name": "New pump", "site": "South", "criticality": "low"}
+NEW_PART = {"sku": "S-NEW", "name": "Gasket", "site": "South", "unit_cost": 2.5, "quantity": 4, "reorder_level": 1}
+
+
+def _ids(app, path, user):
+    return [item["id"] for item in app.get(path, user=user).json["items"]]
+
+
+# --- roles and data -------------------------------------------------------------------
+
+def test_sofia_is_the_manager_and_the_supervisors_keep_their_sites(app):
+    leads = app.get("/api/staff?active=true", user="ruth").json["items"]
+    assert [(s["username"], s["role"], s["site"]) for s in leads if s["role"] in ("manager", "supervisor")] == [
+        ("sofia", "manager", "North"), ("tomas", "supervisor", "South"), ("yara", "supervisor", "East")]
+    assert _ids(app, "/api/staff?role=manager", "mei") == [1]
+
+
+def test_manager_is_a_valid_role(app):
+    r = app.post("/api/staff", {**NEW_STAFF, "role": "manager"}, user="sofia")
+    assert r.status == 201 and r.json["role"] == "manager"
+    assert app.patch("/api/staff/2", {"role": "manager"}, user="sofia").json["role"] == "manager"
+    for role in ("Manager", "admin", "", None):
+        assert app.post("/api/staff", {**NEW_STAFF, "username": "bea", "role": role}, user="sofia").status == 400
+        assert app.patch("/api/staff/3", {"role": role}, user="sofia").status == 400
+
+
+def test_new_manager_has_rights_everywhere(app):
+    app.post("/api/staff", {**NEW_STAFF, "username": "max", "role": "manager", "site": "East"}, user="sofia")
+    assert app.get("/api/work_orders/74", user="max").status == 200
+    assert app.post("/api/work_orders/76/assign", {"technician": 11}, user="max").status == 200
+    assert app.post("/api/assets", {**NEW_ASSET, "site": "North"}, user="max").status == 201
+
+
+# --- staff: managers only -------------------------------------------------------------
+
+def test_only_the_manager_manages_staff(app):
+    for user in ("tomas", "yara"):
+        assert app.post("/api/staff", NEW_STAFF, user=user).status == 403
+        assert app.post("/api/staff", {"bogus": 1}, user=user).status == 403  # 403 beats 400
+        assert app.patch("/api/staff/12", {"name": "T"}, user=user).status == 403  # tess, East
+        assert app.patch("/api/staff/12", {"role": "boss"}, user=user).status == 403
+        assert app.delete("/api/staff/12", user=user).status == 403
+    new_id = app.post("/api/staff", NEW_STAFF, user="sofia").json["id"]
+    assert app.patch(f"/api/staff/{new_id}", {"site": "South"}, user="sofia").status == 200
+    assert app.delete(f"/api/staff/{new_id}", user="sofia").status == 204
+
+
+# --- work orders ----------------------------------------------------------------------
+
+def test_supervisors_read_their_own_sites_orders(app):
+    all_ids = _ids(app, "/api/work_orders", "sofia")
+    assert len(all_ids) == 82
+    south = _ids(app, "/api/work_orders?asset=16", "tomas")
+    assert south == _ids(app, "/api/work_orders?asset=16", "sofia")
+    assert app.get("/api/work_orders/74", user="tomas").status == 403
+    assert app.get("/api/work_orders/76", user="tomas").status == 200
+    assert app.get("/api/work_orders/76", user="yara").status == 403
+    assert app.get("/api/work_orders/81", user="yara").status == 200
+
+
+def test_supervisor_reads_orders_they_requested_at_another_site(app):
+    order = app.post("/api/work_orders", {"asset": 14, "title": "Draught", "priority": "p3"}, user="tomas").json
+    app.patch("/api/staff/2", {"site": "North"}, user="sofia")  # tomas moves to North
+    assert app.get(f"/api/work_orders/{order['id']}", user="tomas").status == 200  # requester
+    assert app.get("/api/work_orders/76", user="tomas").status == 403  # South, not his
+    assert app.get("/api/work_orders/74", user="tomas").status == 200  # now his site
+
+
+def test_supervisor_assigns_only_at_own_site(app):
+    assert app.post("/api/work_orders/76/assign", {"technician": 11}, user="tomas").status == 200
+    assert app.post("/api/work_orders/74/assign", {"technician": 9}, user="tomas").status == 403
+    assert app.post("/api/work_orders/74/assign", {}, user="tomas").status == 403  # 403 beats 400
+    assert app.post("/api/work_orders/79/assign", {"technician": 9}, user="tomas").status == 403  # beats 409
+    assert app.post("/api/work_orders/74/assign", {"technician": 9}, user="yara").status == 403
+    assert app.post("/api/work_orders/74/assign", {"technician": 9}, user="sofia").status == 200  # North
+    assert app.post("/api/work_orders/78/assign", {"technician": 15}, user="sofia").status == 200  # South
+    assert [m["payload"]["work_order"] for m in app.get("/api/_outbox", user="ruth").json["items"]] == [76, 74, 78]
+
+
+def test_workload_cap_still_applies_to_site_supervisors(app):
+    # ravi (10, South) is the assignee of 4 assigned/in_progress orders.
+    assert app.post("/api/work_orders/76/assign", {"technician": 10}, user="tomas").status == 409
+    assert app.post("/api/work_orders/76/assign", {"technician": 8}, user="tomas").status == 400  # North tech
+
+
+def test_supervisor_cancels_and_edits_only_at_own_site(app):
+    assert app.post("/api/work_orders/61/cancel", {"reason": "Budget"}, user="tomas").status == 200  # in_progress
+    assert app.post("/api/work_orders/77/cancel", {"reason": "Budget"}, user="tomas").status == 403
+    assert app.post("/api/work_orders/77/cancel", {}, user="tomas").status == 403  # 403 beats 400
+    assert app.post("/api/work_orders/2/cancel", {"reason": "x"}, user="tomas").status == 403  # beats 409
+    r = app.patch("/api/work_orders/76", {"title": "Belt", "priority": "p2"}, user="tomas")
+    assert r.status == 200 and (r.json["title"], r.json["priority"]) == ("Belt", "p2")
+    assert app.patch("/api/work_orders/74", {"title": "x"}, user="tomas").status == 403
+    assert app.patch("/api/work_orders/2", {"title": "x"}, user="tomas").status == 403  # beats 409
+    assert app.patch("/api/work_orders/74", {"title": "x"}, user="yara").status == 403
+    assert app.patch("/api/work_orders/76", {"priority": "p3"}, user="sofia").status == 200  # manager anywhere
+    assert app.post("/api/work_orders/79/cancel", {"reason": "x"}, user="sofia").status == 200
+
+
+def test_supervisor_keeps_only_requester_rights_at_another_site(app):
+    order_id = app.post("/api/work_orders", {"asset": 14, "title": "Draught", "priority": "p3"}, user="tomas").json["id"]
+    app.patch("/api/staff/2", {"site": "North"}, user="sofia")  # tomas now supervises North
+    path = f"/api/work_orders/{order_id}"
+    assert app.patch(path, {"title": "Cold draught"}, user="tomas").status == 200  # requester, open
+    assert app.patch(path, {"priority": "p2"}, user="tomas").status == 403  # requesters may not set priority
+    assert app.post(f"{path}/assign", {"technician": 11}, user="tomas").status == 403
+    assert app.post(f"{path}/assign", {"technician": 11}, user="sofia").status == 200
+    assert app.patch(path, {"title": "x"}, user="tomas").status == 409  # requester: only while open
+    assert app.post(f"{path}/cancel", {"reason": "x"}, user="tomas").status == 409
+    assert app.post(f"{path}/cancel", {"reason": "x"}, user="sofia").status == 200
+
+
+def test_supervisors_create_work_orders_only_at_own_site(app):
+    north = {"asset": 1, "title": "Noise", "priority": "p2"}
+    assert app.post("/api/work_orders", north, user="tomas").status == 403
+    assert app.post("/api/work_orders", {**north, "title": "", "colour": "red"}, user="tomas").status == 403
+    assert app.post("/api/work_orders", {"asset": 7}, user="tomas").status == 403  # retired, other site
+    assert app.post("/api/work_orders", {**north, "asset": 14}, user="tomas").status == 201
+    assert app.post("/api/work_orders", {**north, "asset": 25}, user="sofia").status == 201  # manager: East
+    assert app.post("/api/work_orders", {**north, "asset": 999}, user="tomas").status == 400
+
+
+# --- assets and parts -----------------------------------------------------------------
+
+def test_supervisor_creates_assets_only_at_own_site(app):
+    assert app.post("/api/assets", NEW_ASSET, user="tomas").status == 201
+    assert app.post("/api/assets", {**NEW_ASSET, "tag": "X-2", "site": "North"}, user="tomas").status == 403
+    assert app.post("/api/assets", {**NEW_ASSET, "site": "North", "tag": "", "colour": 1}, user="tomas").status == 403
+    body = {k: v for k, v in NEW_ASSET.items() if k != "site"}
+    assert app.post("/api/assets", {**body, "tag": "X-3"}, user="tomas").status == 400  # no site: just a 400
+    assert app.post("/api/assets", {**NEW_ASSET, "tag": "X-4", "site": "East"}, user="sofia").status == 201
+    assert app.post("/api/assets", {**NEW_ASSET, "tag": "X-5"}, user="ruth").status == 403
+
+
+def test_supervisor_changes_assets_only_at_own_site(app):
+    assert app.patch("/api/assets/14", {"name": "AHU South"}, user="tomas").status == 200
+    assert app.patch("/api/assets/14", {"site": "South", "criticality": "medium"}, user="tomas").status == 200
+    assert app.patch("/api/assets/14", {"site": "North"}, user="tomas").status == 403  # moving away
+    assert app.patch("/api/assets/14", {"site": "North", "tag": ""}, user="tomas").status == 403  # beats 400
+    assert app.patch("/api/assets/16", {"site": "North", "retired": True}, user="tomas").status == 403  # beats 409
+    assert app.patch("/api/assets/16", {"retired": True}, user="tomas").status == 409  # own site: open orders
+    assert app.patch("/api/assets/1", {"name": "x"}, user="tomas").status == 403
+    assert app.patch("/api/assets/1", {"retired": True, "colour": 1}, user="tomas").status == 403  # beats 409/400
