+def test_migration_0007_on_a_pre_0007_database(tmp_path):
+    """Apply 0001-0006, add staff and references to them, then apply 0007."""
+    sys.path.insert(0, APP_DIR)
+    try:
+        from maintenance_app import db
+    finally:
+        sys.path.remove(APP_DIR)
+    old_migrations = tmp_path / "migrations"
+    old_migrations.mkdir()
+    for name in os.listdir(db.MIGRATIONS_DIR):
+        if name.endswith(".sql") and int(name[:4]) <= 6:
+            shutil.copy(os.path.join(db.MIGRATIONS_DIR, name), old_migrations / name)
+    path = str(tmp_path / "data.db")
+    db.migrate(path, str(old_migrations))
+
+    conn = sqlite3.connect(path)
+    conn.executescript("""
+        INSERT INTO staff (id, username, name, role, site, active) VALUES
+            (1, 'sofia', 'Sofia', 'supervisor', 'North', 1), (2, 'tomas', 'Tomas', 'supervisor', 'South', 1),
+            (3, 'tech', 'Tech', 'technician', 'South', 0), (7, 'req', 'Req', 'requester', 'East', 1);
+        DELETE FROM staff WHERE id = 7;
+        INSERT INTO assets (id, tag, name, site, criticality, retired) VALUES (1, 'A-1', 'Pump', 'South', 'low', 0);
+        INSERT INTO work_orders (id, asset_id, title, priority, status, requested_by_id, created_at, assignee_id)
+            VALUES (1, 1, 'Leak', 'p3', 'assigned', 2, '2026-01-01T08:00:00', 3);
+    """)
+    before = [tuple(row) for row in conn.execute("SELECT * FROM staff ORDER BY id")]
+    conn.close()
+
+    assert db.migrate(path) == ["0007_manager_role.sql"]
+
+    conn = sqlite3.connect(path)
+    try:
+        after = [tuple(row) for row in conn.execute("SELECT * FROM staff ORDER BY id")]
+        assert after == [(1, "sofia", "Sofia", "manager", "North", 1)] + before[1:]
+        assert conn.execute("SELECT requested_by_id, assignee_id FROM work_orders").fetchall() == [(2, 3)]
+        assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+        conn.execute("INSERT INTO staff (username, name, role, site) VALUES ('new', 'New', 'manager', 'East')")
+        assert conn.execute("SELECT MAX(id) FROM staff").fetchone()[0] == 8  # the id counter was kept
+    finally:
+        conn.close()
