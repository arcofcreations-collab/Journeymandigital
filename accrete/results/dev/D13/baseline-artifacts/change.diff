@@ -0,0 +1,15 @@
+-- Approval delegation: a manager hands their approval duties to another manager for a
+-- date range (inclusive on both ends). No delegations exist initially.
+
+CREATE TABLE delegations (
+    id           INTEGER PRIMARY KEY AUTOINCREMENT,
+    delegator_id INTEGER NOT NULL REFERENCES employees (id),
+    delegate_id  INTEGER NOT NULL REFERENCES employees (id),
+    starts_on    TEXT    NOT NULL,  -- YYYY-MM-DD
+    ends_on      TEXT    NOT NULL,  -- YYYY-MM-DD
+    CHECK (delegate_id <> delegator_id),
+    CHECK (ends_on >= starts_on)
+);
+
+CREATE INDEX delegations_delegator_id ON delegations (delegator_id);
+CREATE INDEX delegations_delegate_id ON delegations (delegate_id);
