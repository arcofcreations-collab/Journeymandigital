+"""
+import io
+import os
+import sqlite3
+import sys
+from urllib.parse import urlencode
+
+from accept_client import parse_ui
+
+NOW = "2026-03-02T09:30:00"
+SPAN = {"starts_on": "2026-03-01", "ends_on": "2026-03-05"}
+
+
+def delegate(app, delegator, delegate_id, span=SPAN):
+    r = app.post("/api/delegations", {"delegate": delegate_id, **span}, user=delegator, now=NOW)
+    assert r.status == 201, r.json
+    return r.json
+
+
+def ids(app, path, user, now=NOW):
+    return [record["id"] for record in app.get(path, user=user, now=now).json["items"]]
+
+
+def actions(app, claim_id, user, now=NOW):
+    return parse_ui(app.get(f"/ui/claims/{claim_id}", user=user, now=now).text).actions
+
+
+# --- the collection -------------------------------------------------------------------
+
+def test_no_delegations_initially(app):
+    assert app.get("/api/delegations", user="fiona").json == {"items": []}
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    assert conn.execute("SELECT COUNT(*) FROM delegations").fetchone()[0] == 0
+    conn.close()
+
+
+def test_manager_creates_delegation_for_themselves(app):
+    r = app.post("/api/delegations", {"delegate": 3, **SPAN}, user="omar", now=NOW)
+    assert r.status == 201
+    assert r.json == {"id": r.json["id"], "delegator": 4, "delegate": 3, **SPAN}
+    assert app.get(f"/api/delegations/{r.json['id']}", user="omar").json == r.json
+
+
+def test_only_managers_create_delegations(app):
+    for user in ("priya", "fiona"):
+        assert app.post("/api/delegations", {"delegate": 3, **SPAN}, user=user).status == 403
+        assert app.post("/api/delegations", {"delegator": 9}, user=user).status == 403  # 403 beats 400
+
+
+def test_delegation_validation(app):
+    def status(body):
+        return app.post("/api/delegations", body, user="omar").status
+
+    r = app.post("/api/delegations", {"delegate": 3, "delegator": 4, **SPAN}, user="omar")
+    assert r.status == 400 and "delegator" in r.json["fields"]
+    assert status({"delegate": 3, "id": 7, **SPAN}) == 400
+    assert status({"delegate": 3, "colour": "red", **SPAN}) == 400
+    for delegate_id in (4, 5, 1, 999, "3", None):  # self, employee, finance, unknown, not an id, missing
+        r = app.post("/api/delegations", {"delegate": delegate_id, **SPAN}, user="omar")
+        assert r.status == 400 and "delegate" in r.json["fields"], delegate_id
+    r = app.post("/api/delegations", {"delegate": 3, "starts_on": "2026-03-05", "ends_on": "2026-03-04"}, user="omar")
+    assert r.status == 400 and "ends_on" in r.json["fields"]
+    for bad in ("2026-02-30", "01/03/2026", "2026-03-01T00:00:00", 20260301, ""):
+        assert status({"delegate": 3, "starts_on": bad, "ends_on": "2026-03-05"}) == 400, bad
+    r = app.post("/api/delegations", {}, user="omar")
+    assert r.status == 400 and set(r.json["fields"]) == {"delegate", "starts_on", "ends_on"}
+    assert status({"delegate": 3, "starts_on": "2026-03-05", "ends_on": "2026-03-05"}) == 201  # one day
+    assert app.get("/api/delegations", user="fiona").json["items"][-1]["delegator"] == 4
+
+
+def test_delegation_visibility(app):
+    first = delegate(app, "omar", 3)  # omar -> nadia
+    second = delegate(app, "marco", 4)  # marco -> omar
+    assert ids(app, "/api/delegations", "fiona") == [first["id"], second["id"]]
+    assert ids(app, "/api/delegations", "omar") == [first["id"], second["id"]]  # delegator of 1, delegate of 2
+    assert ids(app, "/api/delegations", "nadia") == [first["id"]]
+    assert ids(app, "/api/delegations", "marco") == [second["id"]]
+    assert ids(app, "/api/delegations", "priya") == []
+    assert ids(app, "/api/delegations?delegate=4", "fiona") == [second["id"]]
+    assert app.get(f"/api/delegations/{first['id']}", user="nadia").status == 200
+    assert app.get(f"/api/delegations/{first['id']}", user="marco").status == 403
+    assert app.get(f"/api/delegations/{first['id']}", user="priya").status == 403
+    assert app.get("/api/delegations/999", user="fiona").status == 404
+    assert app.get("/api/delegations?colour=red", user="fiona").status == 400
+
+
+def test_nobody_patches_delegations(app):
+    d = delegate(app, "omar", 3)
+    for user in ("omar", "nadia", "fiona", "priya"):
+        assert app.patch(f"/api/delegations/{d['id']}", {"ends_on": "2026-03-09"}, user=user).status == 403
+    assert app.patch("/api/delegations/999", {}, user="omar").status == 404
+    assert app.get(f"/api/delegations/{d['id']}", user="omar").json == d
+
+
+def test_only_delegator_deletes(app):
+    d = delegate(app, "omar", 3)
+    path = f"/api/delegations/{d['id']}"
+    for user in ("nadia", "fiona", "marco"):
+        assert app.delete(path, user=user).status == 403
+    assert app.delete(path, user="omar").status == 204
+    assert app.get(path, user="omar").status == 404
+    assert app.delete(path, user="omar").status == 404
+
+
+def test_employee_in_a_delegation_cannot_be_deleted(app):
+    new = app.post("/api/employees", {"username": "mia", "name": "Mia", "role": "manager", "manager": None,
+                                      "department": "Ops"}, user="fiona").json
+    d = delegate(app, "omar", new["id"])
+    assert app.delete(f"/api/employees/{new['id']}", user="fiona").status == 409
+    assert app.delete(f"/api/delegations/{d['id']}", user="omar").status == 204
+    assert app.delete(f"/api/employees/{new['id']}", user="fiona").status == 204
+
+
+# --- rights granted by an active delegation -------------------------------------------
+
+def test_active_delegate_reads_and_decides_delegators_claims(app):
+    delegate(app, "omar", 3)  # nadia stands in for omar, 2026-03-01 .. 2026-03-05
+    all_claims = app.get("/api/claims", user="fiona").json["items"]
+    by_employee = lambda *emps: [c["id"] for c in all_claims if c["employee"] in emps]  # noqa: E731
+    # own + own reports + omar's direct reports (not omar's own claims: those are marco's to decide)
+    assert ids(app, "/api/claims", "nadia") == by_employee(3, 7, 10, 13, 5, 8, 11, 14)
+    assert app.get("/api/claims/2", user="nadia", now=NOW).status == 200
+    assert actions(app, 2, "nadia") == ["approve", "reject"]
+    r = app.post("/api/claims/2/approve", {}, user="nadia", now=NOW)
+    assert r.status == 200 and (r.json["status"], r.json["decided_by"], r.json["decided_at"]) == ("approved", 3, NOW)
+    assert app.post("/api/claims/2/approve", {}, user="nadia", now=NOW).status == 409  # same state rules
+    assert app.post("/api/claims/5/reject", {}, user="nadia", now=NOW).status == 400
+    r = app.post("/api/claims/5/reject", {"reason": "No receipt"}, user="nadia", now=NOW)
+    assert r.status == 200 and r.json["decided_by"] == 3 and r.json["rejection_reason"] == "No receipt"
+    assert app.post("/api/claims/4/pay", {}, user="nadia", now=NOW).status == 403  # nothing else is delegated
+
+
+def test_delegator_keeps_all_rights(app):
+    delegate(app, "omar", 3)
+    assert app.get("/api/claims/2", user="omar", now=NOW).status == 200
+    assert actions(app, 2, "omar") == ["approve", "reject"]
+    r = app.post("/api/claims/2/reject", {"reason": "Duplicate"}, user="omar", now=NOW)
+    assert r.status == 200 and r.json["decided_by"] == 4
+
+
+def test_delegation_is_active_only_within_its_dates(app):
+    d = delegate(app, "omar", 3)
+    for now, readable in (("2026-02-28T23:59:59", False), ("2026-03-01T00:00:00", True),
+                          ("2026-03-05T23:59:59", True), ("2026-03-06T00:00:00", False)):
+        assert (app.get("/api/claims/2", user="nadia", now=now).status == 200) is readable, now
+        assert (2 in ids(app, "/api/claims", "nadia", now)) is readable, now
+        assert actions(app, 2, "nadia", now) == (["approve", "reject"] if readable else []), now
+    assert app.post("/api/claims/2/approve", {}, user="nadia", now="2026-03-06T00:00:00").status == 403
+    assert app.post("/api/claims/2/reject", {"reason": "x"}, user="nadia", now="2026-02-28T12:00:00").status == 403
+    assert app.delete(f"/api/delegations/{d['id']}", user="omar").status == 204
+    assert app.get("/api/claims/2", user="nadia", now=NOW).status == 403
+    assert app.post("/api/claims/2/approve", {}, user="nadia", now=NOW).status == 403
+    assert app.get("/ui/claims/2", user="nadia", now=NOW).status == 403
+
+
+def test_nobody_decides_their_own_claim_through_a_delegation(app):
+    delegate(app, "marco", 4)  # omar stands in for marco, who manages omar
+    assert app.get("/api/claims/43", user="omar", now=NOW).status == 200  # own claim
+    assert actions(app, 43, "omar") == []
+    assert app.post("/api/claims/43/approve", {}, user="omar", now=NOW).status == 403
+    assert app.post("/api/claims/43/reject", {"reason": "x"}, user="omar", now=NOW).status == 403
+    assert app.post("/api/claims/3/approve", {}, user="omar", now=NOW).status == 200  # quinn's claim: allowed
+    assert app.post("/api/claims/43/approve", {}, user="marco", now=NOW).json["decided_by"] == 2
+
+
+def test_delegations_do_not_chain(app):
+    delegate(app, "marco", 4)  # marco -> omar
+    delegate(app, "omar", 3)  # omar -> nadia
+    assert app.get("/api/claims/3", user="nadia", now=NOW).status == 403  # quinn reports to marco
+    assert app.get("/api/claims/43", user="nadia", now=NOW).status == 403  # omar's own claim (marco decides)
+    assert app.post("/api/claims/3/approve", {}, user="nadia", now=NOW).status == 403
+    assert app.post("/api/claims/43/approve", {}, user="nadia", now=NOW).status == 403
+    assert app.post("/api/claims/2/approve", {}, user="nadia", now=NOW).status == 200  # omar's report: allowed
+
+
+def test_delegation_to_someone_else_grants_nothing_to_others(app):
+    delegate(app, "omar", 3)
+    assert app.get("/api/claims/2", user="marco", now=NOW).status == 403  # still only the indirect manager
+    assert app.post("/api/claims/2/approve", {}, user="marco", now=NOW).status == 403
+
+
+# --- UI -------------------------------------------------------------------------------
+
+def _post_form(app, path, form, user):
+    data = urlencode(form).encode()
+    environ = {
+        "REQUEST_METHOD": "POST", "PATH_INFO": path, "QUERY_STRING": "", "SERVER_NAME": "test",
+        "SERVER_PORT": "80", "SERVER_PROTOCOL": "HTTP/1.1", "wsgi.version": (1, 0), "wsgi.url_scheme": "http",
+        "wsgi.input": io.BytesIO(data), "wsgi.errors": sys.stderr, "wsgi.multithread": False,
+        "wsgi.multiprocess": False, "wsgi.run_once": False, "CONTENT_LENGTH": str(len(data)),
+        "CONTENT_TYPE": "application/x-www-form-urlencoded", "HTTP_X_USER": user, "HTTP_X_NOW": NOW,
+    }
+    captured = {}
+
+    def start_response(status, headers, exc_info=None):
+        captured.update(status=int(status.split()[0]), headers=dict(headers))
+
+    b"".join(app.wsgi(environ, start_response))
+    return captured["status"], captured["headers"]
+
+
+def test_delegation_pages(app):
+    page = parse_ui(app.get("/ui/delegations/new", user="omar").text)
+    assert page.creates == ["delegations"] and sorted(page.inputs) == ["delegate", "ends_on", "starts_on"]
+    assert app.get("/ui/delegations/new", user="priya").status == 403
+    assert app.get("/ui/delegations/new", user="fiona").status == 403
+
+    status, headers = _post_form(app, "/ui/delegations", {"delegate": "3", **SPAN}, "omar")
+    assert status == 303 and headers["Location"].endswith("/ui/delegations/1")
+    assert _post_form(app, "/ui/delegations", {"delegate": "3", "starts_on": "", "ends_on": ""}, "omar")[0] == 400
+
+    detail = parse_ui(app.get("/ui/delegations/1", user="nadia").text)
+    assert detail.fields == {"delegator": "4", "delegate": "3", **SPAN} and detail.actions == []
+    assert app.get("/ui/delegations/1", user="marco").status == 403
+    assert parse_ui(app.get("/ui/delegations", user="nadia").text).rows == [1]
+    assert parse_ui(app.get("/ui/delegations", user="marco").text).rows == []
+
+    assert _post_form(app, "/ui/delegations/1/delete", {}, "nadia")[0] == 403
+    assert _post_form(app, "/ui/delegations/1/delete", {}, "omar")[0] == 303
+    assert app.get("/api/delegations/1", user="omar").status == 404
