--- a/expenses_app/migrations/0003_withdraw_second_approval.sql
+++ b/expenses_app/migrations/0003_withdraw_second_approval.sql
@@ -0,0 +1,38 @@
+-- Withdraw the second-approval rule: every claim needs exactly one approval again.
+-- Claims awaiting the second approval become approved, the first approval standing as the
+-- decision. Claims already decided (or paid) keep their values. Then the status
+-- 'awaiting_second_approval' and the first_approved_by / first_approved_at columns are
+-- removed; the status CHECK constraint changes, so the claims table is rebuilt
+-- (create-copy-drop-rename).
+
+UPDATE claims
+SET status = 'approved',
+    decided_by_id = first_approved_by_id,
+    decided_at = first_approved_at
+WHERE status = 'awaiting_second_approval';
+
+CREATE TABLE claims_new (
+    id               INTEGER PRIMARY KEY AUTOINCREMENT,
+    employee_id      INTEGER NOT NULL REFERENCES employees (id),
+    amount           REAL    NOT NULL CHECK (amount > 0 AND amount <= 5000),
+    category         TEXT    NOT NULL CHECK (category IN ('travel', 'meals', 'equipment', 'other')),
+    description      TEXT    NOT NULL,
+    status           TEXT    NOT NULL DEFAULT 'draft'
+                             CHECK (status IN ('draft', 'submitted', 'approved', 'rejected', 'paid')),
+    submitted_at     TEXT,   -- YYYY-MM-DDTHH:MM:SS (UTC)
+    decided_at       TEXT,   -- YYYY-MM-DDTHH:MM:SS (UTC)
+    decided_by_id    INTEGER REFERENCES employees (id),
+    rejection_reason TEXT
+);
+
+INSERT INTO claims_new (id, employee_id, amount, category, description, status,
+                        submitted_at, decided_at, decided_by_id, rejection_reason)
+SELECT id, employee_id, amount, category, description, status,
+       submitted_at, decided_at, decided_by_id, rejection_reason
+FROM claims;
+
+DROP TABLE claims;
+ALTER TABLE claims_new RENAME TO claims;
+
+CREATE INDEX claims_employee_id ON claims (employee_id);
+CREATE INDEX claims_decided_by_id ON claims (decided_by_id);
