+++ b/tests/test_expenses_single_approval.py
@@ -0,0 +1,148 @@
+"""The second-approval rule is withdrawn: every claim needs exactly one approval, by the
+employee's manager, whatever the amount (migration 0003).
+
+Seed org chart used here: marco (2) manages omar (4); omar manages priya (5), sam (8),
+victor (11) and yusuf (14). marco is only an indirect manager of omar's reports.
+"""
+import os
+import sqlite3
+
+from accept_client import fresh_app, parse_ui
+
+NOW = "2026-03-02T09:30:00"
+REMOVED_FIELDS = {"first_approved_by", "first_approved_at"}
+
+
+def test_large_claim_needs_one_approval(app):
+    # claim 5: yusuf, 1057.93, submitted; omar's manager is marco
+    r = app.post("/api/claims/5/approve", {}, user="omar", now=NOW)
+    assert r.status == 200
+    assert (r.json["status"], r.json["decided_at"], r.json["decided_by"]) == ("approved", NOW, 4)
+    assert not REMOVED_FIELDS & set(r.json)
+    assert app.post("/api/claims/5/approve", {}, user="omar").status == 409
+    assert app.post("/api/claims/5/approve", {}, user="marco").status == 403
+    assert app.post("/api/claims/5/pay", {}, user="fiona").status == 200
+
+
+def test_large_claim_rejected_by_manager(app):
+    # claim 36: victor, 1655.60, submitted
+    assert app.post("/api/claims/36/reject", {"reason": "x"}, user="marco").status == 403
+    r = app.post("/api/claims/36/reject", {"reason": "Over budget"}, user="omar", now=NOW)
+    assert r.status == 200
+    assert (r.json["status"], r.json["rejection_reason"], r.json["decided_by"], r.json["decided_at"]) == (
+        "rejected", "Over budget", 4, NOW)
+
+
+def test_maximum_amount_needs_one_approval(app):
+    claim = app.post("/api/claims", {"amount": 5000, "category": "travel", "description": "Trip"}, user="sam").json
+    assert app.post(f"/api/claims/{claim['id']}/submit", {}, user="sam").status == 200
+    r = app.post(f"/api/claims/{claim['id']}/approve", {}, user="omar", now=NOW)
+    assert r.status == 200 and r.json["status"] == "approved" and r.json["decided_by"] == 4
+
+
+def test_indirect_manager_has_no_access(app):
+    # marco used to read and decide large claims of omar's reports after omar's approval.
+    assert app.post("/api/claims/5/approve", {}, user="omar").status == 200
+    for claim_id in (5, 21, 22, 44):
+        assert app.get(f"/api/claims/{claim_id}", user="marco").status == 403, claim_id
+        assert app.get(f"/ui/claims/{claim_id}", user="marco").status == 403, claim_id
+    ids = {c["id"] for c in app.get("/api/claims", user="marco").json["items"]}
+    assert not ids & {5, 21, 22, 44}
+
+
+def test_removed_status_and_fields(app):
+    claims = app.get("/api/claims", user="fiona").json["items"]
+    assert all(not REMOVED_FIELDS & set(c) for c in claims)
+    assert "awaiting_second_approval" not in {c["status"] for c in claims}
+    assert app.get("/api/claims?first_approved_by=4", user="fiona").status == 400
+    assert app.get("/api/claims?status=awaiting_second_approval", user="fiona").json["items"] == []
+    new = {"amount": 1, "category": "meals", "description": "x"}
+    r = app.post("/api/claims", dict(new, first_approved_by=4), user="priya")
+    assert r.status == 400 and r.json["fields"] == {"first_approved_by": "unknown field"}
+    page = parse_ui(app.get("/ui/claims/21", user="fiona").text)
+    assert not REMOVED_FIELDS & set(page.fields)
+
+
+def test_seed_claims_were_migrated(app):
+    def claim(claim_id):
+        return app.get(f"/api/claims/{claim_id}", user="fiona").json
+
+    # Awaited marco's second approval: omar's first approval now stands.
+    for claim_id, decided_at in ((21, "2026-01-28T08:00:00"), (22, "2026-01-11T13:00:00"),
+                                 (44, "2026-01-19T14:00:00")):
+        c = claim(claim_id)
+        assert (c["status"], c["decided_by"], c["decided_at"]) == ("approved", 4, decided_at), claim_id
+    assert app.post("/api/claims/21/pay", {}, user="fiona").status == 200
+    page = parse_ui(app.get("/ui/claims/22", user="omar").text)
+    assert page.fields["status"] == "approved" and page.actions == []
+    assert parse_ui(app.get("/ui/claims/22", user="fiona").text).actions == ["pay"]
+
+
+EMPLOYEES = [
+    (1, "fiona", "finance", None), (2, "marco", "manager", None), (4, "omar", "manager", 2),
+    (5, "priya", "employee", 4),
+]
+# id, amount, status, first_approved_by, first_approved_at, decided_at, decided_by, rejection_reason
+CLAIMS_AT_VERSION_2 = [
+    (1, 1500.0, "awaiting_second_approval", 4, "2026-01-05T10:00:00", None, None, None),
+    (2, 1600.0, "approved", 4, "2026-01-06T10:00:00", "2026-01-07T10:00:00", 2, None),
+    (3, 1700.0, "rejected", 4, "2026-01-06T11:00:00", "2026-01-07T11:00:00", 2, "Over budget"),
+    (4, 1800.0, "paid", 4, "2026-01-06T12:00:00", "2026-01-07T12:00:00", 2, None),
+    (5, 200.0, "approved", None, None, "2026-01-08T10:00:00", 4, None),
+    (6, 300.0, "rejected", None, None, "2026-01-08T11:00:00", 4, "No receipt"),
+    (7, 1900.0, "submitted", None, None, None, None, None),
+    (8, 50.0, "draft", None, None, None, None, None),
+]
+# id: (status, decided_at, decided_by, rejection_reason) after migration 0003
+EXPECTED = {
+    1: ("approved", "2026-01-05T10:00:00", 4, None),  # the first approval stands
+    2: ("approved", "2026-01-07T10:00:00", 2, None),  # decided claims keep their decision
+    3: ("rejected", "2026-01-07T11:00:00", 2, "Over budget"),
+    4: ("paid", "2026-01-07T12:00:00", 2, None),
+    5: ("approved", "2026-01-08T10:00:00", 4, None),
+    6: ("rejected", "2026-01-08T11:00:00", 4, "No receipt"),
+    7: ("submitted", None, None, None),
+    8: ("draft", None, None, None),
+}
+
+
+def test_migration_withdraws_second_approval(app):
+    """Build a database at schema version 2 holding every claim state, then start the app."""
+    path = os.path.join(app.workdir, "data.db")
+    os.remove(path)
+    migrations = os.path.join(app.workdir, "expenses_app", "migrations")
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE schema_version (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL)")
+    for version, name in ((1, "initial"), (2, "second_approval")):
+        with open(os.path.join(migrations, f"{version:04d}_{name}.sql"), encoding="utf-8") as fh:
+            conn.executescript(fh.read())
+        conn.execute("INSERT INTO schema_version VALUES (?, ?, '2026-01-01T00:00:00')", (version, name))
+    conn.executemany("INSERT INTO employees VALUES (?, ?, ?, ?, ?, 'Eng')",
+                     [(i, u, u.title(), r, m) for i, u, r, m in EMPLOYEES])
+    conn.executemany(
+        "INSERT INTO claims (id, employee_id, amount, category, description, status, submitted_at,"
+        " first_approved_by_id, first_approved_at, decided_at, decided_by_id, rejection_reason)"
+        " VALUES (?, 5, ?, 'travel', 'Trip', ?, '2026-01-01T09:00:00', ?, ?, ?, ?, ?)",
+        CLAIMS_AT_VERSION_2,
+    )
+    conn.commit()
+    conn.close()
+
+    upgraded = fresh_app(app.workdir)
+    claims = {c["id"]: c for c in upgraded.get("/api/claims", user="fiona").json["items"]}
+    assert sorted(claims) == sorted(EXPECTED)
+    for row in CLAIMS_AT_VERSION_2:
+        c = claims[row[0]]
+        assert (c["status"], c["decided_at"], c["decided_by"], c["rejection_reason"]) == EXPECTED[row[0]], row[0]
+        assert (c["employee"], c["amount"]) == (5, row[1])
+        assert not REMOVED_FIELDS & set(c)
+
+    conn = sqlite3.connect(os.path.join(upgraded.workdir, "data.db"))
+    columns = {row[1] for row in conn.execute("PRAGMA table_info(claims)")}
+    conn.close()
+    assert not {"first_approved_by_id", "first_approved_at"} & columns
+    # The migrated database keeps working: pay the migrated claim, approve a large one.
+    assert upgraded.post("/api/claims/1/pay", {}, user="fiona").json["status"] == "paid"
+    assert upgraded.post("/api/claims/7/approve", {}, user="omar", now=NOW).json["status"] == "approved"
+    new = upgraded.post("/api/claims", {"amount": 5, "category": "meals", "description": "x"}, user="priya").json
+    assert new["id"] == 9
