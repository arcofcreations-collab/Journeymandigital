+"""Late-return fines: 0.50 per day late (max 5.00), unpaid fines block borrowing, renewing and holds."""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+# Loan 52: chen (member 3) has book 22, due 2026-03-04. Loan 46: jo (member 10) has book 4, due 2026-02-15.
+# Loan 60: eli (member 5) has book 39, due 2026-03-05. Book 3 is available.
+# Seed loan 2 (jo) was returned 4 days late; seed loan 1 (dara) was returned on time.
+T1 = "2026-03-01T10:00:00"
+LATE = "2026-03-06T09:00:00"  # loan 52 is 2 days late, loan 60 one day
+
+
+def _outbox(app, channel=None):
+    items = app.get("/api/_outbox", user="ada").json["items"]
+    return [m for m in items if channel is None or m["channel"] == channel]
+
+
+def _fines_due(app, member_id):
+    return app.get(f"/api/members/{member_id}", user="ada").json["fines_due"]
+
+
+def test_open_loan_fine_grows_daily_up_to_the_cap(app):
+    def fine(now):
+        return app.get("/api/loans/52", user="chen", now=now).json["fine"]
+
+    assert fine("2026-03-04T23:59:59") == 0  # due today
+    assert fine("2026-03-05T00:00:00") == 0.5
+    assert fine("2026-03-07T12:00:00") == 1.5
+    assert fine("2026-03-14T00:00:00") == 5.0
+    assert fine("2026-04-30T00:00:00") == 5.0  # capped
+    assert app.get("/api/loans/46", user="jo", now=T1).json["fine"] == 5.0
+    # Fines on loans still out do not count yet.
+    assert app.get("/api/members/3", user="chen", now="2026-04-30T00:00:00").json["fines_due"] == 0
+
+
+def test_existing_late_returns_are_settled(app):
+    loan = app.get("/api/loans/2", user="ada").json
+    assert loan["fine"] == 2.0 and loan["fine_paid"] is True
+    loan = app.get("/api/loans/1", user="ada").json
+    assert loan["fine"] == 0 and loan["fine_paid"] is False
+    assert all(m["fines_due"] == 0 for m in app.get("/api/members", user="ada").json["items"])
+    paid = app.get("/api/loans?fine_paid=true", user="ada").json["items"]
