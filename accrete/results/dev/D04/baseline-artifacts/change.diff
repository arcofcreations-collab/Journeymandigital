+-- Late-return fines: the fine itself is derived from due_at/returned_at; only whether it was
+-- paid is stored. Loans already returned late are treated as settled, so nobody owes anything
+-- when fines are introduced; every other existing loan starts unpaid.
+
+ALTER TABLE loans ADD COLUMN fine_paid INTEGER NOT NULL DEFAULT 0 CHECK (fine_paid IN (0, 1));
+
+UPDATE loans SET fine_paid = 1 WHERE returned_at IS NOT NULL AND date(returned_at) > due_at;
