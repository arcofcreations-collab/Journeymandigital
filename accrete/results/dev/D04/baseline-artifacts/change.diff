+def test_pay_fine_permissions_conflicts_and_precedence(app):
+    app.post("/api/loans/46/return", {}, user="jo", now=T1)
+    assert app.post("/api/loans/999/pay_fine", {}, user="ada").status == 404
+    assert app.post("/api/loans/46/pay_fine", {}, user="jo").status == 403  # members cannot, even their own
+    assert app.post("/api/loans/52/pay_fine", {}, user="jo").status == 403  # 403 beats 409
+    assert app.post("/api/loans/52/pay_fine", {}, user="ada").status == 409  # not returned
+    assert app.post("/api/loans/1/pay_fine", {}, user="ada").status == 409  # no fine
+    assert app.post("/api/loans/2/pay_fine", {}, user="ada").status == 409  # settled by the migration
+    assert app.post("/api/loans/1/pay_fine", {"amount": 1}, user="ada").status == 409  # 409 beats 400
+    assert app.post("/api/loans/46/pay_fine", {"amount": 1}, user="ada").status == 400
+    assert app.post("/api/loans/46/pay_fine", {}, user=None).status == 401
+    assert app.get("/api/loans/46", user="ada").json["fine_paid"] is False
+    assert _outbox(app, "fine_paid") == []
+
