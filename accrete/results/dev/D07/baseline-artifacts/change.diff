+# --- borrowing restrictions: overdue loans block borrowing; new releases lend for 7 days ---
+
+def _open_loan(app, book, now=NOW):
+    return app.get(f"/api/loans?book={book}&returned_at=null", user="ada", now=now).json["items"][0]
+
+
+def test_member_with_overdue_loan_cannot_borrow(app):
+    # gus has one open loan (47), due 2026-02-15: overdue on 2026-03-01.
+    r = app.post("/api/books/3/borrow", {}, user="gus", now=NOW)
+    assert r.status == 409 and r.json["error"] == "conflict"
+    assert app.get("/api/_outbox", user="gus").json["items"] == []
+    assert app.get("/api/books/3", user="gus").json["status"] == "available"
+
+
+def test_loan_due_today_does_not_block(app):
+    # chen's loan 52 is due 2026-03-04: not overdue that day, overdue the next.
+    assert app.post("/api/books/3/borrow", {}, user="chen", now="2026-03-04T23:59:59").status == 200
+    assert app.post("/api/books/2/borrow", {}, user="chen", now="2026-03-05T00:00:00").status == 409
+
+
+def test_returning_overdue_loans_lifts_the_block(app):
+    # ivan has loan 48 (overdue) and 55 (due 2026-03-04, not yet overdue).
+    assert app.post("/api/books/3/borrow", {}, user="ivan", now=NOW).status == 409
+    assert app.post("/api/loans/48/return", {}, user="ivan", now=NOW).status == 200  # returns never blocked
+    assert app.post("/api/books/3/borrow", {}, user="ivan", now=NOW).status == 200
+
+
+def test_returning_one_of_several_overdue_loans_keeps_the_block(app):
+    # jo has loans 46 and 50 (both overdue) and 57.
+    assert app.post("/api/loans/46/return", {}, user="jo", now=NOW).status == 200
+    assert app.post("/api/books/3/borrow", {}, user="jo", now=NOW).status == 409
+    assert app.post("/api/loans/50/return", {}, user="ada", now=NOW).status == 200
+    assert app.post("/api/books/3/borrow", {}, user="jo", now=NOW).status == 200
+
+
+def test_librarian_cannot_lend_to_member_with_overdue_loan(app):
+    assert app.post("/api/books/3/borrow", {"member": 7}, user="ada", now=NOW).status == 409
+    assert app.post("/api/books/4/borrow", {"member": 7}, user="ada", now=NOW).status == 409  # also on loan
+    assert app.post("/api/books/3/borrow", {"member": 3}, user="ada", now=NOW).status == 200
+    assert app.post("/api/books/2/borrow", {"member": 7}, user="eli", now=NOW).status == 403  # 403 beats 409
+
+
+def test_new_releases_are_lent_for_seven_days(app):
+    for year, isbn in ((2026, "978-9-0000-001-1"), (2025, "978-9-0000-002-2"), (2024, "978-9-0000-003-3")):
+        r = app.post("/api/books", {"title": f"Fresh {year}", "author": "N. Ew", "isbn": isbn, "year": year},
+                     user="ada")
+        assert r.status == 201
+    assert app.post("/api/books/41/borrow", {}, user="chen", now=NOW).status == 200  # 2026
+    assert app.post("/api/books/42/borrow", {"member": 4}, user="ada", now=NOW).status == 200  # 2025
+    assert app.post("/api/books/43/borrow", {}, user="eli", now=NOW).status == 200  # 2024: not new
+    assert _open_loan(app, 41)["due_at"] == "2026-03-08"
+    assert _open_loan(app, 42)["due_at"] == "2026-03-08"
+    assert _open_loan(app, 43)["due_at"] == "2026-03-15"
+    assert app.get("/api/_outbox", user="ada").json["items"][0]["payload"] == {"loan": 61, "book": 41, "member": 3}
+
+
+def test_new_release_window_follows_x_now_year(app):
+    # On 2025-12-31 books from 2024 and 2025 are new releases; book 32 is from 2024.
+    assert app.post("/api/books/32/borrow", {}, user="chen", now="2025-12-31T23:00:00").status == 200
+    assert _open_loan(app, 32, "2025-12-31T23:00:00")["due_at"] == "2026-01-07"
