+def loan_period(book, today):
+    """New releases (published this year or last year) are lent for 7 days, all others for 14."""
+    year = book["year"]
+    if year is not None and today.year - 1 <= year <= today.year:
+        return NEW_RELEASE_LOAN_PERIOD
+    return LOAN_PERIOD
+
+
+def _may_borrow(member, today):
+    try:
+        _ensure_may_borrow(member, today)
+    except Conflict:
+        return False
+    return True
+
