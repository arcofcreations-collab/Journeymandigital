+    assert app.post("/api/books/33/borrow", {}, user="dara", now=NOW).status == 200
+    assert app.post("/api/books/25/borrow", {}, user="eli", now=NOW).status == 200
+    assert _open_loan(app, 33)["due_at"] == "2026-03-15"
+    assert _open_loan(app, 25)["due_at"] == "2026-03-15"
+
+
