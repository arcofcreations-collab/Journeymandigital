--- a/tests/test_library_renewals.py
+++ b/tests/test_library_renewals.py
@@ -0,0 +1,119 @@
+"""Loan renewals: +14 days from the current due date, at most twice, never overdue or with someone waiting."""
+from accept_client import parse_ui
+
+# Loan 52: chen (member 3) has book 22, due 2026-03-04. Loan 46: jo has book 4, overdue since 2026-02-15.
+# Loan 1 is dara's, already returned.
+T1, DUE, AFTER = "2026-03-01T10:00:00", "2026-03-04T23:59:59", "2026-03-05T00:00:00"
+
+
+def _outbox(app, channel=None):
+    items = app.get("/api/_outbox", user="ada").json["items"]
+    return [m for m in items if channel is None or m["channel"] == channel]
+
+
+def test_borrower_renews_loan(app):
+    r = app.post("/api/loans/52/renew", {}, user="chen", now=T1)
+    assert r.status == 200
+    assert r.json == {"id": 52, "book": 22, "member": 3, "borrowed_at": "2026-02-18T16:00:00",
+                      "due_at": "2026-03-18", "returned_at": None, "renewals": 1, "overdue": False}
+    assert _outbox(app) == [{"id": 1, "channel": "loan_renewed", "payload": {"loan": 52, "due_at": "2026-03-18"},
+                             "created_at": T1}]
+
+
+def test_new_loans_start_with_no_renewals(app):
+    app.post("/api/books/3/borrow", {}, user="chen", now=T1)
+    assert app.get("/api/loans/61", user="chen").json["renewals"] == 0
+    assert [l["id"] for l in app.get("/api/loans?renewals=0&member=3", user="ada").json["items"]][-1] == 61
+
+
+def test_renewal_extends_from_due_date_and_is_limited_to_two(app):
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=T1).json["due_at"] == "2026-03-18"
+    r = app.post("/api/loans/52/renew", {}, user="ada", now=T1)  # a librarian may renew too
+    assert r.status == 200 and r.json["due_at"] == "2026-04-01" and r.json["renewals"] == 2
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=T1).status == 409
+    assert app.get("/api/loans/52", user="chen").json["due_at"] == "2026-04-01"
+    assert [m["payload"]["due_at"] for m in _outbox(app)] == ["2026-03-18", "2026-04-01"]
+    assert app.get("/api/loans?renewals=2", user="ada").json["items"][0]["id"] == 52
+
+
+def test_renewing_on_the_due_date_is_allowed_but_not_after(app):
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=AFTER).status == 409
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=DUE).status == 200
+    assert app.post("/api/loans/46/renew", {}, user="jo", now=T1).status == 409  # overdue
+    assert len(_outbox(app)) == 1
+
+
+def test_overdue_uses_the_extended_due_date(app):
+    app.post("/api/loans/52/renew", {}, user="chen", now=T1)
+    assert app.get("/api/loans/52", user="chen", now="2026-03-10T00:00:00").json["overdue"] is False
+    assert app.get("/api/loans/52", user="chen", now="2026-03-18T23:59:59").json["overdue"] is False
+    assert app.get("/api/loans/52", user="chen", now="2026-03-19T00:00:00").json["overdue"] is True
+    assert app.post("/api/loans/52/renew", {}, user="chen", now="2026-03-10T00:00:00").status == 200
+    assert app.get("/api/loans/52", user="chen", now="2026-03-19T00:00:00").json["overdue"] is False
+
+
+def test_returned_loan_cannot_be_renewed(app):
+    assert app.post("/api/loans/1/renew", {}, user="dara").status == 409
+    app.post("/api/loans/52/return", {}, user="chen", now=T1)
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=T1).status == 409
+
+
+def test_waiting_hold_blocks_renewal_and_is_untouched(app):
+    app.post("/api/books/22/hold", {}, user="dara", now=T1)
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=T1).status == 409
+    assert app.post("/api/loans/52/renew", {}, user="ada", now=T1).status == 409
+    assert app.get("/api/loans/52", user="chen").json["due_at"] == "2026-03-04"
+    assert _outbox(app) == []
+    app.post("/api/holds/1/cancel", {}, user="dara")
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=T1).status == 200
+    assert app.get("/api/holds/1", user="dara").json["status"] == "cancelled"
+
+
+def test_renewal_does_not_change_holds(app):
+    app.post("/api/books/4/hold", {}, user="chen", now=T1)  # a hold on another book
+    assert app.post("/api/loans/52/renew", {}, user="chen", now=T1).status == 200
+    assert app.get("/api/holds", user="ada").json["items"] == [
+        {"id": 1, "book": 4, "member": 3, "placed_at": T1, "status": "waiting", "ready_at": None}]
+
+
+def test_renew_permissions_and_precedence(app):
+    assert app.post("/api/loans/52/renew", {}, user="dara", now=T1).status == 403
+    assert app.post("/api/loans/46/renew", {}, user="dara", now=T1).status == 403  # 403 beats 409
+    assert app.post("/api/loans/999/renew", {}, user="dara", now=T1).status == 404
+    assert app.post("/api/loans/46/renew", {"days": 7}, user="ada", now=T1).status == 409  # 409 beats 400
+    assert app.post("/api/loans/52/renew", {"days": 7}, user="chen", now=T1).status == 400
+    assert app.post("/api/loans/52/renew", None, user=None, now=T1).status == 401
+    assert app.get("/api/loans/52", user="chen").json["renewals"] == 0
+    assert _outbox(app) == []
+
+
+def test_loans_still_cannot_be_patched(app):
+    assert app.patch("/api/loans/52", {"renewals": 2}, user="ada").status == 403
+    assert app.patch("/api/loans/52", {"due_at": "2030-01-01"}, user="chen").status == 403
+
+
+def test_loan_page_shows_renew_form_only_when_allowed(app):
+    page = parse_ui(app.get("/ui/loans/52", user="chen", now=T1).text)
+    assert page.fields["renewals"] == "0" and page.actions == ["return", "renew"]
+    assert parse_ui(app.get("/ui/loans/52", user="ada", now=T1).text).actions == ["return", "renew"]
+    assert parse_ui(app.get("/ui/loans/52", user="chen", now=AFTER).text).actions == ["return"]  # overdue
+    assert parse_ui(app.get("/ui/loans/46", user="jo", now=T1).text).actions == ["return"]  # overdue
+    assert parse_ui(app.get("/ui/loans/1", user="ada", now=T1).text).actions == []  # returned
+    app.post("/api/books/22/hold", {}, user="dara", now=T1)
+    assert parse_ui(app.get("/ui/loans/52", user="chen", now=T1).text).actions == ["return"]  # someone waiting
+    app.post("/api/holds/1/cancel", {}, user="dara")
+    app.post("/api/loans/52/renew", {}, user="chen", now=T1)
+    app.post("/api/loans/52/renew", {}, user="chen", now=T1)
+    page = parse_ui(app.get("/ui/loans/52", user="chen", now=T1).text)
+    assert page.fields["renewals"] == "2" and page.fields["due_at"] == "2026-04-01"
+    assert page.actions == ["return"]  # renewed twice
+
+
+def test_renew_form_posts_through_service(app):
+    from test_library_ui import _post_form
+
+    code, headers, _ = _post_form(app, "/ui/loans/52/renew", {}, "chen")
+    assert code == 303 and headers["Location"].endswith("/ui/loans/52")
+    assert app.get("/api/loans/52", user="chen").json["due_at"] == "2026-03-18"
+    assert _post_form(app, "/ui/loans/52/renew", {}, "dara")[0] == 403
+    assert _post_form(app, "/ui/loans/1/renew", {}, "dara")[0] == 409
