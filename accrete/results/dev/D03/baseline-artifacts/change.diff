+    if loan["renewals"] >= MAX_RENEWALS:
+        return f"A loan can be renewed at most {MAX_RENEWALS} times."
+    if repository.book_has_waiting_hold(loan["book"]):
+        return "Another member is waiting for this book."
+    return None
 
 
