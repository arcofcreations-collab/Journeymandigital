+def renew_loan(ctx, loan_id, params):
+    """Extend an open loan's due date by ``RENEWAL_PERIOD`` (from the current due date)."""
+    with transaction():
+        loan = _load_loan(loan_id)
+        if not permissions.can_renew_loan(ctx.user, loan):
+            raise Forbidden("Only the borrower or a librarian can renew a loan.")
+        refusal = _renewal_refusal(ctx, loan)
+        if refusal:
+            raise Conflict(refusal)
+        validation.clean_no_params(params)
+        due_at = (date.fromisoformat(loan["due_at"]) + RENEWAL_PERIOD).isoformat()
+        repository.renew_loan(loan_id, due_at)
+        repository.add_outbox_message("loan_renewed", {"loan": loan_id, "due_at": due_at}, ctx.now_text)
+    return present_loan(ctx, repository.get_loan(loan_id))
+
+
