+# --- migration 0002 ----------------------------------------------------------------------
+
+def _write_pre_authors_database(workdir):
+    """Replace the instance's database with one at schema version 1 (free-text authors)."""
+    path = os.path.join(workdir, "data.db")
+    os.remove(path)
+    conn = sqlite3.connect(path)
+    with open(os.path.join(workdir, "library_app", "migrations", "0001_initial.sql"), encoding="utf-8") as fh:
+        conn.executescript(fh.read())
+    conn.executescript(
+        "CREATE TABLE schema_version (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL);"
+        "INSERT INTO schema_version VALUES (1, 'initial', '2026-01-01T00:00:00');"
+        "INSERT INTO members (id, username, name, role, active) VALUES"
+        " (1, 'ada', 'Ada', 'librarian', 1), (2, 'bo', 'Bo', 'member', 1);"
+        # Inserted out of id order; first appearance by id is Zed (1), Abe (2), abe (5), Mia (7).
+        "INSERT INTO books (id, title, author, isbn, year) VALUES"
+        " (7, 'G', 'Mia', 'i7', NULL), (2, 'B', 'Abe', 'i2', 2001), (1, 'A', 'Zed', 'i1', 2000),"
+        " (3, 'C', 'Zed', 'i3', NULL), (5, 'E', 'abe', 'i5', 2005), (6, 'F', 'Abe', 'i6', 2006),"
+        " (9, 'X', 'Gone', 'i9', NULL);"
+        "DELETE FROM books WHERE id = 9;"  # its id must not be reused, and 'Gone' is no author
+        "INSERT INTO loans (id, book_id, member_id, borrowed_at, due_at, returned_at) VALUES"
+        " (1, 3, 2, '2026-01-02T10:00:00', '2026-01-16', '2026-01-10T10:00:00'),"
+        " (2, 3, 2, '2026-02-20T10:00:00', '2026-03-06', NULL);"
+    )
+    conn.commit()
+    conn.close()
+
+
+def test_migration_turns_author_texts_into_author_records(app):
+    _write_pre_authors_database(app.workdir)
+    migrated = fresh_app(app.workdir)
+
+    assert migrated.get("/api/authors", user="bo").json["items"] == [
+        {"id": 1, "name": "Zed", "book_count": 2},
+        {"id": 2, "name": "Abe", "book_count": 2},
+        {"id": 3, "name": "abe", "book_count": 1},
+        {"id": 4, "name": "Mia", "book_count": 1},
+    ]
+    books = migrated.get("/api/books", user="bo").json["items"]
+    assert [(b["id"], b["title"], b["author"], b["author_name"], b["isbn"], b["year"], b["status"]) for b in books] == [
+        (1, "A", 1, "Zed", "i1", 2000, "available"),
+        (2, "B", 2, "Abe", "i2", 2001, "available"),
+        (3, "C", 1, "Zed", "i3", None, "on_loan"),
+        (5, "E", 3, "abe", "i5", 2005, "available"),
+        (6, "F", 2, "Abe", "i6", 2006, "available"),
+        (7, "G", 4, "Mia", "i7", None, "available"),
+    ]
+    loans = migrated.get("/api/loans", user="ada").json["items"]
+    assert [(l["id"], l["book"], l["member"], l["returned_at"]) for l in loans] == [
+        (1, 3, 2, "2026-01-10T10:00:00"), (2, 3, 2, None),
+    ]
+    # Loan rules still hold on the rebuilt tables, and AUTOINCREMENT counters survived.
+    assert migrated.post("/api/books/3/borrow", {}, user="bo").status == 409
+    assert migrated.post("/api/books", {"title": "N", "author": 4, "isbn": "i10"}, user="ada").json["id"] == 10
+    assert migrated.post("/api/authors", {"name": "New"}, user="ada").json["id"] == 5
+    assert migrated.delete("/api/books/3", user="ada").status == 409
+
+    conn = sqlite3.connect(os.path.join(migrated.workdir, "data.db"))
+    assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+    assert [r[0] for r in conn.execute("SELECT version FROM schema_version ORDER BY version")][:2] == [1, 2]
+    conn.close()
