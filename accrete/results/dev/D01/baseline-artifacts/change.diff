--- a/tests/test_library_authors.py
+++ b/tests/test_library_authors.py
@@ -0,0 +1,150 @@
+"""Authors: records referenced by books, derived book_count, librarian-only management,
+and the 0002 migration that turned free-text book authors into author records."""
+import os
+import sqlite3
+
+from accept_client import fresh_app, parse_ui
+
+# Authors created from the seed books, in order of first appearance by book id.
+SEED_AUTHORS = ["M. Reyes", "T. Okoye", "S. Lindqvist", "R. Banerjee", "J. Moreau", "K. Tanaka"]
+
+
+def test_any_user_reads_authors_with_book_count(app, seed):
+    authors = app.get("/api/authors", user="lena").json["items"]
+    assert [a["name"] for a in authors] == SEED_AUTHORS
+    assert [a["id"] for a in authors] == [1, 2, 3, 4, 5, 6]
+    for author in authors:
+        assert author["book_count"] == sum(b["author"] == author["id"] for b in seed["books"])
+    assert sum(a["book_count"] for a in authors) == 40
+    assert app.get("/api/authors/2", user="chen").json == authors[1]
+    assert app.get("/api/authors/999", user="chen").status == 404
+    assert app.get("/api/authors").status == 401
+
+
+def test_author_filters(app):
+    assert [a["id"] for a in app.get("/api/authors?name=K. Tanaka", user="chen").json["items"]] == [6]
+    assert app.get("/api/authors?colour=red", user="chen").status == 400
+
+
+def test_librarian_creates_updates_and_deletes_author(app):
+    r = app.post("/api/authors", {"name": "U. Le Guin"}, user="ada")
+    assert r.status == 201 and r.json == {"id": 7, "name": "U. Le Guin", "book_count": 0}
