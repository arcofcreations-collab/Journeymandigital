--- a/library_app/migrations/0002_authors.sql
+++ b/library_app/migrations/0002_authors.sql
@@ -0,0 +1,70 @@
+-- Authors become records: books.author (free text) -> books.author_id (reference to authors).
+--
+-- Every distinct author text becomes one author whose name is that text. Author ids are
+-- 1, 2, 3, ... in order of first appearance when books are read in ascending id order.
+-- Book, loan, member and outbox data is otherwise unchanged (ids included).
+
+CREATE TABLE authors (
+    id   INTEGER PRIMARY KEY AUTOINCREMENT,
+    name TEXT    NOT NULL UNIQUE
+);
+
+INSERT INTO authors (id, name)
+SELECT ROW_NUMBER() OVER (ORDER BY MIN(id)), author
+FROM books
+GROUP BY author;
+
+-- SQLite cannot change a column's type/constraints in place, so books is rebuilt
+-- (create-copy-drop-rename). Foreign keys are enforced and cannot be switched off inside
+-- the migration's transaction, so loans (which references books) is set aside first and
+-- recreated afterwards. AUTOINCREMENT counters are preserved so ids are never reused.
+
+CREATE TEMP TABLE saved_sequence AS
+SELECT name, seq FROM sqlite_sequence WHERE name IN ('books', 'loans');
+
+CREATE TEMP TABLE saved_loans AS
+SELECT id, book_id, member_id, borrowed_at, due_at, returned_at FROM loans;
+
+DROP TABLE loans;
+
+CREATE TABLE books_new (
+    id        INTEGER PRIMARY KEY AUTOINCREMENT,
+    title     TEXT    NOT NULL,
+    author_id INTEGER NOT NULL REFERENCES authors (id),
+    isbn      TEXT    NOT NULL UNIQUE,
+    year      INTEGER
+);
+
+INSERT INTO books_new (id, title, author_id, isbn, year)
+SELECT b.id, b.title, a.id, b.isbn, b.year
+FROM books b JOIN authors a ON a.name = b.author
+ORDER BY b.id;
+
+DROP TABLE books;
+ALTER TABLE books_new RENAME TO books;
+
+CREATE INDEX books_author_id ON books (author_id);
+
+CREATE TABLE loans (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    book_id     INTEGER NOT NULL REFERENCES books (id),
+    member_id   INTEGER NOT NULL REFERENCES members (id),
+    borrowed_at TEXT    NOT NULL,  -- YYYY-MM-DDTHH:MM:SS (UTC)
+    due_at      TEXT    NOT NULL,  -- YYYY-MM-DD
+    returned_at TEXT               -- YYYY-MM-DDTHH:MM:SS (UTC) or NULL while on loan
+);
+
+INSERT INTO loans (id, book_id, member_id, borrowed_at, due_at, returned_at)
+SELECT id, book_id, member_id, borrowed_at, due_at, returned_at FROM saved_loans ORDER BY id;
+
+CREATE INDEX loans_book_id ON loans (book_id);
+CREATE INDEX loans_member_id ON loans (member_id);
+-- A book can be on loan to at most one member at a time.
+CREATE UNIQUE INDEX loans_one_open_loan_per_book ON loans (book_id) WHERE returned_at IS NULL;
+
+UPDATE sqlite_sequence
+SET seq = MAX(seq, (SELECT s.seq FROM saved_sequence s WHERE s.name = sqlite_sequence.name))
+WHERE name IN (SELECT name FROM saved_sequence);
+
+DROP TABLE saved_loans;
+DROP TABLE saved_sequence;
