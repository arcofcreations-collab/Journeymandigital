+-- Allow a third staff role, 'assistant', in members.role.
+--
+-- SQLite cannot change a CHECK constraint in place, so members is rebuilt
+-- (create-copy-drop-rename). Foreign-key enforcement is on and cannot be switched off
+-- inside the migration's transaction, so loans (the only table referencing members) is
+-- rebuilt alongside it and dropped first (its reference to members_new follows the rename
+-- back to members). Every row, id and AUTOINCREMENT counter is kept.
+
+CREATE TABLE members_new (
+    id       INTEGER PRIMARY KEY AUTOINCREMENT,
+    username TEXT    NOT NULL UNIQUE,
+    name     TEXT    NOT NULL,
+    role     TEXT    NOT NULL CHECK (role IN ('member', 'librarian', 'assistant')),
+    active   INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1))
+);
+INSERT INTO members_new (id, username, name, role, active)
+    SELECT id, username, name, role, active FROM members;
+
+CREATE TABLE loans_new (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    book_id     INTEGER NOT NULL REFERENCES books (id),
+    member_id   INTEGER NOT NULL REFERENCES members_new (id),
+    borrowed_at TEXT    NOT NULL,  -- YYYY-MM-DDTHH:MM:SS (UTC)
+    due_at      TEXT    NOT NULL,  -- YYYY-MM-DD
+    returned_at TEXT               -- YYYY-MM-DDTHH:MM:SS (UTC) or NULL while on loan
+);
+INSERT INTO loans_new (id, book_id, member_id, borrowed_at, due_at, returned_at)
+    SELECT id, book_id, member_id, borrowed_at, due_at, returned_at FROM loans;
+
+-- Keep the AUTOINCREMENT high-water marks, so ids of deleted rows are never reused.
+UPDATE sqlite_sequence SET seq = max(seq, (SELECT seq FROM sqlite_sequence WHERE name = 'members'))
+    WHERE name = 'members_new' AND EXISTS (SELECT 1 FROM sqlite_sequence WHERE name = 'members');
+UPDATE sqlite_sequence SET seq = max(seq, (SELECT seq FROM sqlite_sequence WHERE name = 'loans'))
+    WHERE name = 'loans_new' AND EXISTS (SELECT 1 FROM sqlite_sequence WHERE name = 'loans');
+
+DROP TABLE loans;
+DROP TABLE members;
+ALTER TABLE members_new RENAME TO members;
+ALTER TABLE loans_new RENAME TO loans;
+
+CREATE INDEX loans_book_id ON loans (book_id);
+CREATE INDEX loans_member_id ON loans (member_id);
+-- A book can be on loan to at most one member at a time.
+CREATE UNIQUE INDEX loans_one_open_loan_per_book ON loans (book_id) WHERE returned_at IS NULL;
