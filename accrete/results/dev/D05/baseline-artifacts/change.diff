@@ -0,0 +1,218 @@
+"""Assistants: desk staff who handle lending but not the catalogue or membership."""
+import os
+import shutil
+import sqlite3
+
+import pytest
+
+from accept_client import fresh_app, parse_ui
+
+NOW = "2026-03-01T10:00:00"
+
+
+@pytest.fixture
+def staffed(app):
+    """The seed plus an assistant, ``asa`` (id 13), created by a librarian."""
+    r = app.post("/api/members", {"username": "asa", "name": "Asa Desk", "role": "assistant"}, user="ada")
+    assert r.status == 201
+    assert r.json == {"id": 13, "username": "asa", "name": "Asa Desk", "role": "assistant", "active": True}
+    return app
+
+
+def _add_assistant(app, username, user="ada"):
+    return app.post("/api/members", {"username": username, "name": username.title(), "role": "assistant"}, user=user)
+
+
+# --- role value -------------------------------------------------------------------------
+
+def test_role_accepts_assistant_and_nothing_else_new(app):
+    assert _add_assistant(app, "asa").status == 201
+    assert app.post("/api/members", {"username": "q", "name": "Q", "role": "admin"}, user="ada").status == 400
+    assert app.patch("/api/members/4", {"role": "assistant"}, user="ada").json["role"] == "assistant"
+    assert app.patch("/api/members/4", {"role": "clerk"}, user="ada").status == 400
+    assert [m["id"] for m in app.get("/api/members?role=assistant", user="ada").json["items"]] == [4, 13]
+
+
+def test_only_librarians_create_assistants_or_change_roles(staffed):
+    app = staffed
+    assert _add_assistant(app, "x", user="asa").status == 403
+    assert _add_assistant(app, "y", user="chen").status == 403
+    assert app.patch("/api/members/3", {"role": "assistant"}, user="asa").status == 403
+    assert app.patch("/api/members/13", {"role": "librarian"}, user="asa").status == 403
+    assert app.patch("/api/members/3", {"role": "assistant"}, user="chen").status == 403
+    assert app.get("/api/members/3", user="ada").json["role"] == "member"
+
+
+def test_new_assistant_can_authenticate(staffed):
+    assert staffed.get("/api/books", user="asa").status == 200
+
+
+# --- reading ----------------------------------------------------------------------------
+
+def test_assistant_reads_everything(staffed):
+    app = staffed
+    assert len(app.get("/api/members", user="asa").json["items"]) == 13
+    assert app.get("/api/members/1", user="asa").json["role"] == "librarian"
+    assert len(app.get("/api/loans", user="asa").json["items"]) == 60
+    assert app.get("/api/loans/46", user="asa").status == 200
+    assert len(app.get("/api/books", user="asa").json["items"]) == 40
+    assert parse_ui(app.get("/ui/members", user="asa").text).rows == list(range(1, 14))
+    assert len(parse_ui(app.get("/ui/loans", user="asa").text).rows) == 60
+
+
+# --- lending ----------------------------------------------------------------------------
+
+def test_assistant_lends_to_member(staffed):
+    app = staffed
+    r = app.post("/api/books/3/borrow", {"member": 5}, user="asa", now=NOW)
+    assert r.status == 200 and r.json["status"] == "on_loan"
+    assert app.get("/api/loans/61", user="eli").json == {
+        "id": 61, "book": 3, "member": 5, "borrowed_at": NOW, "due_at": "2026-03-15",
+        "returned_at": None, "overdue": False}
+    assert app.get("/api/_outbox", user="asa").json["items"][0]["payload"] == {"loan": 61, "book": 3, "member": 5}
+
+
+def test_assistant_lending_follows_borrow_rules(staffed):
+    app = staffed
+    assert app.post("/api/books/4/borrow", {"member": 3}, user="asa").status == 409  # on loan
+    assert app.post("/api/books/3/borrow", {"member": 12}, user="asa").status == 409  # inactive
+    assert app.post("/api/books/3/borrow", {"member": 10}, user="asa").status == 409  # 3 open loans
+    assert app.post("/api/books/3/borrow", {"member": 999}, user="asa").status == 400
+    assert app.post("/api/books/4/borrow", {"member": 999}, user="asa").status == 409  # 409 beats 400
+    assert app.get("/api/_outbox", user="asa").json["items"] == []
+
+
+def test_assistant_returns_any_loan(staffed):
+    app = staffed
+    r = app.post("/api/loans/52/return", {}, user="asa", now=NOW)
+    assert r.status == 200 and r.json["returned_at"] == NOW
+    assert app.post("/api/loans/52/return", {}, user="asa").status == 409
+    assert app.post("/api/loans/999/return", {}, user="asa").status == 404
+
+
+def test_assistant_cannot_touch_loans_directly(staffed):
+    app = staffed
+    assert app.post("/api/loans", {"book": 3, "member": 3}, user="asa").status == 403
+    assert app.patch("/api/loans/52", {"due_at": "2030-01-01"}, user="asa").status == 403
+    assert app.delete("/api/loans/52", user="asa").status == 403
+    assert app.patch("/api/loans/999", {}, user="asa").status == 404
+
+
+# --- members ----------------------------------------------------------------------------
+
+def test_assistant_toggles_active_on_ordinary_members(staffed):
+    app = staffed
+    r = app.patch("/api/members/3", {"active": False}, user="asa")
+    assert r.status == 200 and r.json["active"] is False
+    assert app.post("/api/books/3/borrow", {}, user="chen").status == 409  # now inactive
+    assert app.patch("/api/members/12", {"active": True}, user="asa").json["active"] is True
+    assert app.patch("/api/members/12", {"active": "yes"}, user="asa").status == 400
+
+
+def test_assistant_member_patch_limits(staffed):
+    app = staffed
+    assert _add_assistant(app, "bo").status == 201  # id 14
+    before = app.get("/api/members", user="ada").json["items"]
+    assert app.patch("/api/members/3", {"active": False, "name": "Chen"}, user="asa").status == 403
+    assert app.patch("/api/members/3", {"name": "Chen"}, user="asa").status == 403
+    assert app.patch("/api/members/3", {"role": "librarian"}, user="asa").status == 403
+    assert app.patch("/api/members/1", {"active": False}, user="asa").status == 403  # librarian
+    assert app.patch("/api/members/14", {"active": False}, user="asa").status == 403  # other assistant
+    assert app.patch("/api/members/14", ["not", "an", "object"], user="asa").status == 403  # 403 beats 400
+    assert app.patch("/api/members/99", {"active": False}, user="asa").status == 404
+    assert app.get("/api/members", user="ada").json["items"] == before
+
+
+def test_assistant_edits_only_own_name(staffed):
+    app = staffed
+    r = app.patch("/api/members/13", {"name": "Asa D."}, user="asa")
+    assert r.status == 200 and r.json["name"] == "Asa D." and r.json["role"] == "assistant"
+    assert app.patch("/api/members/13", {"active": False}, user="asa").status == 403
+    assert app.patch("/api/members/13", {"role": "librarian"}, user="asa").status == 403
+    assert app.patch("/api/members/13", {"name": ""}, user="asa").status == 400
+    assert app.get("/api/members/13", user="asa").json["active"] is True
+
+
+def test_assistant_cannot_create_or_delete_members(staffed):
+    app = staffed
+    assert app.post("/api/members", {"username": "x", "name": "X", "role": "member"}, user="asa").status == 403
+    assert app.post("/api/members", {}, user="asa").status == 403
+    assert app.delete("/api/members/11", user="asa").status == 403
+    assert app.delete("/api/members/99", user="asa").status == 404
+
+
+def test_librarians_and_members_keep_their_permissions_over_assistants(staffed):
+    app = staffed
+    assert app.patch("/api/members/13", {"active": False, "role": "member"}, user="ada").status == 200
+    assert app.get("/api/members/13", user="chen").status == 403
+    assert app.patch("/api/members/13", {"active": True}, user="chen").status == 403
+
+
+# --- books ------------------------------------------------------------------------------
+
+def test_assistant_cannot_manage_books(staffed):
+    app = staffed
+    book = {"title": "Dune", "author": "F. Herbert", "isbn": "978-0441013593", "year": 1965}
+    assert app.post("/api/books", book, user="asa").status == 403
+    assert app.patch("/api/books/1", {"title": "X"}, user="asa").status == 403
+    assert app.delete("/api/books/2", user="asa").status == 403
+    assert app.get("/api/books/1", user="asa").json["title"] != "X"
+
+
+# --- UI ---------------------------------------------------------------------------------
+
+def test_assistant_create_pages_are_forbidden(staffed):
+    for path in ("/ui/books/new", "/ui/members/new", "/ui/loans/new"):
+        assert staffed.get(path, user="asa").status == 403
+
+
+def test_assistant_sees_borrow_and_return_forms(staffed):
+    app = staffed
+    page = parse_ui(app.get("/ui/books/2", user="asa").text)
+    assert page.actions == ["borrow"] and "member" in page.inputs
+    assert parse_ui(app.get("/ui/books/4", user="asa").text).actions == []  # on loan
+    assert parse_ui(app.get("/ui/loans/52", user="asa").text).actions == ["return"]  # chen's
+    assert parse_ui(app.get("/ui/loans/46", user="asa").text).actions == ["return"]
+    assert parse_ui(app.get("/ui/loans/1", user="asa").text).actions == []  # returned
+
+
+def test_member_create_form_offers_assistant_role(app):
+    assert 'value="assistant"' in app.get("/ui/members/new", user="ada").text
+
+
+# --- migration --------------------------------------------------------------------------
+
+def test_migration_keeps_existing_data(app, tmp_path):
+    """A database still at version 1 is upgraded on startup without losing anything."""
+    old = str(tmp_path / "v1")
+    shutil.copytree(app.workdir, old)
+    db_path = os.path.join(old, "data.db")
+    os.remove(db_path)
+    with open(os.path.join(old, "library_app", "migrations", "0001_initial.sql"), encoding="utf-8") as fh:
+        initial = fh.read()
+    conn = sqlite3.connect(db_path)
+    conn.executescript(initial)
+    conn.executescript(
+        "CREATE TABLE schema_version (version INTEGER PRIMARY KEY, name TEXT NOT NULL, applied_at TEXT NOT NULL);"
+        "INSERT INTO schema_version VALUES (1, 'initial', '2026-01-01T00:00:00');"
+        "INSERT INTO members VALUES (1, 'ada', 'Ada', 'librarian', 1), (2, 'chen', 'Chen', 'member', 1),"
+        " (3, 'gone', 'Gone', 'member', 1);"
+        "INSERT INTO books VALUES (1, 'T', 'A', 'I-1', NULL);"
+        "INSERT INTO loans VALUES (1, 1, 2, '2026-02-01T10:00:00', '2026-02-15', NULL);"
+        "DELETE FROM members WHERE id = 3;"
+    )
+    conn.close()
+
+    upgraded = fresh_app(old)
+    assert upgraded.get("/api/members", user="ada").json["items"] == [
+        {"id": 1, "username": "ada", "name": "Ada", "role": "librarian", "active": True},
+        {"id": 2, "username": "chen", "name": "Chen", "role": "member", "active": True}]
+    assert upgraded.get("/api/loans/1", user="chen").json["member"] == 2
+    assert upgraded.get("/api/books/1", user="chen").json["status"] == "on_loan"
+    r = upgraded.post("/api/members", {"username": "asa", "name": "Asa", "role": "assistant"}, user="ada")
+    assert r.status == 201 and r.json["id"] == 4  # AUTOINCREMENT never reuses the deleted id 3
+    assert upgraded.post("/api/loans/1/return", {}, user="asa").status == 200
+    conn = sqlite3.connect(os.path.join(upgraded.workdir, "data.db"))
+    assert conn.execute("PRAGMA foreign_key_check").fetchall() == []
+    assert 2 in [row[0] for row in conn.execute("SELECT version FROM schema_version")]
+    conn.close()
