+
+def distinct_record_ids(value):
+    """A non-empty list of distinct record ids."""
+    if not isinstance(value, list) or not value:
+        raise FieldInvalid("must be a non-empty list of record ids")
+    ids = [record_id(item) for item in value]
+    if len(set(ids)) != len(ids):
+        raise FieldInvalid("must not contain duplicate ids")
+    return ids
 
 
