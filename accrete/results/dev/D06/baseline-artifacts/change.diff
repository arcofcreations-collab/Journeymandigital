--- a/tests/test_library_checkout.py
+++ b/tests/test_library_checkout.py
@@ -0,0 +1,99 @@
+"""Bulk checkout at the desk: POST /api/members/{id}/checkout lends several books at once."""
+from accept_client import parse_ui
+
+NOW = "2026-03-01T10:00:00"
+# Seed: books 2, 3, 6 are available, 4 is on loan; chen (3) has 1 open loan, ivan (9) 2,
+# jo (10) 3; lena (12) is inactive. The seed has 60 loans.
+
+
+def _state(app):
+    return (app.get("/api/loans", user="ada").json["items"], app.get("/api/_outbox", user="ada").json["items"],
+            [b["status"] for b in app.get("/api/books", user="ada").json["items"]])
+
+
+def test_librarian_checks_out_books_in_list_order(app):
+    r = app.post("/api/members/3/checkout", {"books": [6, 2]}, user="ada", now=NOW)
+    assert r.status == 200
+    assert r.json == {"id": 3, "username": "chen", "name": "Chen Li", "role": "member", "active": True}
+    loans = app.get("/api/loans?returned_at=null&member=3", user="ada", now=NOW).json["items"]
+    assert loans[-2:] == [
+        {"id": 61, "book": 6, "member": 3, "borrowed_at": NOW, "due_at": "2026-03-15", "returned_at": None,
+         "overdue": False},
+        {"id": 62, "book": 2, "member": 3, "borrowed_at": NOW, "due_at": "2026-03-15", "returned_at": None,
+         "overdue": False},
+    ]
+    assert app.get("/api/_outbox", user="chen").json["items"] == [
+        {"id": 1, "channel": "loan_created", "payload": {"loan": 61, "book": 6, "member": 3}, "created_at": NOW},
+        {"id": 2, "channel": "loan_created", "payload": {"loan": 62, "book": 2, "member": 3}, "created_at": NOW},
+    ]
+    assert {app.get(f"/api/books/{b}", user="chen").json["status"] for b in (2, 6)} == {"on_loan"}
+
+
+def test_checkout_for_a_newly_created_member(app):
+    created = app.post("/api/members", {"username": "zoe", "name": "Zoe", "role": "member"}, user="ada").json
+    assert app.post(f"/api/members/{created['id']}/checkout", {"books": [2, 3, 6]}, user="ada").status == 200
+    loans = app.get("/api/loans", user="zoe").json["items"]
+    assert [l["book"] for l in loans] == [2, 3, 6]
+
+
+def test_only_librarians_may_check_out(app):
+    assert app.post("/api/members/3/checkout", {"books": [2]}, user="chen").status == 403  # for themselves
+    assert app.post("/api/members/4/checkout", {"books": [2]}, user="chen").status == 403
+    assert app.post("/api/members/12/checkout", {"books": [4]}, user="chen").status == 403  # 403 beats 409
+    assert app.post("/api/members/999/checkout", {"books": [2]}, user="chen").status == 404  # 404 beats 403
+    assert app.post("/api/members/999/checkout", {"books": [2]}, user="ada").status == 404
+
+
+def test_invalid_book_lists_are_400(app):
+    for body in ({}, {"books": []}, {"books": 2}, {"books": "2"}, {"books": [2, 2]}, {"books": [2, 999]},
+                 {"books": ["2"]}, {"books": [True]}, {"books": [2], "member": 3}, ["not", "an", "object"]):
+        r = app.post("/api/members/3/checkout", body, user="ada")
+        assert r.status == 400 and r.json["error"] == "validation", body
+
+
+def test_conflicts_are_409(app):
+    assert app.post("/api/members/12/checkout", {"books": [2]}, user="ada").status == 409  # inactive
+    assert app.post("/api/members/3/checkout", {"books": [2, 4]}, user="ada").status == 409  # 4 on loan
+    assert app.post("/api/members/3/checkout", {"books": [2, 3, 6]}, user="ada").status == 409  # 1 + 3 > 3
+    assert app.post("/api/members/10/checkout", {"books": [2]}, user="ada").status == 409  # jo has 3
+    assert app.post("/api/members/9/checkout", {"books": [2]}, user="ada").status == 200  # ivan: 2 + 1
+
+
+def test_409_beats_400(app):
+    assert app.post("/api/members/12/checkout", {}, user="ada").status == 409  # inactive, books missing
+    assert app.post("/api/members/3/checkout", {"books": [4, 999]}, user="ada").status == 409
+    assert app.post("/api/members/3/checkout", {"books": [4, 4]}, user="ada").status == 409
+    assert app.post("/api/members/9/checkout", {"books": [2, 999]}, user="ada").status == 409  # 2 + 2 > 3
+
+
+def test_failed_checkout_changes_nothing(app):
+    before = _state(app)
+    for body in ({"books": [2, 3, 4]}, {"books": [2, 999]}, {"books": [2, 3, 6]}, {"books": [2, 2]}):
+        assert app.post("/api/members/3/checkout", body, user="ada").status in (400, 409)
+    assert _state(app) == before
+
+
+def test_single_borrow_and_return_unchanged(app):
+    assert app.post("/api/members/3/checkout", {"books": [2]}, user="ada").status == 200
+    assert app.post("/api/books/3/borrow", {}, user="chen").status == 200
+    assert app.post("/api/books/6/borrow", {}, user="chen").status == 409  # now 3 open loans
+    assert app.post("/api/loans/61/return", {}, user="chen").status == 200
+    assert app.get("/api/books/2", user="chen").json["status"] == "available"
+
+
+def test_member_detail_shows_checkout_form_to_librarians(app):
+    page = parse_ui(app.get("/ui/members/3", user="ada").text)
+    assert page.actions == ["checkout"] and "books" in page.inputs
+    assert parse_ui(app.get("/ui/members/3", user="chen").text).actions == []  # not for members
+    assert parse_ui(app.get("/ui/members/10", user="ada").text).actions == []  # jo has 3 open loans
+    assert parse_ui(app.get("/ui/members/12", user="ada").text).actions == []  # inactive
+
+
+def test_checkout_form_posts_through_service(app):
+    from test_library_ui import _post_form
+
+    code, headers, _ = _post_form(app, "/ui/members/3/checkout", [("books", "6"), ("books", "2")], "ada")
+    assert code == 303 and headers["Location"].endswith("/ui/members/3")
+    assert [l["book"] for l in app.get("/api/loans?member=3&returned_at=null", user="ada").json["items"]][-2:] == [6, 2]
+    assert _post_form(app, "/ui/members/3/checkout", {}, "ada")[0] == 400
+    assert _post_form(app, "/ui/members/3/checkout", {"books": "3"}, "chen")[0] == 403
