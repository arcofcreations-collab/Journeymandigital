+def checkout_books(ctx, member_id, params):
+    """Lend every book in ``params["books"]`` to the member, in list order; all or nothing.
+
+    Librarians only. The whole request is one transaction, so any failure leaves no loan
+    and no outbox message behind.
+    """
+    with transaction():
+        member = _load_member(member_id)
+        if not permissions.can_checkout_for(ctx.user, member):
+            raise Forbidden("Only librarians can check out books for a member.")
+        _ensure_may_check_out(member, params.get("books") if isinstance(params, dict) else None)
+        book_ids = validation.clean_checkout_params(params)
+        unknown = [book_id for book_id in book_ids if repository.get_book(book_id) is None]
+        if unknown:
+            raise ValidationError("No such book.", {"books": "no such book: " + ", ".join(map(str, unknown))})
+        for book_id in book_ids:
+            _lend(ctx, book_id, member_id)
+    return repository.get_member(member_id)
+
+
+def member_actions(ctx, member):
+    """Names of the actions the caller could successfully start on ``member`` right now."""
+    if permissions.can_checkout_for(ctx.user, member) and _may_borrow(member):
+        return ["checkout"]
+    return []
+
+
+def _ensure_may_check_out(member, listed):
+    """State checks (409) for a checkout; they win over any problem with the input (400).
+
+    ``listed`` is the raw ``books`` value: only its well-formed ids of existing books are
+    checked for availability, and every entry counts towards the open-loan limit.
+    """
+    if not member["active"]:
+        raise Conflict("Inactive members cannot borrow.")
+    if not isinstance(listed, list):
+        return
+    for value in listed:
+        book = repository.get_book(value) if validation.is_record_id(value) else None
+        if book is not None and book["status"] != "available":
+            raise Conflict(f"Book {value} is not available.")
+    if repository.count_open_loans(member["id"]) + len(listed) > MAX_OPEN_LOANS:
+        raise Conflict(f"Members may have at most {MAX_OPEN_LOANS} unreturned loans.")
 
 
