+SQLITE_MAX_INTEGER = 2**63 - 1
+
+
+def is_record_id(value):
+    """An integer SQLite can look up (bools are not ids; out-of-range ints would overflow)."""
+    return isinstance(value, int) and not isinstance(value, bool) and abs(value) <= SQLITE_MAX_INTEGER
+
