+def _record_event(ctx, claim, action, to_status):
+    """Append ``action`` by the caller, now, to the claim's history (``claim`` is the record before it)."""
+    repository.add_claim_event(claim["id"], action, ctx.user["id"], ctx.now_text, claim["status"], to_status)
+
+
+# --- claim events (read-only claim history) -------------------------------------------
+
+def list_claim_events(ctx, filters=None):
+    """Events of the claims the caller may read; ``?claim=<id>`` gives one claim's history."""
+    employees = {e["id"]: e for e in repository.list_employees()}
+    claims = {c["id"]: c for c in repository.list_claims()}
+    readable = {
+        claim_id for claim_id, claim in claims.items()
+        if permissions.can_read_claim_event(ctx.user, claim, employees[claim["employee"]])
+    }
+    events = [e for e in repository.list_claim_events() if e["claim"] in readable]
+    return apply_filters(events, filters or {}, CLAIM_EVENT_FIELDS)
+
+
+def get_claim_event(ctx, event_id):
+    event = _load_claim_event(event_id)
+    claim = repository.get_claim(event["claim"])
+    if not permissions.can_read_claim_event(ctx.user, claim, _claimant(claim)):
+        raise Forbidden()
+    return event
+
+
+def ensure_can_write_claim_events(ctx, event_id=None):
+    """Claim events are recorded by the workflow only: creating, editing or deleting one is
+    forbidden for everyone (after the 404 check for a specific event)."""
+    if event_id is not None:
+        _load_claim_event(event_id)
+    if not permissions.can_write_claim_events(ctx.user):
+        raise Forbidden("Claim history is read-only.")
+
+
+def _load_claim_event(event_id):
+    event = repository.get_claim_event(event_id)
+    if event is None:
+        raise NotFound("No such claim event.")
+    return event
+
