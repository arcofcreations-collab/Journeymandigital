+"""Claim history (claim_events): recording, visibility, read-only access and the backfill."""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+NOW = "2026-03-02T09:30:00"
+LATER = "2026-03-03T10:00:00"
+BACKFILLED = 139  # events backfilled from the 80 seed claims by migration 0002
+
+
+def _events(app, claim_id, user="fiona"):
+    return app.get(f"/api/claim_events?claim={claim_id}", user=user).json["items"]
+
+
+def _strip_ids(events):
+    return [{k: v for k, v in e.items() if k != "id"} for e in events]
+
+
+def test_backfill_from_existing_claims(app):
+    assert _strip_ids(_events(app, 6)) == [  # paid
+        {"claim": 6, "action": "submit", "actor": 11, "at": "2026-02-09T13:00:00",
+         "from_status": "draft", "to_status": "submitted"},
+        {"claim": 6, "action": "approve", "actor": 4, "at": "2026-02-11T11:00:00",
+         "from_status": "submitted", "to_status": "approved"},
+        {"claim": 6, "action": "pay", "actor": None, "at": None, "from_status": "approved", "to_status": "paid"},
+    ]
+    assert _strip_ids(_events(app, 7)) == [  # rejected
+        {"claim": 7, "action": "submit", "actor": 14, "at": "2026-01-28T11:00:00",
+         "from_status": "draft", "to_status": "submitted"},
+        {"claim": 7, "action": "reject", "actor": 4, "at": "2026-01-30T09:00:00",
+         "from_status": "submitted", "to_status": "rejected"},
+    ]
+    assert [e["action"] for e in _events(app, 4)] == ["submit", "approve"]  # approved
+    assert [e["action"] for e in _events(app, 2)] == ["submit"]  # submitted
+    assert _events(app, 1) == []  # draft
+
+
+def test_backfill_matches_every_claim(app):
+    claims = app.get("/api/claims", user="fiona").json["items"]
+    events = app.get("/api/claim_events", user="fiona").json["items"]
+    assert len(events) == BACKFILLED
+    assert [e["id"] for e in events] == list(range(1, BACKFILLED + 1))
+    for claim in claims:
+        expected = []
+        if claim["submitted_at"]:
+            expected.append(("submit", claim["employee"], claim["submitted_at"], "draft", "submitted"))
+        if claim["decided_at"]:
+            action, to = ("reject", "rejected") if claim["status"] == "rejected" else ("approve", "approved")
+            expected.append((action, claim["decided_by"], claim["decided_at"], "submitted", to))
+        if claim["status"] == "paid":
+            expected.append(("pay", None, None, "approved", "paid"))
+        got = [(e["action"], e["actor"], e["at"], e["from_status"], e["to_status"])
+               for e in events if e["claim"] == claim["id"]]
+        assert got == expected, claim["id"]
+
+
+def test_actions_record_one_event_each(app):
+    claim = app.post("/api/claims", {"amount": 120, "category": "travel", "description": "Train"}, user="sam").json
+    path = f"/api/claims/{claim['id']}"
+    app.patch(path, {"amount": 130}, user="sam")
+    assert _events(app, claim["id"]) == []  # creating and editing drafts record nothing
+    assert app.post(f"{path}/submit", {}, user="sam", now=NOW).status == 200
+    assert app.post(f"{path}/approve", {}, user="omar", now=NOW).status == 200
+    assert app.post(f"{path}/pay", {}, user="fiona", now=LATER).status == 200
+    assert _events(app, claim["id"]) == [
+        {"id": BACKFILLED + 1, "claim": claim["id"], "action": "submit", "actor": 8, "at": NOW,
+         "from_status": "draft", "to_status": "submitted"},
+        {"id": BACKFILLED + 2, "claim": claim["id"], "action": "approve", "actor": 4, "at": NOW,
+         "from_status": "submitted", "to_status": "approved"},
+        {"id": BACKFILLED + 3, "claim": claim["id"], "action": "pay", "actor": 1, "at": LATER,
+         "from_status": "approved", "to_status": "paid"},
+    ]
+    assert len(app.get("/api/_outbox", user="sam").json["items"]) == 1  # only the payment message
+
+
+def test_reject_records_event(app):
+    assert app.post("/api/claims/3/reject", {"reason": "Missing receipt"}, user="marco", now=NOW).status == 200
+    assert _events(app, 3)[-1] == {"id": BACKFILLED + 1, "claim": 3, "action": "reject", "actor": 2, "at": NOW,
+                                   "from_status": "submitted", "to_status": "rejected"}
+
+
+def test_failed_actions_and_draft_changes_record_nothing(app):
+    app.post("/api/claims/2/pay", {}, user="fiona")  # 409
+    app.post("/api/claims/2/approve", {}, user="marco")  # 403
+    app.post("/api/claims/3/reject", {}, user="marco")  # 400
+    app.post("/api/claims/1/submit", {"extra": 1}, user="wen")  # 400
+    app.post("/api/claims/999/submit", {}, user="wen")  # 404
+    assert app.delete("/api/claims/1", user="wen").status == 204
+    assert len(app.get("/api/claim_events", user="fiona").json["items"]) == BACKFILLED
+
+
+def test_events_visible_like_their_claim(app):
+    for user in ("priya", "omar", "marco", "nadia", "victor", "fiona"):
+        claims = {c["id"] for c in app.get("/api/claims", user=user).json["items"]}
