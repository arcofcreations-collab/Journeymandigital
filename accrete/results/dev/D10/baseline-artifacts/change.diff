@@ -0,0 +1,46 @@
+-- Claim history: one row per successful workflow action (submit, approve, reject, pay).
+-- Exposed read-only at /api/claim_events. AUTOINCREMENT keeps ids increasing in the
+-- order events are recorded (ids are never reused).
+
+CREATE TABLE claim_events (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    claim_id    INTEGER NOT NULL REFERENCES claims (id),
+    action      TEXT    NOT NULL CHECK (action IN ('submit', 'approve', 'reject', 'pay')),
+    actor_id    INTEGER REFERENCES employees (id),  -- null when not known (backfilled payments)
+    at          TEXT,                               -- YYYY-MM-DDTHH:MM:SS (UTC); null when not known
+    from_status TEXT    NOT NULL
+                        CHECK (from_status IN ('draft', 'submitted', 'approved', 'rejected', 'paid')),
+    to_status   TEXT    NOT NULL
+                        CHECK (to_status IN ('draft', 'submitted', 'approved', 'rejected', 'paid'))
+);
+
+CREATE INDEX claim_events_claim_id ON claim_events (claim_id);
+CREATE INDEX claim_events_actor_id ON claim_events (actor_id);
+
+-- Backfill the history of existing claims from their workflow fields, claim by claim,
+-- each claim's events in the order submit, decision, pay. Who paid and when was never
+-- recorded, so backfilled payments have no actor and no time.
+INSERT INTO claim_events (claim_id, action, actor_id, at, from_status, to_status)
+SELECT claim_id, action, actor_id, at, from_status, to_status
+FROM (
+    SELECT id AS claim_id, 1 AS step, 'submit' AS action, employee_id AS actor_id, submitted_at AS at,
+           'draft' AS from_status, 'submitted' AS to_status
+    FROM claims
+    WHERE submitted_at IS NOT NULL
+
+    UNION ALL
+
+    SELECT id, 2,
+           CASE status WHEN 'rejected' THEN 'reject' ELSE 'approve' END,
+           decided_by_id, decided_at, 'submitted',
+           CASE status WHEN 'rejected' THEN 'rejected' ELSE 'approved' END
+    FROM claims
+    WHERE decided_at IS NOT NULL AND status IN ('approved', 'paid', 'rejected')
+
+    UNION ALL
+
+    SELECT id, 3, 'pay', NULL, NULL, 'approved', 'paid'
+    FROM claims
+    WHERE status = 'paid'
+)
+ORDER BY claim_id, step;
