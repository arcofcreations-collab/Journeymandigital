+        assert {e["claim"] for e in events} == {c for c in claims if _events(app, c)}
+    event_of_claim_7 = _events(app, 7)[0]["id"]  # yusuf's claim, manager omar
+    assert app.get(f"/api/claim_events/{event_of_claim_7}", user="yusuf").status == 200
+    assert app.get(f"/api/claim_events/{event_of_claim_7}", user="omar").status == 200
