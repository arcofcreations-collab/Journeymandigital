--- a/changes/0002-claim-history.yaml
+++ b/changes/0002-claim-history.yaml
@@ -0,0 +1,218 @@
+request: "Claim history: new read-only collection claim_events recording every successful submit/approve/reject/pay (claim, action, actor, at, from_status, to_status), readable by exactly those who can read the claim, never creatable/editable/deletable; backfill history of existing claims."
+interpretation: "Add entity claim_events (claim ref claims required, action enum submit|approve|reject|pay required, actor ref employees, at datetime, from_status/to_status enum of claim statuses required). Read rule mirrors the claims read rule via record.claim; create/update/delete rules are False (403 for everyone). Each of the four claim actions gets a prepended create effect (from_status = record.status before the set, to_status = the action's target status, actor = user, at = now); effects are atomic, so a failed action records nothing. Backfill: one event per existing claim fact, inserted grouped by claim id in order submit, decision, pay (pay with actor/at null), so backfilled ids precede all later events. No emit is added."
+ops:
+  - add_entity:
+      name: claim_events
+      fields:
+        claim: {type: ref, ref: claims, required: true, system: true}
+        action: {type: enum, values: [submit, approve, reject, pay], required: true, system: true}
+        actor: {type: ref, ref: employees, system: true}
+        at: {type: datetime, system: true}
+        from_status: {type: enum, values: [draft, submitted, approved, rejected, paid], required: true, system: true}
+        to_status: {type: enum, values: [draft, submitted, approved, rejected, paid], required: true, system: true}
+      rules:
+        read: "record.claim.employee == user or record.claim.employee.manager == user or user.role == 'finance'"
+        create: "False"
+        update: "False"
+        delete: "False"
+  - change_action:
+      entity: claims
+      name: submit
+      prepend_effects:
+        - create: claim_events
+          values: {claim: record, action: "'submit'", actor: user, at: now, from_status: record.status, to_status: "'submitted'"}
+  - change_action:
+      entity: claims
+      name: approve
+      prepend_effects:
+        - create: claim_events
+          values: {claim: record, action: "'approve'", actor: user, at: now, from_status: record.status, to_status: "'approved'"}
+  - change_action:
