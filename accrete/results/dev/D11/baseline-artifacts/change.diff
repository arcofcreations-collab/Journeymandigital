+def create_payment_run(ctx, data):
+    """Pay the listed approved claims in one run, in list order; all or nothing.
+
+    Any listed claim that exists but is not ``approved`` is a 409, even when the body is
+    otherwise invalid; then the list must be valid, every claim must exist and the total
+    must not exceed ``validation.MAX_PAYMENT_RUN_TOTAL`` (400).
+    """
+    ensure_can_create_payment_run(ctx)
+    with transaction():
+        listed = [repository.get_claim(claim_id) for claim_id in validation.listed_record_ids(data, "claims")]
+        if any(claim is not None and claim["status"] != "approved" for claim in listed):
+            raise Conflict("Only approved claims can be paid.")
+        claim_ids = validation.clean_payment_run(data)
+        claims = [repository.get_claim(claim_id) for claim_id in claim_ids]
+        missing = [claim_id for claim_id, claim in zip(claim_ids, claims) if claim is None]
+        if missing:
+            raise ValidationError("Invalid input.", {"claims": f"no such claim: {', '.join(map(str, missing))}"})
+        total = round(sum(claim["amount"] for claim in claims), 2)
+        if total > validation.MAX_PAYMENT_RUN_TOTAL:
+            raise ValidationError("Invalid input.", {
+                "claims": f"total {total:.2f} exceeds {validation.MAX_PAYMENT_RUN_TOTAL:.2f}"})
+        run_id = repository.insert_payment_run(claim_ids, total, ctx.user["id"], ctx.now_text)
+        for claim in claims:
+            _pay(ctx, claim)
+        repository.add_outbox_message(
+            "payment_run", {"run": run_id, "claims": claim_ids, "total": total}, ctx.now_text
+        )
+    return repository.get_payment_run(run_id)
+
+
