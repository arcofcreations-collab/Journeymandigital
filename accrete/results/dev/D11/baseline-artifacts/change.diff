@@ -0,0 +1,190 @@
+"""Payment runs: paying several approved claims at once, all or nothing."""
+import os
+import sqlite3
+
+from accept_client import fresh_app, parse_ui
+
+NOW = "2026-03-02T09:30:00"
+BACKFILLED = 139  # claim events backfilled by migration 0002
+# Seed claims: 4 and 12 are approved (558.67 and 380.94), 2 is submitted, 6 is paid, 1 is a draft.
+
+
+def _approved_claim(app, amount, user="sam", manager="omar"):
+    claim = app.post("/api/claims", {"amount": amount, "category": "travel", "description": "Trip"}, user=user).json
+    assert app.post(f"/api/claims/{claim['id']}/submit", {}, user=user).status == 200
+    assert app.post(f"/api/claims/{claim['id']}/approve", {}, user=manager).status == 200
+    return claim["id"]
+
+
+def _snapshot(app):
+    """Everything a failed run must leave untouched."""
+    return (app.get("/api/claims", user="fiona").json["items"],
+            app.get("/api/claim_events", user="fiona").json["items"],
+            app.get("/api/_outbox", user="fiona").json["items"],
+            app.get("/api/payment_runs", user="fiona").json["items"])
+
+
+def test_create_run_pays_claims_in_order(app):
+    r = app.post("/api/payment_runs", {"claims": [12, 4]}, user="fiona", now=NOW)
+    assert r.status == 201
+    run = r.json
+    assert run == {"id": 1, "claims": [12, 4], "total": 939.61, "created_by": 1, "created_at": NOW}
+    assert app.get("/api/payment_runs/1", user="fiona").json == run
+    for claim_id in (12, 4):
+        claim = app.get(f"/api/claims/{claim_id}", user="fiona").json
+        assert claim["status"] == "paid" and claim["payment_run"] == 1
+    assert app.get("/api/claims/4", user="fiona").json["decided_by"] == 3  # unchanged
+    assert app.get("/api/_outbox", user="uma").json["items"] == [
+        {"id": 1, "channel": "payment", "payload": {"claim": 12, "employee": 9, "amount": 380.94}, "created_at": NOW},
+        {"id": 2, "channel": "payment", "payload": {"claim": 4, "employee": 10, "amount": 558.67}, "created_at": NOW},
+        {"id": 3, "channel": "payment_run", "payload": {"run": 1, "claims": [12, 4], "total": 939.61},
+         "created_at": NOW},
+    ]
+    events = app.get("/api/claim_events?action=pay&actor=1", user="fiona").json["items"]
+    assert events == [
+        {"id": BACKFILLED + 1, "claim": 12, "action": "pay", "actor": 1, "at": NOW,
+         "from_status": "approved", "to_status": "paid"},
+        {"id": BACKFILLED + 2, "claim": 4, "action": "pay", "actor": 1, "at": NOW,
+         "from_status": "approved", "to_status": "paid"},
+    ]
+    # paid claims cannot be paid again, singly or in another run
+    assert app.post("/api/claims/4/pay", {}, user="fiona").status == 409
+    assert app.post("/api/payment_runs", {"claims": [4]}, user="fiona").status == 409
+
+
+def test_existing_and_singly_paid_claims_have_no_run(app):
+    assert {c["payment_run"] for c in app.get("/api/claims", user="fiona").json["items"]} == {None}
+    r = app.post("/api/claims/4/pay", {}, user="fiona")
+    assert r.status == 200 and r.json["payment_run"] is None
+    assert app.get("/api/payment_runs", user="fiona").json["items"] == []
+
+
+def test_total_is_rounded_and_limited(app):
+    small = [_approved_claim(app, 0.1), _approved_claim(app, 0.2)]
+    assert app.post("/api/payment_runs", {"claims": small}, user="fiona").json["total"] == 0.3
+    exact = [_approved_claim(app, 5000), _approved_claim(app, 4999.99), _approved_claim(app, 0.01)]
+    over = _approved_claim(app, 0.01)
+    before = _snapshot(app)
+    r = app.post("/api/payment_runs", {"claims": exact + [over]}, user="fiona")
+    assert r.status == 400 and r.json["error"] == "validation" and "claims" in r.json["fields"]
+    assert _snapshot(app) == before
+    r = app.post("/api/payment_runs", {"claims": exact}, user="fiona")
+    assert r.status == 201 and r.json["total"] == 10000
+
+
+def test_only_finance_creates_runs(app):
+    for user in ("marco", "omar", "priya"):
+        assert app.post("/api/payment_runs", {"claims": [4]}, user=user).status == 403
+        assert app.post("/api/payment_runs", {"claims": "nope"}, user=user).status == 403
+        assert app.post("/api/payment_runs", {}, user=user).status == 403
+    assert app.post("/api/payment_runs", {"claims": [4]}).status == 401
+    assert app.get("/api/claims/4", user="fiona").json["status"] == "approved"
+
+
+def test_invalid_bodies_are_400_and_change_nothing(app):
+    before = _snapshot(app)
+    for body in ({}, {"claims": None}, {"claims": 4}, {"claims": "4"}, {"claims": []}, {"claims": [4, 4]},
+                 {"claims": [4, 999]}, {"claims": [4, "12"]}, {"claims": [4, True]}, {"claims": [4.0]},
+                 {"claims": [4], "total": 1}, {"claims": [4], "colour": "red"}, [4]):
+        r = app.post("/api/payment_runs", body, user="fiona")
+        assert r.status == 400 and r.json["error"] == "validation", body
+    assert _snapshot(app) == before
+
+
+def test_unapproved_claims_are_409_and_beat_400(app):
+    before = _snapshot(app)
+    for claim_ids in ([4, 2], [1], [6, 12], [2, 2], [4, 2, 999], [2, "x"]):
+        r = app.post("/api/payment_runs", {"claims": claim_ids}, user="fiona")
+        assert r.status == 409 and r.json["error"] == "conflict", claim_ids
+    big = [_approved_claim(app, 5000), _approved_claim(app, 5000)]
+    before = _snapshot(app)
+    assert app.post("/api/payment_runs", {"claims": big + [2]}, user="fiona").status == 409  # also over the limit
+    assert app.post("/api/payment_runs", {"claims": [4, 2], "extra": 1}, user="fiona").status == 409
+    assert _snapshot(app) == before
+
+
+def test_runs_visible_to_finance_only(app):
+    assert app.post("/api/payment_runs", {"claims": [4]}, user="fiona").status == 201
+    created = app.post("/api/employees", {"username": "fred", "name": "Fred", "role": "finance", "manager": None,
+                                          "department": "Finance"}, user="fiona").json
+    assert [r["id"] for r in app.get("/api/payment_runs", user="fred").json["items"]] == [1]
+    for user in ("marco", "uma"):  # uma owns claim 4
+        assert app.get("/api/payment_runs", user=user).json["items"] == []
+        r = app.get("/api/payment_runs/1", user=user)
+        assert r.status == 403 and r.json["error"] == "forbidden"
+    assert app.get("/api/claims/4", user="uma").json["payment_run"] == 1
+    assert app.get("/api/payment_runs/99", user="fiona").status == 404
+    assert app.get("/api/payment_runs/99", user="uma").status == 404
+    assert app.delete(f"/api/employees/{created['id']}", user="fiona").status == 204
+
+
+def test_runs_cannot_be_changed(app):
+    assert app.post("/api/payment_runs", {"claims": [4]}, user="fiona").status == 201
+    for user in ("fiona", "marco", "uma"):
+        assert app.patch("/api/payment_runs/1", {"claims": [12]}, user=user).status == 403
+        assert app.patch("/api/payment_runs/1", {}, user=user).status == 403
+        assert app.delete("/api/payment_runs/1", user=user).status == 403
+    assert app.patch("/api/payment_runs/99", {}, user="fiona").status == 404
+    assert app.delete("/api/payment_runs/99", user="fiona").status == 404
+    assert app.get("/api/payment_runs/1", user="fiona").json["claims"] == [4]
+
+
+def test_claims_cannot_set_payment_run(app):
+    r = app.post("/api/claims", {"amount": 5, "category": "meals", "description": "x", "payment_run": None},
+                 user="priya")
+    assert r.status == 400 and "payment_run" in r.json["fields"]
+    assert app.patch("/api/claims/1", {"payment_run": 1}, user="wen").status == 400
+
+
+def test_filters(app):
+    app.post("/api/payment_runs", {"claims": [12]}, user="fiona")
+    app.post("/api/payment_runs", {"claims": [4]}, user="omar")  # 403, no run
+    nadia_run = app.post("/api/payment_runs", {"claims": [13, 18]}, user="fiona").json["id"]
+    assert [c["id"] for c in app.get("/api/claims?payment_run=2", user="fiona").json["items"]] == [13, 18]
+    assert [r["id"] for r in app.get("/api/payment_runs?created_by=1", user="fiona").json["items"]] == [1, 2]
+    assert [r["id"] for r in app.get("/api/payment_runs?claims=18", user="fiona").json["items"]] == [nadia_run]
+    assert app.get("/api/payment_runs?colour=red", user="fiona").status == 400
+
+
+def test_run_creator_cannot_be_deleted(app):
+    created = app.post("/api/employees", {"username": "fred", "name": "Fred", "role": "finance", "manager": None,
+                                          "department": "Finance"}, user="fiona").json
+    assert app.post("/api/payment_runs", {"claims": [4]}, user="fred").status == 201
+    assert app.delete(f"/api/employees/{created['id']}", user="fiona").status == 409
+
+
+def test_ui_pages(app):
+    app.post("/api/payment_runs", {"claims": [12, 4]}, user="fiona", now=NOW)
+    assert parse_ui(app.get("/ui/payment_runs", user="fiona").text).rows == [1]
+    assert parse_ui(app.get("/ui/payment_runs", user="uma").text).rows == []
+    page = parse_ui(app.get("/ui/payment_runs/1", user="fiona").text)
+    assert page.fields == {"claims": "[12, 4]", "total": "939.61", "created_by": "1", "created_at": NOW}
+    assert page.actions == []
+    assert app.get("/ui/payment_runs/1", user="uma").status == 403
+    assert parse_ui(app.get("/ui/claims/4", user="uma").text).fields["payment_run"] == "1"
+    new = parse_ui(app.get("/ui/payment_runs/new", user="fiona").text)
+    assert new.creates == ["payment_runs"] and new.inputs == ["claims"]
+    assert app.get("/ui/payment_runs/new", user="marco").status == 403
+    assert parse_ui(app.get("/ui/claims/13", user="fiona").text).actions == ["pay"]
+
+
+def test_ui_form_creates_run(app):
+    from test_expenses_ui import _post_form
+
+    status, headers, _ = _post_form(app, "/ui/payment_runs", {"claims": "13, 18"}, "fiona")
+    assert status == 303 and headers["Location"].endswith("/ui/payment_runs/1")
+    assert app.get("/api/payment_runs/1", user="fiona").json["claims"] == [13, 18]
+    assert _post_form(app, "/ui/payment_runs", {"claims": ""}, "fiona")[0] == 400
+    assert _post_form(app, "/ui/payment_runs", {"claims": "27 x"}, "fiona")[0] == 400
+    assert _post_form(app, "/ui/payment_runs", {"claims": "27"}, "marco")[0] == 403
+
+
+def test_migration_adds_runs_and_keeps_data(app):
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    tables = {row[0] for row in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
+    links = conn.execute("SELECT COUNT(*) FROM payment_run_claims").fetchone()[0]
+    events = conn.execute("SELECT COUNT(*) FROM claim_events").fetchone()[0]
+    conn.close()
+    assert {"payment_runs", "payment_run_claims"} <= tables and links == 0 and events == BACKFILLED
+    reloaded = fresh_app(app.workdir)  # restarting with nothing pending changes nothing
+    assert len(reloaded.get("/api/claims", user="fiona").json["items"]) == 80
