@@ -0,0 +1,21 @@
+-- Payment runs: finance pays several approved claims in one operation.
+-- Exposed at /api/payment_runs (create and read only). A run's `claims` keep the order they
+-- were given in (`position`); a claim's `payment_run` field is derived from
+-- payment_run_claims, so it is null for every existing claim and for claims paid with the
+-- single `pay` action. A claim can belong to at most one run.
+
+CREATE TABLE payment_runs (
+    id            INTEGER PRIMARY KEY AUTOINCREMENT,
+    total         REAL    NOT NULL CHECK (total > 0 AND total <= 10000),
+    created_by_id INTEGER NOT NULL REFERENCES employees (id),
+    created_at    TEXT    NOT NULL  -- YYYY-MM-DDTHH:MM:SS (UTC)
+);
+
+CREATE INDEX payment_runs_created_by_id ON payment_runs (created_by_id);
+
+CREATE TABLE payment_run_claims (
+    run_id   INTEGER NOT NULL REFERENCES payment_runs (id),
+    position INTEGER NOT NULL,  -- 0-based index in the run's `claims` list
+    claim_id INTEGER NOT NULL UNIQUE REFERENCES claims (id),
+    PRIMARY KEY (run_id, position)
+);
