+-- Holds (reservations): members queue for a book that is on loan. Existing data has no holds.
+
+CREATE TABLE holds (
+    id        INTEGER PRIMARY KEY AUTOINCREMENT,
+    book_id   INTEGER NOT NULL REFERENCES books (id),
+    member_id INTEGER NOT NULL REFERENCES members (id),
+    placed_at TEXT    NOT NULL,  -- YYYY-MM-DDTHH:MM:SS (UTC)
+    status    TEXT    NOT NULL CHECK (status IN ('waiting', 'ready', 'fulfilled', 'cancelled')),
+    ready_at  TEXT               -- YYYY-MM-DDTHH:MM:SS (UTC) or NULL until the hold becomes ready
+);
+
+CREATE INDEX holds_book_id ON holds (book_id);
+CREATE INDEX holds_member_id ON holds (member_id);
+-- A book is reserved for at most one member at a time.
+CREATE UNIQUE INDEX holds_one_ready_per_book ON holds (book_id) WHERE status = 'ready';
+-- A member has at most one open (waiting or ready) hold per book.
+CREATE UNIQUE INDEX holds_one_open_per_member_and_book ON holds (book_id, member_id)
+    WHERE status IN ('waiting', 'ready');
