+_HOLD_SELECT = "SELECT id, book_id, member_id, placed_at, status, ready_at FROM holds"
+# A book's queue: holds are served in order of placed_at, ties broken by id.
+_QUEUE_ORDER = "ORDER BY placed_at, id"
