+    """The ``waiting`` hold at the head of the book's queue, or None."""
+    row = get_db().execute(
+        f"{_HOLD_SELECT} WHERE book_id = ? AND status = 'waiting' {_QUEUE_ORDER} LIMIT 1", (book_id,)
+    ).fetchone()
+    return _hold(row)
