+
+def _hold(row):
+    if row is None:
+        return None
+    return {
+        "id": row["id"],
+        "book": row["book_id"],
+        "member": row["member_id"],
+        "placed_at": row["placed_at"],
+        "status": row["status"],
+        "ready_at": row["ready_at"],
+    }
