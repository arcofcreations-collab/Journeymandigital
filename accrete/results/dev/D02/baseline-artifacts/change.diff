+"""Holds: queueing for books on loan, readiness on return, reserved books, cancelling, UI."""
+from accept_client import parse_ui
+
+T1, T2, T3, T4 = "2026-03-01T10:00:00", "2026-03-02T10:00:00", "2026-03-03T10:00:00", "2026-03-04T10:00:00"
+# Book 4 is on loan to jo (loan 46); book 22 to chen (loan 52); book 3 is available.
+
+
+def _outbox(app, channel=None):
+    items = app.get("/api/_outbox", user="ada").json["items"]
+    return [m for m in items if channel is None or m["channel"] == channel]
+
+
+def test_member_places_hold_on_book_on_loan(app):
+    r = app.post("/api/books/4/hold", {}, user="chen", now=T1)
+    assert r.status == 200 and r.json["id"] == 4 and r.json["status"] == "on_loan"
+    assert app.get("/api/holds", user="chen").json["items"] == [
+        {"id": 1, "book": 4, "member": 3, "placed_at": T1, "status": "waiting", "ready_at": None}]
+    assert _outbox(app) == []
+
+
+def test_librarian_places_hold_for_member(app):
+    assert app.post("/api/books/4/hold", {"member": 5}, user="ada").status == 200
+    assert app.get("/api/holds/1", user="eli").json["member"] == 5
+    assert app.post("/api/books/4/hold", {"member": 999}, user="ada").status == 400
+    assert app.post("/api/books/4/hold", {"member": "eli"}, user="ada").status == 400
+    assert app.post("/api/books/3/hold", {"member": 999}, user="ada").status == 409  # 409 beats 400
+
+
+def test_member_cannot_hold_for_someone_else(app):
+    assert app.post("/api/books/4/hold", {"member": 4}, user="chen").status == 403
+    assert app.post("/api/books/3/hold", {"member": 4}, user="chen").status == 403  # 403 beats 409
+    assert app.post("/api/books/4/hold", {"member": 3}, user="chen").status == 200
+    assert app.post("/api/books/999/hold", {}, user="chen").status == 404
+
+
+def test_hold_conflicts(app):
+    assert app.post("/api/books/3/hold", {}, user="chen").status == 409  # available
+    assert app.post("/api/books/4/hold", {}, user="lena").status == 409  # inactive
+    assert app.post("/api/books/4/hold", {}, user="jo").status == 409  # jo has book 4 on loan
+    assert app.post("/api/books/4/hold", {}, user="chen").status == 200
+    assert app.post("/api/books/4/hold", {}, user="chen").status == 409  # already waiting
+    assert app.post("/api/books/4/hold", {"colour": 1}, user="dara").status == 400
+    assert len(app.get("/api/holds", user="ada").json["items"]) == 1
+
+
+def test_loan_limit_does_not_apply_to_holds(app):
+    assert app.post("/api/books/22/hold", {}, user="jo").status == 200  # jo has 3 open loans
+
+
+def test_return_makes_first_hold_ready_in_queue_order(app):
+    app.post("/api/books/4/hold", {}, user="chen", now=T2)   # hold 1
+    app.post("/api/books/4/hold", {}, user="dara", now=T1)   # hold 2: placed earlier
+    app.post("/api/books/4/hold", {}, user="eli", now=T1)    # hold 3: same time, higher id
+    assert app.post("/api/loans/46/return", {}, user="jo", now=T3).status == 200
+    holds = {h["id"]: h for h in app.get("/api/holds", user="ada").json["items"]}
+    assert holds[2]["status"] == "ready" and holds[2]["ready_at"] == T3
+    assert holds[1]["status"] == holds[3]["status"] == "waiting"
+    assert app.get("/api/books/4", user="chen").json["status"] == "reserved"
+    assert app.get("/api/books?status=reserved", user="chen").json["items"][0]["id"] == 4
+    assert _outbox(app) == [{"id": 1, "channel": "hold_ready", "payload": {"hold": 2, "book": 4, "member": 4},
+                             "created_at": T3}]
+
+
+def test_return_without_holds_makes_book_available(app):
+    app.post("/api/loans/46/return", {}, user="jo")
+    assert app.get("/api/books/4", user="chen").json["status"] == "available"
+    assert _outbox(app) == []
+
+
+def test_only_ready_member_may_borrow_reserved_book(app):
+    app.post("/api/books/4/hold", {}, user="chen", now=T1)
+    app.post("/api/books/4/hold", {}, user="dara", now=T2)
+    app.post("/api/loans/46/return", {}, user="jo", now=T3)
+    assert app.post("/api/books/4/borrow", {}, user="dara").status == 409
+    assert app.post("/api/books/4/borrow", {}, user="ada").status == 409
+    assert app.post("/api/books/4/borrow", {"member": 4}, user="ada").status == 409
+    assert app.post("/api/books/4/hold", {}, user="eli").status == 200  # reserved books take holds
+    r = app.post("/api/books/4/borrow", {"member": 3}, user="ada", now=T4)
+    assert r.status == 200 and r.json["status"] == "on_loan"
+    assert app.get("/api/holds/1", user="chen").json["status"] == "fulfilled"
+    assert app.get("/api/holds/2", user="dara").json["status"] == "waiting"
+    assert [m["channel"] for m in _outbox(app)] == ["hold_ready", "loan_created"]
+
+
+def test_ready_member_borrows_for_themselves(app):
+    app.post("/api/books/22/hold", {}, user="dara")
+    app.post("/api/loans/52/return", {}, user="chen")
+    assert app.post("/api/books/22/borrow", {}, user="dara").status == 200
+    assert app.get("/api/holds/1", user="dara").json["status"] == "fulfilled"
+
+
+def test_failed_borrow_keeps_hold_ready(app):
+    app.post("/api/books/22/hold", {}, user="jo")  # jo has 3 open loans
+    app.post("/api/loans/52/return", {}, user="chen")
+    assert app.post("/api/books/22/borrow", {}, user="jo").status == 409
+    assert app.get("/api/holds/1", user="jo").json["status"] == "ready"
+    assert app.get("/api/books/22", user="jo").json["status"] == "reserved"
+    app.post("/api/loans/46/return", {}, user="jo")
+    assert app.post("/api/books/22/borrow", {}, user="jo").status == 200
+    assert app.get("/api/holds/1", user="jo").json["status"] == "fulfilled"
+
+
+def test_cancel_waiting_hold(app):
+    app.post("/api/books/4/hold", {}, user="chen")
+    assert app.post("/api/holds/1/cancel", {}, user="dara").status == 403
+    r = app.post("/api/holds/1/cancel", {}, user="chen")
+    assert r.status == 200 and r.json["status"] == "cancelled" and r.json["id"] == 1
+    assert app.post("/api/holds/1/cancel", {}, user="chen").status == 409
+    assert app.post("/api/holds/999/cancel", {}, user="chen").status == 404
+    assert app.get("/api/books/4", user="chen").json["status"] == "on_loan"
+    assert app.post("/api/books/4/hold", {}, user="chen").status == 200  # may queue again
+
+
+def test_cancel_ready_hold_passes_book_on(app):
+    app.post("/api/books/4/hold", {}, user="chen", now=T1)
+    app.post("/api/books/4/hold", {}, user="dara", now=T2)
+    app.post("/api/loans/46/return", {}, user="jo", now=T3)
+    r = app.post("/api/holds/1/cancel", {}, user="ben", now=T4)
+    assert r.status == 200 and r.json["status"] == "cancelled" and r.json["ready_at"] == T3
+    hold = app.get("/api/holds/2", user="dara").json
+    assert hold["status"] == "ready" and hold["ready_at"] == T4
+    assert app.get("/api/books/4", user="chen").json["status"] == "reserved"
+    assert _outbox(app, "hold_ready")[-1]["payload"] == {"hold": 2, "book": 4, "member": 4}
+    app.post("/api/holds/2/cancel", {}, user="dara")
+    assert app.get("/api/books/4", user="chen").json["status"] == "available"
+    assert len(_outbox(app, "hold_ready")) == 2
+    assert app.post("/api/books/4/borrow", {}, user="eli").status == 200
+
+
+def test_cancel_finished_hold_is_409(app):
+    app.post("/api/books/22/hold", {}, user="dara")
+    app.post("/api/loans/52/return", {}, user="chen")
+    app.post("/api/books/22/borrow", {}, user="dara")
+    assert app.post("/api/holds/1/cancel", {}, user="ada").status == 409
+
+
+def test_hold_permissions(app):
+    app.post("/api/books/4/hold", {}, user="chen")
+    app.post("/api/books/4/hold", {}, user="dara")
+    assert [h["id"] for h in app.get("/api/holds", user="chen").json["items"]] == [1]
+    assert [h["id"] for h in app.get("/api/holds", user="ada").json["items"]] == [1, 2]
+    assert app.get("/api/holds?member=4", user="ada").json["items"][0]["id"] == 2
+    assert app.get("/api/holds/2", user="chen").status == 403
+    assert app.get("/api/holds/999", user="chen").status == 404
+    assert app.post("/api/holds", {"book": 4, "member": 3}, user="ada").status == 403
+    assert app.patch("/api/holds/1", {"status": "ready"}, user="ada").status == 403
+    assert app.delete("/api/holds/1", user="ada").status == 403
+    assert app.patch("/api/holds/999", {}, user="ada").status == 404
+    assert app.delete("/api/holds/999", user="ada").status == 404
+
+
+def test_member_with_holds_cannot_be_deleted(app):
+    app.post("/api/books/4/hold", {}, user="ada")  # ada has no loans
+    assert app.delete("/api/members/1", user="ben").status == 409
+
+
+def test_book_page_hold_and_borrow_forms(app):
+    assert parse_ui(app.get("/ui/books/4", user="chen").text).actions == ["hold"]
+    assert parse_ui(app.get("/ui/books/4", user="jo").text).actions == []  # jo has it on loan
+    assert parse_ui(app.get("/ui/books/4", user="lena").text).actions == []  # inactive
+    assert parse_ui(app.get("/ui/books/3", user="chen").text).actions == ["borrow"]  # available
+    app.post("/api/books/4/hold", {}, user="chen")
+    assert parse_ui(app.get("/ui/books/4", user="chen").text).actions == []  # already waiting
+    app.post("/api/loans/46/return", {}, user="jo")
+    assert parse_ui(app.get("/ui/books/4", user="chen").text).actions == ["borrow"]
+    assert parse_ui(app.get("/ui/books/4", user="dara").text).actions == ["hold"]
+    page = parse_ui(app.get("/ui/books/4", user="ada").text)
+    assert page.fields["status"] == "reserved" and page.actions == ["borrow", "hold"]
+
+
+def test_hold_pages(app):
+    app.post("/api/books/4/hold", {}, user="chen", now=T1)
+    page = parse_ui(app.get("/ui/holds/1", user="chen").text)
+    assert page.fields == {"book": "4", "member": "3", "placed_at": T1, "status": "waiting", "ready_at": ""}
+    assert page.actions == ["cancel"]
+    assert parse_ui(app.get("/ui/holds/1", user="ada").text).actions == ["cancel"]
+    assert app.get("/ui/holds/1", user="dara").status == 403
+    assert parse_ui(app.get("/ui/holds", user="chen").text).rows == [1]
+    assert parse_ui(app.get("/ui/holds", user="dara").text).rows == []
+    assert app.get("/ui/holds/new", user="ada").status == 403
+    app.post("/api/holds/1/cancel", {}, user="chen")
+    assert parse_ui(app.get("/ui/holds/1", user="chen").text).actions == []
