+{% extends "base.html" %}
+{% block title %}Holds{% endblock %}
+{% block content %}
+<h1>Holds</h1>
+<table>
+  <thead><tr><th>Hold</th><th>Book</th><th>Member</th><th>Placed</th><th>Status</th><th>Ready</th></tr></thead>
+  <tbody>
+  {% for hold in holds %}
+    <tr data-id="{{ hold.id }}">
+      <td><a href="{{ url_for('ui.show_hold', hold_id=hold.id) }}">#{{ hold.id }}</a></td>
+      <td><a href="{{ url_for('ui.show_book', book_id=hold.book) }}">{{ hold.book }}</a></td>
+      <td>{{ hold.member }}</td>
+      <td>{{ hold.placed_at }}</td>
+      <td>{{ hold.status }}</td>
+      <td>{{ hold.ready_at|display }}</td>
+    </tr>
+  {% endfor %}
+  </tbody>
+</table>
+{% endblock %}
