+
+def member_has_open_hold(member_id, book_id):
+    """Does the member have a ``waiting`` or ``ready`` hold on the book?"""
+    row = get_db().execute(
+        "SELECT 1 FROM holds WHERE member_id = ? AND book_id = ? AND status IN ('waiting', 'ready')",
+        (member_id, book_id),
+    ).fetchone()
+    return row is not None
+
+
+def insert_hold(book_id, member_id, placed_at):
+    cur = get_db().execute(
+        "INSERT INTO holds (book_id, member_id, placed_at, status, ready_at) VALUES (?, ?, ?, 'waiting', NULL)",
