+def test_total_may_not_exceed_maximum(app):
+    assert _line(app, 1, 5000 - 1271.32 + 0.01, "wen").status == 400
+    assert _line(app, 1, 5000 - 1271.32, "wen").status == 201
+    assert app.get("/api/claims/1", user="wen").json["amount"] == 5000
+    line = app.get("/api/claim_lines?claim=1", user="wen").json["items"][-1]
+    assert app.patch(f"/api/claim_lines/{line['id']}", {"amount": line["amount"] + 1}, user="wen").status == 400
+    assert app.patch("/api/claims/1", {"amount": 1}, user="wen").status == 409  # several lines
