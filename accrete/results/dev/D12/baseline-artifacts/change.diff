+++ b/tests/test_expenses_claim_lines.py
@@ -0,0 +1,143 @@
+"""Itemised claims: claim lines, the derived claim amount and the migration of existing claims."""
+import os
+import sqlite3
+
+from accept_client import parse_ui
+
+NEW = {"amount": 42.5, "category": "meals", "description": "Team lunch"}
+
+
+def _line(app, claim_id, amount, user, description="Extra"):
+    return app.post("/api/claim_lines", {"claim": claim_id, "amount": amount, "description": description}, user=user)
+
+
+def test_existing_claims_have_one_line_with_the_same_id(app, seed):
+    lines = app.get("/api/claim_lines", user="fiona").json["items"]
+    assert lines == [{"id": c["id"], "claim": c["id"], "amount": c["amount"], "description": c["description"]}
+                     for c in seed["claims"]]
+    assert app.get("/api/claims", user="fiona").json["items"] == seed["claims"]  # amounts unchanged
+
+
+def test_migration_keeps_amounts_and_drops_stored_column(app):
+    conn = sqlite3.connect(os.path.join(app.workdir, "data.db"))
+    columns = [row[1] for row in conn.execute("PRAGMA table_info(claims)")]
+    seq = conn.execute("SELECT seq FROM sqlite_sequence WHERE name = 'claim_lines'").fetchone()[0]
+    conn.close()
+    assert "amount" not in columns and seq >= 80
+
+
+def test_creating_a_claim_creates_its_first_line(app):
+    claim = app.post("/api/claims", NEW, user="priya").json
+    assert claim["amount"] == 42.5
+    lines = app.get(f"/api/claim_lines?claim={claim['id']}", user="priya").json["items"]
+    assert len(lines) == 1 and lines[0]["id"] > 80
+    assert lines[0] == {"id": lines[0]["id"], "claim": claim["id"], "amount": 42.5, "description": "Team lunch"}
+
+
+def test_amount_is_total_of_lines_rounded(app):
+    r = _line(app, 1, 10.105, "wen")
