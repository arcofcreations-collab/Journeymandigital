+def create_claim_line(ctx, data):
+    """Add a line to a draft claim of the caller. An unknown or missing ``claim`` is a 400."""
+    with transaction():
+        claim_id = data.get("claim") if isinstance(data, dict) else None
+        claim = repository.get_claim(claim_id) if _is_record_id(claim_id) else None
+        if claim is not None:
+            _ensure_can_change_lines(ctx, claim)
+        values = validation.clean_claim_line(data, partial=False)
+        if claim is None:
+            raise ValidationError("Invalid input.", {"claim": "no such claim"})
+        _check_claim_total(claim, values["amount"])
+        line_id = repository.insert_claim_line(claim["id"], values)
+    return repository.get_claim_line(line_id)
+
+
+def update_claim_line(ctx, line_id, data):
+    with transaction():
+        line = _load_claim_line(line_id)
+        claim = repository.get_claim(line["claim"])
+        _ensure_can_change_lines(ctx, claim)
+        values = validation.clean_claim_line(data, partial=True, current_claim=claim["id"])
+        if "amount" in values:
+            _check_claim_total(claim, values["amount"] - line["amount"])
+        repository.update_claim_line(line_id, values)
+    return repository.get_claim_line(line_id)
+
+
+def delete_claim_line(ctx, line_id):
+    with transaction():
+        line = _load_claim_line(line_id)
+        claim = repository.get_claim(line["claim"])
+        _ensure_can_change_lines(ctx, claim)
+        if len(repository.list_claim_lines(claim["id"])) == 1:
+            raise Conflict("A claim's last line cannot be deleted; delete the claim instead.")
+        repository.delete_claim_line(line_id)
