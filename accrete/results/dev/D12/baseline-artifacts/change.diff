+-- Itemised claims: a claim consists of one or more lines; its amount is the total of its lines.
+
+CREATE TABLE claim_lines (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    claim_id    INTEGER NOT NULL REFERENCES claims (id),
+    amount      REAL    NOT NULL CHECK (amount > 0),
+    description TEXT    NOT NULL
+);
+
+CREATE INDEX claim_lines_claim_id ON claim_lines (claim_id);
+
+-- Every existing claim gets exactly one line with the same id, amount and description,
+-- so no claim's amount changes.
+INSERT INTO claim_lines (id, claim_id, amount, description)
+SELECT id, id, amount, description FROM claims ORDER BY id;
+
+-- New lines get ids above every claim id ever allocated (sqlite_sequence already holds the
+-- highest copied id; this also covers claims deleted before the migration).
+UPDATE sqlite_sequence
+SET seq = (SELECT seq FROM sqlite_sequence WHERE name = 'claims')
+WHERE name = 'claim_lines'
+  AND seq < (SELECT seq FROM sqlite_sequence WHERE name = 'claims');
+
+-- The amount is now derived from the lines (repository computes the rounded total).
+ALTER TABLE claims DROP COLUMN amount;
