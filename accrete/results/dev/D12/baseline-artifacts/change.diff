+def test_patch_line(app):
+    line_id = _line(app, 1, 5, "wen").json["id"]
+    r = app.patch(f"/api/claim_lines/{line_id}", {"amount": 7.5, "description": "Parking"}, user="wen")
+    assert r.status == 200 and r.json == {"id": line_id, "claim": 1, "amount": 7.5, "description": "Parking"}
+    assert app.get("/api/claims/1", user="wen").json["amount"] == round(1271.32 + 7.5, 2)
+    assert app.patch(f"/api/claim_lines/{line_id}", {"claim": 13}, user="wen").status == 400
+    assert app.patch(f"/api/claim_lines/{line_id}", {"claim": 1}, user="wen").status == 200  # unchanged
+    assert app.patch(f"/api/claim_lines/{line_id}", {"amount": 0}, user="wen").status == 400
+    assert app.patch(f"/api/claim_lines/{line_id}", {"amount": 1}, user="marco").status == 403
+    assert app.patch("/api/claim_lines/2", {"amount": 1}, user="victor").status == 409  # submitted claim
+    assert app.patch("/api/claim_lines/999", {"amount": 1}, user="wen").status == 404
+
