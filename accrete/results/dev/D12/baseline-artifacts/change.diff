+def test_delete_line(app):
+    assert app.delete("/api/claim_lines/1", user="wen").status == 409  # last remaining line
+    line_id = _line(app, 1, 5, "wen").json["id"]
+    assert app.delete(f"/api/claim_lines/{line_id}", user="marco").status == 403
+    assert app.delete("/api/claim_lines/2", user="victor").status == 409  # submitted claim
+    assert app.delete("/api/claim_lines/1", user="wen").status == 204
+    assert app.get("/api/claim_lines/1", user="wen").status == 404
+    assert app.get("/api/claims/1", user="wen").json["amount"] == 5
+    assert app.delete(f"/api/claim_lines/{line_id}", user="wen").status == 409  # now the last one
+
