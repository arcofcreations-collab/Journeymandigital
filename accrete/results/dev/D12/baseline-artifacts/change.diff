+def test_line_visibility_follows_claim(app):
+    def claim_ids(user, path):
+        return {item["claim" if "claim" in item else "id"] for item in app.get(path, user=user).json["items"]}
+
+    for user in ("priya", "omar", "marco", "fiona"):
+        assert claim_ids(user, "/api/claim_lines") == claim_ids(user, "/api/claims")
+    assert app.get("/api/claim_lines/2", user="omar").status == 200  # manages victor
+    assert app.get("/api/claim_lines/2", user="marco").status == 403  # indirect manager
+    assert app.get("/api/claim_lines/2", user="sam").status == 403
+    assert app.get("/api/claim_lines?claim=2", user="sam").json["items"] == []
+    assert [l["id"] for l in app.get("/api/claim_lines?claim=2", user="victor").json["items"]] == [2]
+    assert app.get("/api/claim_lines?colour=red", user="fiona").status == 400
+
