+def test_add_line_rules(app):
+    assert _line(app, 1, 5, "marco").status == 403  # manager, not owner
+    assert _line(app, 1, 5, "fiona").status == 403
+    assert _line(app, 2, 5, "victor").status == 409  # submitted
+    assert _line(app, 2, 0, "victor").status == 409  # 409 beats 400
+    assert _line(app, 999, 5, "wen").status == 400  # unknown claim
+    assert app.post("/api/claim_lines", {"amount": 5, "description": "x"}, user="wen").status == 400
+    assert _line(app, "1", 5, "wen").status == 400
+    for bad in (0, -1, "5", True, None):
+        assert _line(app, 1, bad, "wen").status == 400, bad
+    assert _line(app, 1, 5, "wen", description=" ").status == 400
+    r = app.post("/api/claim_lines", {"claim": 1, "amount": 5, "description": "x", "id": 3}, user="wen")
+    assert r.status == 400 and "id" in r.json["fields"]
+
