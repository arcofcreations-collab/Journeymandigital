+request: "Itemised claims: a claim can consist of several line items (claim_lines); a claim's amount becomes the total of its lines."
+interpretation: >-
+  New collection claim_lines (claim, amount > 0, description). claims.amount stays a stored field but is kept equal to
+  round(sum of the claim's lines, 2) by triggers on line create/update/delete. Creating a claim (same input and validation
+  as before) creates its first line via a create trigger. Line create/update/delete is allowed only for the claim's employee (403)
+  while the claim is draft (409); deleting the last line is 409; a line making the claim's total exceed 5000 is 400; changing a
+  line's claim is 400. PATCHing a claim's amount sets its single line's amount; with several lines (amount differing from the
+  total) it is 409, which takes precedence over the 0..5000 check (the claim-level range check applies to single-line claims;
+  multi-line totals are enforced on the lines). Deleting a claim deletes its lines. Lines are readable by exactly the readers of
+  their claim. claim_lines.claim is stored as the claim's integer id (serialised exactly like a reference) with an existence
+  constraint (400) rather than a ref field, because the runtime refuses (409) to delete a record still referenced, which would
+  block deleting a draft claim together with its lines. Existing claims each get line id = claim id with their current amount and
+  description; new lines get ids from 81.
+ops:
+  - add_entity:
+      name: claim_lines
+      fields:
+        claim: int required
+        amount: number required
+        description: text required
+      rules:
+        read: "any(c.employee == user or c.employee.manager == user or user.role == 'finance' for c in claims if c.id == record.claim)"
+        create: "all(c.employee == user for c in claims if c.id == record.claim)"
+        create_guard: "all(c.status == 'draft' for c in claims if c.id == record.claim)"
+        update: "any(c.employee == user for c in claims if c.id == record.claim)"
+        update_guard: "any(c.status == 'draft' for c in claims if c.id == record.claim)"
+        delete: "any(c.employee == user for c in claims if c.id == record.claim)"
+        delete_guard: "any(c.status == 'draft' for c in claims if c.id == record.claim) and count(claim_lines, claim=record.claim) > 1"
+      constraints:
+        claim_exists: {expr: "any(c.id == record.claim for c in claims)", message: "refers to a record that does not exist", field: claim}
+        amount_positive: {expr: "record.amount > 0", message: "must be greater than 0", field: amount}
+        claim_total_max: {expr: "round(sum(l.amount for l in claim_lines if l.claim == record.claim and l.id != record.id) + record.amount, 2) <= 5000", message: "the claim's total must be at most 5000", field: amount}
+      triggers:
+        claim_fixed: {on: update, when: "record.claim != old.claim", effects: [{fail: "'the claim of a line cannot be changed'", status: 400}]}
+        total_on_create: {on: create, effects: [{update: "[c for c in claims if c.id == record.claim]", set: {amount: "round(sum(l.amount for l in claim_lines if l.claim == it.id and l.id != record.id) + record.amount, 2)"}}]}
+        total_on_update: {on: update, effects: [{update: "[c for c in claims if c.id == record.claim]", set: {amount: "round(sum(l.amount for l in claim_lines if l.claim == it.id and l.id != record.id) + record.amount, 2)"}}]}
+        total_on_delete: {on: delete, when: "any(l.claim == record.claim and l.id != record.id for l in claim_lines)", effects: [{update: "[c for c in claims if c.id == record.claim]", set: {amount: "round(sum(l.amount for l in claim_lines if l.claim == it.id and l.id != record.id), 2)"}}]}
+  - change_constraint: {entity: claims, name: amount_range, expr: "count(claim_lines, claim=record.id) > 1 or (record.amount > 0 and record.amount <= 5000)", message: "must be greater than 0 and at most 5000", field: amount}
+  - add_trigger:
+      entity: claims
+      name: first_line
+      on: create
+      effects:
+        - {create: claim_lines, values: {claim: record.id, amount: record.amount, description: record.description}}
+  - add_trigger:
+      entity: claims
+      name: amount_to_line
+      on: update
+      when: "record.amount != old.amount"
+      effects:
+        - {fail: "'this claim has several lines; change its lines instead'", status: 409, when: "count(claim_lines, claim=record.id) > 1 and record.amount != round(sum(l.amount for l in claim_lines if l.claim == record.id), 2)"}
+        - {if: "count(claim_lines, claim=record.id) == 1", then: [{update: "[l for l in claim_lines if l.claim == record.id and l.amount != record.amount]", set: {amount: "record.amount"}}]}
+  - add_trigger:
+      entity: claims
+      name: delete_lines
+      on: delete
+      effects:
+        - {delete: "[l for l in claim_lines if l.claim == record.id]"}
